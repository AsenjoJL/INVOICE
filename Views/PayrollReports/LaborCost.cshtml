@model HazelInvoice.ViewModels.LaborCostReportViewModel

@{
    ViewData["Title"] = "Labor Cost Report";
    ViewData["NotePurpose"] = "Summarizes labor cost for a date range.";
    ViewData["NoteInstructions"] = "Costs are based on attendance wages (rate × multiplier).";
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Labor Cost Report</h1>
            <div class="sub">Review attendance-driven labor cost for a selected date range.</div>
        </div>
        <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Payroll</a>
    </div>

    <partial name="_PageNote" />

    <form method="get" class="row g-2 align-items-end payroll-filter">
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="payroll-kpi">
                <div class="label">Total Labor Cost</div>
                <div class="value">₱@Model.TotalCost.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="payroll-kpi">
                <div class="label">Date Range</div>
                <div class="value">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</div>
            </div>
        </div>
    </div>

    <div class="payroll-table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 payroll-table">
                    <thead>
                        <tr>
                            <th>Laborer</th>
                            <th>Total Days</th>
                            <th>Total Wage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="fw-bold">@row.LaborerName</td>
                                <td>@row.TotalDays</td>
                                <td class="payroll-money">₱@row.TotalWage.ToString("N2")</td>
                            </tr>
                        }
                        @if (!Model.Rows.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No attendance records found for this range.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
