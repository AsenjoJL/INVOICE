@model HazelInvoice.ViewModels.UnpaidPayrollViewModel

@{
    ViewData["Title"] = "Unpaid Laborers";
    ViewData["NotePurpose"] = "Shows payroll entries that still have balance.";
    ViewData["NoteInstructions"] = "Use date filters to narrow the period range.";
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Unpaid Laborers</h1>
            <div class="sub">Track laborers with remaining payroll balances.</div>
        </div>
        <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Payroll</a>
    </div>

    <partial name="_PageNote" />

    <form method="get" class="row g-2 align-items-end payroll-filter">
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="payroll-table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 payroll-table">
                    <thead>
                        <tr>
                            <th>Laborer</th>
                            <th>Period</th>
                            <th>Total Wage</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var balance = entry.NetPay - entry.PaidAmount;
                            <tr>
                                <td class="fw-bold">@entry.Laborer?.FullName</td>
                                <td>@entry.PeriodStart.ToString("MMM dd, yyyy") - @entry.PeriodEnd.ToString("MMM dd, yyyy")</td>
                                <td>₱@entry.GrossWage.ToString("N2")</td>
                                <td>₱@entry.PaidAmount.ToString("N2")</td>
                                <td>₱@balance.ToString("N2")</td>
                                <td>
                                    @if (entry.Status == HazelInvoice.Models.PaymentStatus.Partial)
                                    {
                                        <span class="payroll-status partial">Partial</span>
                                    }
                                    else
                                    {
                                        <span class="payroll-status unpaid">Unpaid</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Payroll" asp-action="Details" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Entries.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No unpaid payroll entries found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
