@model HazelInvoice.Models.Expense
@using HazelInvoice.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Record Expense";

    var categoryGroups = (ViewBag.CategoryGroups as IEnumerable<HazelInvoice.Controllers.ExpensesController.ExpenseCategoryGroupViewModel>)
        ?? Enumerable.Empty<HazelInvoice.Controllers.ExpensesController.ExpenseCategoryGroupViewModel>();
    var categoryDefinitions = (ViewBag.CategoryDefinitions as IEnumerable<HazelInvoice.Controllers.ExpensesController.ExpenseCategoryDefinitionViewModel>)
        ?? Enumerable.Empty<HazelInvoice.Controllers.ExpensesController.ExpenseCategoryDefinitionViewModel>();
    var categoryOptions = categoryGroups.SelectMany(group => group.Items).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(item => item).ToList();
    var paymentOptions = Enum.GetNames<PaymentMethod>();
    var groupOptions = Enum.GetValues<ExpenseCategoryGroup>();
    var selectedCategoryGroup = (ViewBag.SelectedCategoryGroup as string) ?? ExpenseCategoryGroup.Other.ToString();
    var selectedPayment = Model?.PaymentMethod.ToString() ?? PaymentMethod.Cash.ToString();
    var dateValue = Model is not null && Model.Date != default
        ? Model.Date.ToString("yyyy-MM-dd")
        : DateTime.Now.ToString("yyyy-MM-dd");
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Expenses") ?? "/Expenses";
}

<partial name="_ExpenseStyles" />

<div class="expense-page">
    <div class="expense-shell">
        <aside class="expense-sidebar" aria-label="Expense navigation">
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Stock</div>
                <a class="expense-sidebar-link" asp-controller="Products" asp-action="Index">Products</a>
                <a class="expense-sidebar-link" asp-controller="Orders" asp-action="VegetableMatrix">Vegetable Order</a>
            </div>
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Purchases</div>
                <a class="expense-sidebar-link" asp-controller="Purchases" asp-action="Index">Purchases</a>
                <a class="expense-sidebar-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
            </div>
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Finance</div>
                <a class="expense-sidebar-link is-active" asp-controller="Expenses" asp-action="Create">Record Expense</a>
                <a class="expense-sidebar-link" asp-controller="Expenses" asp-action="Index">Expense Ledger</a>
                <a class="expense-sidebar-link" asp-controller="ProfitReport" asp-action="Index">Profit &amp; Sales</a>
            </div>
        </aside>

        <main class="expense-main">
            <div class="expense-content">
                <div class="expense-breadcrumb expense-page-label">
                    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <span> / </span>
                    <a asp-controller="Expenses" asp-action="Index">Expenses</a>
                    <span> / </span>
                    <span>Record Expense</span>
                </div>

                <h1 class="expense-title">Record Expense</h1>

                <form asp-action="Create" method="post" id="expenseForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="returnScrollY" id="expenseReturnScrollY" value="0" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="expense-form-shell">
                        <div class="expense-form-grid">
                            <div class="expense-field">
                                <div class="expense-field-head">
                                    <label asp-for="Date" class="expense-page-label">Date</label>
                                </div>
                                <input asp-for="Date" id="expenseDate" class="expense-field-input" type="date" value="@dateValue" />
                                <span asp-validation-for="Date" class="field-validation-error"></span>
                            </div>

                            <div class="expense-field">
                                <div class="expense-field-head">
                                    <label asp-for="Amount" class="expense-page-label">Amount</label>
                                </div>
                                <div class="expense-field-prefix">
                                    <div class="expense-field-addon">PHP</div>
                                    <input asp-for="Amount" id="expenseAmount" type="number" step="0.01" class="expense-field-input" placeholder="0.00" value="@(Model?.Amount > 0 ? Model.Amount.ToString("0.00") : string.Empty)" />
                                </div>
                                <span asp-validation-for="Amount" class="field-validation-error"></span>
                            </div>

                            <div class="expense-field">
                                <div class="expense-field-head">
                                    <label asp-for="Category" class="expense-page-label">Category</label>
                                </div>
                                <select id="expenseCategorySelect" class="expense-field-select mb-2">
                                    <option value="">Choose existing category</option>
                                    @foreach (var category in categoryOptions)
                                    {
                                        <option value="@category" selected="@(string.Equals(Model?.Category, category, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@category</option>
                                    }
                                </select>
                                <input asp-for="Category" id="expenseCategory" class="expense-field-input" placeholder="Type or choose a category" autocomplete="off" />
                                <div class="expense-help">You can type a new category or choose from the daily, weekly, and monthly list.</div>
                                <span asp-validation-for="Category" class="field-validation-error"></span>
                            </div>

                            <div class="expense-field">
                                <div class="expense-field-head">
                                    <label for="categoryGroup" class="expense-page-label">Schedule</label>
                                </div>
                                <select id="categoryGroup" name="categoryGroup" class="expense-field-select">
                                    @foreach (var group in groupOptions)
                                    {
                                        <option value="@group" selected="@(selectedCategoryGroup == group.ToString() ? "selected" : null)">@ExpenseCategoryCatalog.GetLabel(group)</option>
                                    }
                                </select>
                                <div class="expense-help">This schedule controls how the category appears in the ledger, dashboard, and profit report.</div>
                            </div>

                            <div class="expense-field-wide">
                                <div class="expense-field-head">
                                    <label asp-for="PaymentMethod" class="expense-page-label">Payment Method</label>
                                </div>
                                <select asp-for="PaymentMethod" id="expensePaymentMethod" class="expense-field-select">
                                    @foreach (var option in paymentOptions)
                                    {
                                        <option value="@option" selected="@(selectedPayment == option ? "selected" : null)">@option</option>
                                    }
                                </select>
                                <span asp-validation-for="PaymentMethod" class="field-validation-error"></span>
                            </div>

                            <div class="expense-field-wide">
                                <div class="expense-field-head">
                                    <label asp-for="Description" class="expense-page-label">Notes</label>
                                </div>
                                <textarea asp-for="Description" id="expenseDescription" class="expense-field-textarea" placeholder="Optional details about this expense."></textarea>
                                <span asp-validation-for="Description" class="field-validation-error"></span>
                            </div>

                            <div class="expense-actions">
                                <div class="expense-actions-meta">
                                    <div class="expense-page-label">Entry Mode</div>
                                    <div>Amounts stay blank until you type them and the form keeps the grouped expense structure you asked for.</div>
                                </div>
                                <div class="expense-button-row">
                                    <a href="@returnUrl" class="expense-secondary-btn">Cancel</a>
                                    <button type="submit" class="expense-primary-btn">Record Expense</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>

<script>
    (function () {
        const amountInput = document.getElementById('expenseAmount');
        const categoryInput = document.getElementById('expenseCategory');
        const categorySelect = document.getElementById('expenseCategorySelect');
        const categoryGroup = document.getElementById('categoryGroup');
        if (!amountInput) return;

        const categoryLookup = new Map(
            @Html.Raw(JsonSerializer.Serialize(categoryDefinitions.ToDictionary(
                item => item.Name,
                item => item.GroupValue,
                StringComparer.OrdinalIgnoreCase)))
        );

        amountInput.addEventListener('blur', () => {
            const raw = amountInput.value.trim();
            if (!raw) {
                return;
            }

            const parsed = Number.parseFloat(raw);
            if (!Number.isNaN(parsed)) {
                amountInput.value = parsed.toFixed(2);
            }
        });

        if (categoryInput && categoryGroup) {
            const syncGroup = () => {
                const normalized = categoryInput.value.trim().toUpperCase();
                if (!normalized) {
                    categoryGroup.value = 'Other';
                    if (categorySelect) {
                        categorySelect.value = '';
                    }
                    return;
                }

                const existing = categoryLookup.get(normalized);
                if (existing) {
                    categoryGroup.value = existing;
                }
            };

            if (categorySelect) {
                categorySelect.addEventListener('change', () => {
                    if (!categorySelect.value) {
                        return;
                    }

                    categoryInput.value = categorySelect.value;
                    syncGroup();
                });
            }

            categoryInput.addEventListener('input', () => {
                if (!categorySelect) {
                    return;
                }

                const exactMatch = Array.from(categorySelect.options).find(option =>
                    option.value &&
                    option.value.localeCompare(categoryInput.value.trim(), undefined, { sensitivity: 'accent' }) === 0);

                categorySelect.value = exactMatch ? exactMatch.value : '';
            });

            categoryInput.addEventListener('change', syncGroup);
            categoryInput.addEventListener('blur', syncGroup);
            syncGroup();
        }

        const returnScroll = document.getElementById('expenseReturnScrollY');
        if (returnScroll) {
            const saved = parseInt(sessionStorage.getItem('expenses:index:scrollY') || '0', 10);
            if (!Number.isNaN(saved) && saved > 0) {
                returnScroll.value = saved;
            }
        }
    })();
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
