<style>
    .expense-page,
    .expense-page * {
        box-sizing: border-box;
    }

    .expense-page {
        --expense-border: #e8e8e8;
        --expense-text: #0a0a0a;
        --expense-muted: #888888;
        --expense-bg: #ffffff;
        background: var(--expense-bg);
        color: var(--expense-text);
        font-family: 'DM Sans', sans-serif;
        min-height: calc(100vh - 90px);
        padding: 0;
    }

    .expense-shell {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        min-height: calc(100vh - 90px);
        background: #ffffff;
        border-top: 1px solid var(--expense-border);
    }

    .expense-sidebar {
        border-right: 1px solid var(--expense-border);
        padding: 44px 24px;
    }

    .expense-sidebar-group + .expense-sidebar-group {
        margin-top: 32px;
    }

    .expense-sidebar-label,
    .expense-page-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--expense-muted);
    }

    .expense-sidebar-link {
        display: block;
        margin-top: 12px;
        color: var(--expense-text);
        text-decoration: none;
        font-size: 14px;
        line-height: 1.45;
    }

    .expense-sidebar-link.is-active {
        font-weight: 600;
    }

    .expense-main {
        padding: 60px 80px;
    }

    .expense-content {
        max-width: 700px;
    }

    .expense-content-wide {
        max-width: 980px;
    }

    .expense-breadcrumb {
        margin-bottom: 10px;
    }

    .expense-breadcrumb a,
    .expense-breadcrumb span {
        color: var(--expense-muted);
        text-decoration: none;
    }

    .expense-title {
        margin: 0 0 36px;
        font-size: 22px;
        line-height: 1.2;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--expense-text);
    }

    .expense-title-compact {
        margin-bottom: 8px;
    }

    .expense-primary-btn,
    .expense-secondary-btn {
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .expense-field-input:focus,
    .expense-field-select:focus,
    .expense-field-textarea:focus {
        outline: none;
    }

    .expense-form-shell {
        border-top: 1px solid var(--expense-border);
        border-left: 1px solid var(--expense-border);
    }

    .expense-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .expense-field,
    .expense-field-wide,
    .expense-actions {
        position: relative;
        border-right: 1px solid var(--expense-border);
        border-bottom: 1px solid var(--expense-border);
        padding: 16px 18px 18px;
        min-height: 108px;
        background: #ffffff;
    }

    .expense-field-wide,
    .expense-actions {
        grid-column: 1 / -1;
    }

    .expense-field-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .expense-field-input,
    .expense-field-select,
    .expense-field-textarea,
    .expense-field-addon {
        width: 100%;
        border: 0;
        background: transparent;
        color: #0a0a0a;
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        line-height: 1.5;
        padding: 0;
        appearance: none;
    }

    .expense-field-select {
        background-image: linear-gradient(45deg, transparent 50%, #0a0a0a 50%), linear-gradient(135deg, #0a0a0a 50%, transparent 50%);
        background-position: calc(100% - 14px) calc(50% - 2px), calc(100% - 8px) calc(50% - 2px);
        background-size: 6px 6px, 6px 6px;
        background-repeat: no-repeat;
        padding-right: 28px;
    }

    .expense-field-textarea {
        min-height: 96px;
        resize: vertical;
    }

    .expense-field-prefix {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 12px;
        align-items: center;
    }

    .expense-field-addon {
        width: auto;
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #0a0a0a;
    }

    .expense-help,
    .field-validation-error,
    .validation-summary-errors,
    .validation-summary-valid {
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        color: var(--expense-muted);
        margin-top: 12px;
    }

    .field-validation-error {
        color: #0a0a0a;
    }

    .expense-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        min-height: auto;
    }

    .expense-actions-meta {
        max-width: 360px;
    }

    .expense-button-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .expense-primary-btn,
    .expense-secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border: 1px solid #0a0a0a;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

    .expense-primary-btn {
        background: #0a0a0a;
        color: #ffffff;
    }

    .expense-secondary-btn {
        background: #ffffff;
        color: #0a0a0a;
        border-color: var(--expense-border);
    }

    .expense-ledger-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 24px;
    }

    .expense-ledger-total,
    .expense-empty-state,
    .expense-ledger-group {
        border: 1px solid var(--expense-border);
        background: #ffffff;
    }

    .expense-ledger-total,
    .expense-empty-state {
        padding: 16px 18px;
        margin-bottom: 20px;
    }

    .expense-ledger-total-value {
        margin-top: 8px;
        font-size: 24px;
        font-weight: 600;
        letter-spacing: -0.03em;
    }

    .expense-empty-state p {
        margin: 8px 0 0;
        color: var(--expense-muted);
        font-size: 15px;
    }

    .expense-ledger-group {
        margin-bottom: 20px;
    }

    .expense-ledger-group-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--expense-border);
    }

    .expense-ledger-group-head h2 {
        margin: 8px 0 0;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .expense-ledger-group-total {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .expense-ledger-table-wrap {
        overflow-x: auto;
    }

    .expense-ledger-table {
        width: 100%;
        margin: 0;
    }

    .expense-ledger-table thead th,
    .expense-ledger-table tfoot td {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--expense-muted);
        background: #ffffff;
        border-bottom: 1px solid var(--expense-border);
        padding: 14px 18px;
    }

    .expense-ledger-table tbody td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--expense-border);
        color: var(--expense-text);
        font-size: 15px;
        vertical-align: top;
    }

    .expense-ledger-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .expense-ledger-table tfoot td {
        border-top: 1px solid var(--expense-border);
        border-bottom: 0;
    }

    @@media (max-width: 991.98px) {
        .expense-shell {
            grid-template-columns: 1fr;
        }

        .expense-sidebar {
            border-right: 0;
            border-bottom: 1px solid var(--expense-border);
            padding: 28px 24px;
        }

        .expense-main {
            padding: 36px 24px;
        }
    }

    @@media (max-width: 767.98px) {
        .expense-form-grid {
            grid-template-columns: 1fr;
        }

        .expense-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .expense-ledger-header,
        .expense-ledger-group-head {
            flex-direction: column;
        }
    }
</style>
