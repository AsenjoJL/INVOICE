@model IEnumerable<HazelInvoice.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
    ViewData["NotePurpose"] = "Track operating expenses by category and vendor.";
    ViewData["NoteInstructions"] = "Record new expenses to keep daily and monthly totals accurate.";
}

<partial name="_ExpenseStyles" />

<div class="container-fluid p-4 expense-page">
    <div class="expense-header">
        <div>
            <h1 class="expense-title">Expenses</h1>
            <div class="expense-sub">Track operating expenses by category and vendor.</div>
        </div>
        <a asp-action="Create" class="btn expense-btn expense-btn-primary"><i class="bi bi-minus-circle"></i> Record Expense</a>
    </div>

    <partial name="_PageNote" />

    <div class="card expense-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle expense-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Vendor</th>
                            <th>Reference</th>
                            <th>Method</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                <td class="expense-category">@item.Category</td>
                                <td>@item.Vendor</td>
                                <td>@item.ReferenceNo</td>
                                <td>@item.PaymentMethod</td>
                                <td class="expense-amount">@item.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
