@model HazelInvoice.ViewModels.ExpenseLedgerViewModel

@{
    ViewData["Title"] = "Expenses";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<partial name="_ExpenseStyles" />

<div class="expense-page">
    <div class="expense-shell">
        <aside class="expense-sidebar" aria-label="Expense navigation">
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Stock</div>
                <a class="expense-sidebar-link" asp-controller="Products" asp-action="Index">Products</a>
                <a class="expense-sidebar-link" asp-controller="Orders" asp-action="VegetableMatrix">Vegetable Order</a>
            </div>
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Purchases</div>
                <a class="expense-sidebar-link" asp-controller="Purchases" asp-action="Index">Purchases</a>
                <a class="expense-sidebar-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
            </div>
            <div class="expense-sidebar-group">
                <div class="expense-sidebar-label">Finance</div>
                <a class="expense-sidebar-link" asp-controller="Expenses" asp-action="Create">Record Expense</a>
                <a class="expense-sidebar-link is-active" asp-controller="Expenses" asp-action="Index">Expense Ledger</a>
                <a class="expense-sidebar-link" asp-controller="ProfitReport" asp-action="Index">Profit &amp; Sales</a>
            </div>
        </aside>

        <main class="expense-main">
            <div class="expense-content expense-content-wide">
                <div class="expense-breadcrumb expense-page-label">
                    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <span> / </span>
                    <span>Expenses</span>
                </div>

                <div class="expense-ledger-header">
                    <div>
                        <h1 class="expense-title expense-title-compact">Expense Ledger</h1>
                        <div class="expense-sub">Grouped by category schedule with section totals and overall total.</div>
                    </div>
                    <a asp-action="Create" asp-route-returnUrl="@returnUrl" class="expense-primary-btn expense-return-link">Record Expense</a>
                </div>

                <div class="expense-ledger-total">
                    <div class="expense-page-label">Grand Total</div>
                    <div class="expense-ledger-total-value">PHP @Model.GrandTotal.ToString("N2")</div>
                </div>

                @if (Model.Groups.Count == 0)
                {
                    <div class="expense-empty-state">
                        <div class="expense-page-label">No Records</div>
                        <p>No expense records have been added yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var group in Model.Groups)
                    {
                        <section class="expense-ledger-group">
                            <div class="expense-ledger-group-head">
                                <div>
                                    <div class="expense-page-label">@group.Label</div>
                                    <h2>@group.Label</h2>
                                </div>
                                <div class="expense-ledger-group-total">PHP @group.Total.ToString("N2")</div>
                            </div>

                            <div class="expense-ledger-table-wrap">
                                <table class="table expense-ledger-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Category</th>
                                            <th>Method</th>
                                            <th>Reference</th>
                                            <th>Notes</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in group.Items)
                                        {
                                            <tr>
                                                <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                                <td class="expense-category">@item.Category</td>
                                                <td>@item.PaymentMethod</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.ReferenceNo) ? "—" : item.ReferenceNo)</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                                <td class="expense-amount text-end">@item.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="5">Total</td>
                                            <td class="expense-amount text-end">@group.Total.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </section>
                    }
                }
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script src="~/js/expenses-index.js" asp-append-version="true"></script>
}
