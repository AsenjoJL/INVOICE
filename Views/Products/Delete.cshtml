@model HazelInvoice.Models.Product

@{
    ViewData["Title"] = "Deactivate Product";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container p-4">
    <div class="card shadow border-0" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Deactivate Product</h4>
        </div>
        <div class="card-body">
            <p class="mb-3">
                This will <strong>deactivate</strong> the product so it no longer appears in orders.
                Existing receipts will remain intact.
            </p>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">SKU</dt>
                <dd class="col-sm-8">@Model.SKU</dd>

                <dt class="col-sm-4">Unit</dt>
                <dd class="col-sm-8">@Model.Unit</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="returnClientPage" id="returnClientPage" value="1" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger">Deactivate</button>
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <a href="@returnUrl" class="btn btn-light">Cancel</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('returnClientPage');
            if (!input) return;

            try {
                const savedState = JSON.parse(sessionStorage.getItem('products:index:viewState') || 'null');
                const currentPage = Number(savedState?.currentPage || 1);
                input.value = Number.isFinite(currentPage) && currentPage > 0
                    ? String(currentPage)
                    : '1';
            } catch {
                input.value = '1';
            }
        })();
    </script>
}
