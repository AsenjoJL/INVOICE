@model HazelInvoice.Models.Product

@{
    ViewData["Title"] = "Deactivate Product";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<partial name="_ProductFormStyles" />

<div class="container product-form-page py-4">
    <div class="product-form-shell" style="max-width: 760px;">
        <div class="product-form-card">
            <div class="product-form-banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="product-form-kicker">Catalog Safety</div>
                        <h4>Deactivate Product</h4>
                        <p class="subtitle">Archive the item from active operations while preserving order and stock history.</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <a href="@returnUrl" class="btn btn-light text-dark"><i class="bi bi-arrow-left"></i> Back</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-light text-dark"><i class="bi bi-arrow-left"></i> Back</a>
                    }
                </div>
            </div>

            <div class="product-form-body">
                <div class="product-form-section">
                    <div class="section-title">What happens next</div>
                    <p class="mb-0" style="color:#7a8699;">
                        This will <strong>deactivate</strong> the product so it no longer appears in active ordering flows.
                        Existing receipts, purchases, and stock history remain intact.
                    </p>
                </div>

                <div class="product-form-section">
                    <div class="section-title">Product details</div>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                        <dt class="col-sm-4">SKU</dt>
                        <dd class="col-sm-8">@Model.SKU</dd>

                        <dt class="col-sm-4">Unit</dt>
                        <dd class="col-sm-8">@Model.Unit</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="returnClientPage" id="returnClientPage" value="1" />
                    <input type="hidden" name="returnScrollY" id="returnScrollY" value="0" />

                    <div class="product-form-section product-form-actions">
                        @if (!string.IsNullOrWhiteSpace(returnUrl))
                        {
                            <a href="@returnUrl" class="btn btn-outline-secondary">Cancel</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        }
                        <button type="submit" class="btn btn-primary btn-lg">Deactivate Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('returnClientPage');
            const scrollInput = document.getElementById('returnScrollY');
            if (!input) return;

            try {
                const savedState = JSON.parse(sessionStorage.getItem('products:index:viewState') || 'null');
                const currentPage = Number(savedState?.currentPage || 1);
                const scrollY = Number(savedState?.scrollY || sessionStorage.getItem('products:index:scrollY') || 0);
                input.value = Number.isFinite(currentPage) && currentPage > 0
                    ? String(currentPage)
                    : '1';
                if (scrollInput) {
                    scrollInput.value = Number.isFinite(scrollY) && scrollY > 0
                        ? String(scrollY)
                        : '0';
                }
            } catch {
                input.value = '1';
                if (scrollInput) scrollInput.value = '0';
            }
        })();
    </script>
}
