@model HazelInvoice.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    var returnUrl = ViewBag.ReturnUrl as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/products-refresh.css" asp-append-version="true" />
}

<partial name="_ProductFormStyles" />

<div class="container product-form-page product-refresh py-4">
    <div class="product-form-shell">
        <div class="product-form-card">
            <div class="product-form-banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="product-form-kicker">Product Setup</div>
                        <h4>Update Product</h4>
                        <p class="subtitle">Keep product details accurate for pricing and sales.</p>
                    </div>
                    <a href="javascript:void(0)" onclick="event.preventDefault(); document.body.style.transition = 'opacity 0.3s ease'; document.body.style.opacity = '0'; setTimeout(() => { if(document.referrer) { window.history.back(); } else { window.location.href='@Url.Action("Index")'; } }, 300);" class="btn btn-light text-dark"><i class="bi bi-arrow-left"></i> Back</a>
                </div>
            </div>

            <div class="product-form-body">
                <section class="product-summary-strip product-form-strip">
                    <article class="product-summary-card">
                        <span class="product-summary-label">Editing</span>
                        <strong>@Model.Name</strong>
                        <small>Update this catalog record safely</small>
                    </article>
                    <article class="product-summary-card">
                        <span class="product-summary-label">SKU</span>
                        <strong>@Model.SKU</strong>
                        <small>Current product code</small>
                    </article>
                    <article class="product-summary-card">
                        <span class="product-summary-label">Status</span>
                        <strong>@(Model.IsActive ? "Active" : "Inactive")</strong>
                        <small>Controls ordering visibility</small>
                    </article>
                </section>

                <form asp-action="Edit" method="post" id="productEditForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="returnClientPage" id="returnClientPage" />
                    <div asp-validation-summary="ModelOnly" class="text-danger product-form-alert"></div>

                    <div class="product-form-section">
                        <div class="section-title">Basics</div>
                        <div class="form-floating">
                            <input asp-for="SKU" class="form-control" placeholder="SKU" />
                            <label asp-for="SKU">SKU / Code</label>
                            <span asp-validation-for="SKU" class="text-danger"></span>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="Name" class="form-control" placeholder="Product Name" />
                            <label asp-for="Name">Product Name</label>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-floating mt-3">
                            @{
                                var supplierOptions = (ViewBag.SupplierOptions as List<HazelInvoice.Models.Supplier>) ?? new List<HazelInvoice.Models.Supplier>();
                            }
                            <select asp-for="SupplierId" class="form-select">
                                <option value="">-- Select Supplier (Owner) --</option>
                                @foreach (var s in supplierOptions)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <label asp-for="SupplierId">Supplier / Owner</label>
                            <span asp-validation-for="SupplierId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="product-form-section">
                        <div class="section-title">Classification</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @{
                                        var categoryOptions = (ViewBag.CategoryOptions as List<string>) ?? new List<string>();
                                        var defaultCategories = new[] { "Vegetables", "Fruits", "Meat", "Seafood", "Dry Goods", "Beverages", "Others" };
                                        var currentCategory = Model?.Category ?? string.Empty;
                                        var allCategories = categoryOptions
                                            .Concat(defaultCategories)
                                            .Where(c => !string.IsNullOrWhiteSpace(c))
                                            .Distinct(StringComparer.OrdinalIgnoreCase)
                                            .ToList();
                                        if (!string.IsNullOrWhiteSpace(currentCategory) &&
                                            !allCategories.Contains(currentCategory, StringComparer.OrdinalIgnoreCase))
                                        {
                                            allCategories.Add(currentCategory);
                                        }
                                        allCategories.Sort(StringComparer.OrdinalIgnoreCase);
                                    }
                                    <select asp-for="Category" class="form-select">
                                        <option value="">-- Select Category --</option>
                                        @foreach (var c in allCategories)
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    </select>
                                    <label asp-for="Category">Category</label>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @{
                                        var unitOptions = new[] { "pc", "pcs", "kg", "liter", "liters", "gallon", "bottle", "pack", "bundle", "box", "bag", "sack", "tray" };
                                    }
                                    <select asp-for="Unit" class="form-select">
                                        @foreach (var u in unitOptions)
                                        {
                                            <option value="@u">@u</option>
                                        }
                                    </select>
                                    <label asp-for="Unit">Unit</label>
                                    <span asp-validation-for="Unit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="product-form-section">
                        <div class="section-title">Pricing</div>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="UnitCost" class="form-control" placeholder="Cost" />
                                    <label asp-for="UnitCost">Unit Cost</label>
                                    <span asp-validation-for="UnitCost" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" asp-for="IsActive" />
                                    <label class="form-check-label" asp-for="IsActive">Active in orders</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="product-form-section product-form-actions">
                        @if (!string.IsNullOrWhiteSpace(returnUrl))
                        {
                            <a href="@returnUrl" class="btn btn-outline-secondary">Cancel</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        }
                        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const form = document.getElementById('productEditForm');
            if (!form) return;
            const returnClientPage = document.getElementById('returnClientPage');

            form.addEventListener('submit', () => {
                sessionStorage.setItem('products:index:restore', '1');

                if (!returnClientPage) return;

                try {
                    const savedState = JSON.parse(sessionStorage.getItem('products:index:viewState') || 'null');
                    const currentPage = Number(savedState?.currentPage || 1);
                    returnClientPage.value = Number.isFinite(currentPage) && currentPage > 0
                        ? String(currentPage)
                        : '1';
                } catch {
                    returnClientPage.value = '1';
                }
            });
        })();
    </script>
}
