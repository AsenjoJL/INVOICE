@model IEnumerable<HazelInvoice.ViewModels.ProductListItemViewModel>
@using HazelInvoice.Helpers

@{
    ViewData["Title"] = "Products";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var targetDate = (ViewBag.TargetDate as DateTime?) ?? BusinessDate.Today();
    var searchTerm = (ViewBag.SearchTerm as string) ?? string.Empty;
    var zeroPriceCount = Model.Count(p => p.EffectiveDeliveryPrice == 0m);
    var totalCount = Model.Count();
    var activeCount = Model.Count(p => p.IsActive);
    var inactiveCount = totalCount - activeCount;
    var categoryOptions = Model
        .Select(p => string.IsNullOrWhiteSpace(p.Category) ? "Uncategorized" : p.Category.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();
}

<link rel="stylesheet" href="~/css/products-index.css" asp-append-version="true" />

<div class="container-fluid p-4 product-page">
    <div class="product-header admin-page-flow">
        <div class="product-header-top">
            <div class="product-header-main admin-page-hero admin-page-hero-soft">
                <div class="eyebrow">Catalog</div>
                <h1>Products</h1>
                <div class="sub">Minimal dashboard view to keep pricing and availability tidy.</div>
                <div class="product-date-chip">Viewing prices for @targetDate.ToString("MMM dd, yyyy")</div>
                <div class="product-tools">
                    <form method="get" asp-action="Index" class="product-search-bar">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text"
                               id="searchInput"
                               name="q"
                               value="@searchTerm"
                               class="form-control form-control-sm search-input-width"
                               placeholder="Search name, SKU, category, unit..." />

                        <select id="categoryFilter" class="form-select form-select-sm category-filter-width" aria-label="Category filter">
                            <option value="">All Categories</option>
                            @foreach (var category in categoryOptions)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-search">
                            <span>Go</span>
                        </button>

                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <a asp-action="Index" class="btn btn-clear">Clear</a>
                        }
                    </form>

                    <button type="button"
                            class="info-btn"
                            data-bs-toggle="collapse"
                            data-bs-target="#productInfoPanel"
                            aria-expanded="false"
                            aria-controls="productInfoPanel"
                            title="Purpose and instructions">
                        <i class="bi bi-info-lg"></i>
                    </button>
                </div>
            </div>
            <div class="product-actions">
                <form asp-action="GenerateSkus" method="post">
                    <button type="submit" class="btn btn-ghost" onclick="return confirm('This will reset ALL product SKUs to V-001, V-002 sequence based on Name. Continue?');">
                        <i class="bi bi-magic"></i> V-Series SKUs
                    </button>
                </form>
                <button type="button"
                        class="btn btn-ghost"
                        data-bs-toggle="collapse"
                        data-bs-target="#productImportPanel"
                        aria-expanded="false"
                        aria-controls="productImportPanel">
                    <i class="bi bi-upload"></i> Import Prices
                </button>
                <a asp-action="Create" class="btn btn-primary-ghost"><i class="bi bi-plus-lg"></i> Add Product</a>
            </div>
        </div>

        <div class="product-metrics admin-summary-grid">
            <div class="metric-card">
                <div class="metric-label">Total</div>
                <div class="metric-value">@totalCount</div>
                <div class="metric-chip">All products</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Active</div>
                <div class="metric-value text-success">@activeCount</div>
                <div class="metric-chip chip-soft">Visible in orders</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Inactive</div>
                <div class="metric-value text-muted">@inactiveCount</div>
                <div class="metric-chip chip-dim">Hidden items</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Zero Price</div>
                <div class="metric-value text-warning">@zeroPriceCount</div>
                <div class="metric-chip chip-warn">Needs price</div>
            </div>
        </div>

        <div id="productInfoPanel" class="collapse info-collapse">
            <div><strong>Purpose:</strong> Manage the product catalog used in orders, price setup, and purchases.</div>
            <div><strong>Instructions:</strong> Add or edit products; inactive items are hidden from orders.</div>
        </div>

        <div id="productImportPanel" class="collapse info-collapse mt-3">
            <form asp-controller="WeeklyPrices"
                  asp-action="ImportTemplate"
                  method="post"
                  enctype="multipart/form-data"
                  class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="col-lg-4">
                    <label class="form-label small text-uppercase fw-bold">Target Week Date</label>
                    <input type="date" name="targetDate" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-lg-3">
                    <label class="form-label small text-uppercase fw-bold">Import Mode</label>
                    <select name="importMode" class="form-select">
                        <option value="both">Both Delivery + Original</option>
                        <option value="delivery-only">Delivery Prices Only</option>
                        <option value="original-only">Original Prices Only</option>
                    </select>
                </div>
                <div class="col-lg-3">
                    <label class="form-label small text-uppercase fw-bold">Excel Template</label>
                    <input type="file" name="importFile" accept=".xlsx" class="form-control" required />
                </div>
                <div class="col-lg-2">
                    <button type="submit" class="btn btn-primary-ghost w-100">
                        <i class="bi bi-upload"></i> Import
                    </button>
                </div>
            </form>

            <div class="row g-2 mt-2">
                <div class="col-lg-4">
                    <a asp-controller="WeeklyPrices"
                       asp-action="DownloadTemplate"
                       asp-route-targetDate="@targetDate.ToString("yyyy-MM-dd")"
                       asp-route-importMode="both"
                       class="btn btn-ghost w-100">
                        <i class="bi bi-download"></i> Both Delivery + Original
                    </a>
                </div>
                <div class="col-lg-4">
                    <a asp-controller="WeeklyPrices"
                       asp-action="DownloadTemplate"
                       asp-route-targetDate="@targetDate.ToString("yyyy-MM-dd")"
                       asp-route-importMode="delivery-only"
                       class="btn btn-ghost w-100">
                        <i class="bi bi-download"></i> Delivery Template
                    </a>
                </div>
                <div class="col-lg-4">
                    <a asp-controller="WeeklyPrices"
                       asp-action="DownloadTemplate"
                       asp-route-targetDate="@targetDate.ToString("yyyy-MM-dd")"
                       asp-route-importMode="original-only"
                       class="btn btn-ghost w-100">
                        <i class="bi bi-download"></i> Original Template
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="filter-bar">
        <button type="button" class="filter-pill active" data-status-filter="all">All</button>
        <button type="button" class="filter-pill" data-status-filter="active">Active</button>
        <button type="button" class="filter-pill" data-status-filter="inactive">Inactive</button>
        <button type="button" class="filter-pill filter-pill-warning" data-status-filter="zero">
            Zero Price <span class="zero-badge">@zeroPriceCount</span>
        </button>
    </div>

    <div class="product-card admin-surface-card">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Message"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["ErrorMessage"]</div>
        }

        <div class="table-top-meta">
            <div id="rowSummary" class="row-summary">Showing 0 of 0 products</div>
            <div class="row-summary">Tip: Use filters and sorting to focus the list.</div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table product-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox" id="selectAllRows" name="selectAllRows" />
                            </th>
                            <th class="col-sku">
                                <button type="button" class="sort-trigger" data-sort-key="sku">
                                    SKU <i class="bi bi-arrow-down-up"></i>
                                </button>
                            </th>
                            <th class="col-name">
                                <button type="button" class="sort-trigger" data-sort-key="name">
                                    Name <i class="bi bi-arrow-down-up"></i>
                                </button>
                            </th>
                            <th>Unit</th>
                            <th class="col-cost">
                                <button type="button" class="sort-trigger" data-sort-key="cost">
                                    Price <i class="bi bi-arrow-down-up"></i>
                                </button>
                            </th>
                            <th>Status</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No products found.@(string.IsNullOrWhiteSpace(searchTerm) ? "" : $" Try a different keyword for \"{searchTerm}\".")
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            var categoryText = string.IsNullOrWhiteSpace(item.Category) ? "Uncategorized" : item.Category.Trim();
                            var statusText = item.IsActive ? "active" : "inactive";
                            <tr class="product-row"
                                data-id="@item.Id"
                                data-sku="@item.SKU"
                                data-name="@item.Name"
                                data-category="@categoryText"
                                data-unit="@item.Unit"
                                data-cost="@item.EffectiveDeliveryPrice"
                                data-status="@statusText">
                                <td class="col-check">
                                    <input type="checkbox"
                                           class="row-check"
                                           data-id="@item.Id"
                                           name="selectedProductIds"
                                           value="@item.Id" />
                                </td>
                                <td class="product-sku">@item.SKU</td>
                                <td>
                                    <div class="product-name">@item.Name</div>
                                    <div class="product-meta">@categoryText</div>
                                </td>
                                <td class="product-meta fw-semibold">@item.Unit</td>
                                <td class="product-cost">
                                    <div class="product-price-primary @(item.EffectiveDeliveryPrice == 0 ? "zero" : "")">
                                        ₱@item.EffectiveDeliveryPrice.ToString("N2")
                                    </div>
                                    <div class="product-meta">
                                        Cost ₱@item.UnitCost.ToString("N2")
                                        @if (item.HasWeeklyPrice)
                                        {
                                            <span class="product-weekly-flag">Weekly</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-pill status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="col-actions">
                                    <div class="dropdown">
                                        <button class="action-menu-btn"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="More actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item product-edit-link"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   asp-route-returnUrl="@returnUrl">
                                                    <i class="bi bi-pencil-square me-2"></i>Edit
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Create">
                                                    <i class="bi bi-copy me-2"></i>Duplicate
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item product-return-link"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   asp-route-returnUrl="@returnUrl">
                                                    <i class="bi bi-pause-circle me-2"></i>Deactivate
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-action="DeletePermanent"
                                                      method="post"
                                                      class="m-0 product-return-form"
                                                      onsubmit="return confirm('Delete @item.Name from the database? This cannot be undone.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <input type="hidden" name="returnClientPage" class="return-client-page" value="1" />
                                                    <input type="hidden" name="returnScrollY" class="return-scroll-y" value="0" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>Delete from Database
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="product-pager">
                <div class="pager-controls">
                    <label for="pageSizeSelect" class="small text-muted fw-bold text-uppercase">Page size</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm page-size-width">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="pager-controls">
                    <button type="button" id="prevPageBtn" class="btn btn-sm btn-outline-secondary">Prev</button>
                    <div id="pageInfo" class="pager-info">Page 1 of 1</div>
                    <button type="button" id="nextPageBtn" class="btn btn-sm btn-outline-secondary">Next</button>
                </div>
            </div>
        </div>
    </div>

    <div id="bulkToolbar" class="bulk-toolbar">
        <span id="bulkCount" class="bulk-count">0 selected</span>
        <button type="button" class="btn btn-outline-success btn-sm" title="UI toolbar ready (no bulk endpoint configured)">Activate</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" title="UI toolbar ready (no bulk endpoint configured)">Deactivate</button>
        <button type="button" class="btn btn-outline-danger btn-sm" title="UI toolbar ready (no bulk endpoint configured)">Delete selected</button>
        <button type="button" id="clearSelectionBtn" class="btn btn-light btn-sm">Clear</button>
    </div>
</div>

<script src="~/js/products-index.js" asp-append-version="true"></script>
