@model HazelInvoice.ViewModels.ClientGroupFormVm

<div class="outlet-form-section">
    <div class="section-title">Client</div>
    <div class="row g-3">
        <div class="col-md-8">
            <div class="form-floating">
                <input asp-for="Name" class="form-control" placeholder="Client Group Name" />
                <label asp-for="Name">Client Group Name</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-floating">
                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" placeholder="Display Order" />
                <label asp-for="DisplayOrder">Display Order</label>
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="outlet-form-section">
    <div class="section-title">Outlet Mapping</div>
    <div class="form-floating">
        <textarea asp-for="OutletGroupNames" class="form-control" style="height: 120px" placeholder="Included Outlet Groups"></textarea>
        <label asp-for="OutletGroupNames">Included Outlet Groups</label>
        <span asp-validation-for="OutletGroupNames" class="text-danger"></span>
    </div>
    <div class="form-text mt-2">
        Use one group name for normal clients. Use comma or new line only when one client includes multiple outlet groups, like EIGHT2EIGHT OUTLETS and Taste 8 outlets.
    </div>
</div>

<div class="outlet-form-section">
    <div class="section-title">Status</div>
    <div class="form-check form-switch mt-1">
        <input class="form-check-input" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive">Show in client selectors</label>
    </div>
</div>
