@model HazelInvoice.ViewModels.VegetableMatrixViewModel

@{
    ViewData["Title"] = "Vegetable Order Matrix";
    ViewData["NotePurpose"] = "Daily vegetable order matrix by outlet and product.";
    ViewData["NoteInstructions"] = "Enter quantities, review totals, then Save Changes or Print.";
}
@section Styles {
    <link rel="stylesheet" href="~/css/vegetable-matrix.css" asp-append-version="true" />
    @{
        var paperSize = ((string?)ViewBag.PaperSize ?? "Letter").Trim();
        var pageSizeCss = string.Equals(paperSize, "A4", StringComparison.OrdinalIgnoreCase) ? "A4 landscape" : "11in 8.5in";
    }
    <style>
        @@media print {
            @@page { size: @pageSizeCss; margin: 2mm; }
        }
    </style>
}

<div class="container-fluid p-0 matrix-page">
    <div class="matrix-toolbar no-print">
        <div class="matrix-toolbar-head">
            <div class="matrix-title-block">
                <div class="matrix-title">Daily Order Matrix</div>
                <div class="matrix-page-meta">Outlets @Model.CurrentPage/@Model.TotalPages · Products @Model.ProductPage/@Model.TotalProductPages</div>
            </div>
            <button type="button"
                    class="btn-matrix btn-matrix-subtle btn-icon-only"
                    data-bs-toggle="collapse"
                    data-bs-target="#matrixInfoPanel"
                    aria-expanded="false"
                    aria-controls="matrixInfoPanel"
                    title="Show purpose and instructions">
                <i class="bi bi-info-circle"></i>
            </button>
        </div>

        <div class="matrix-toolbar-body">
            <div class="matrix-tool-group">
                <span class="group-label">Navigation</span>
                <button type="button" class="btn-matrix btn-matrix-outline"
                        onclick="changeProductPage(-1)" @(Model.ProductPage <= 1 ? "disabled" : "")>
                    <i class="bi bi-chevron-left"></i> Prev
                </button>
                <button type="button" class="btn-matrix btn-matrix-outline"
                        onclick="changeProductPage(1)" @(Model.ProductPage >= Model.TotalProductPages ? "disabled" : "")>
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            <div class="matrix-tool-divider"></div>

            <div class="matrix-tool-group">
                <span class="group-label">Actions</span>
                <button type="submit" form="matrixForm" class="btn-matrix btn-matrix-primary">
                    <i class="bi bi-check2-circle"></i> Save Changes
                </button>
                <button type="button" class="btn-matrix btn-matrix-outline btn-action-secondary" onclick="submitForPrint()">
                    <i class="bi bi-printer-fill"></i> Print
                </button>

                @if (!Model.ShowDetails)
                {
                    <a asp-action="VegetableMatrix"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                       asp-route-page="@Model.CurrentPage"
                       asp-route-productPage="@Model.ProductPage"
                       asp-route-details="true"
                       class="btn-matrix btn-matrix-outline btn-action-secondary">
                        <i class="bi bi-layout-text-sidebar-reverse"></i> Load Details
                    </a>
                }
                else
                {
                    <a asp-action="VegetableMatrix"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                       asp-route-page="@Model.CurrentPage"
                       asp-route-productPage="@Model.ProductPage"
                       asp-route-details="false"
                       class="btn-matrix btn-matrix-outline btn-action-secondary">
                        <i class="bi bi-layout-text-sidebar"></i> Hide Details
                    </a>
                }

                <input type="date"
                       id="toolbarDeliveryDate"
                       name="toolbarDeliveryDate"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       class="matrix-date-input"
                       title="Delivery Date"
                       aria-label="Delivery Date"
                       onchange="document.getElementById('hiddenDate').value=this.value; document.getElementById('filterForm').submit();" />

                <button type="button" id="toggleZeroPriceBtn" class="btn-matrix btn-matrix-outline btn-action-secondary">
                    <i class="bi bi-funnel"></i> Hide zero-price items
                </button>

                <form asp-action="ImportVegetableMatrixExcel"
                      method="post"
                      enctype="multipart/form-data"
                      class="matrix-import-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                    <input type="hidden" name="productPage" value="@Model.ProductPage" />
                    <input type="hidden" name="details" value="@Model.ShowDetails.ToString().ToLowerInvariant()" />
                    <input type="file"
                           name="importFile"
                           accept=".xlsx"
                           class="form-control form-control-sm matrix-file-input"
                           required />
                    <button type="submit" class="btn-matrix btn-matrix-outline btn-import">
                        <i class="bi bi-upload"></i> Import Excel
                    </button>
                </form>

                <a asp-action="DownloadVegetableMatrixTemplate"
                   asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                   class="btn-matrix btn-matrix-outline btn-import"
                   title="Download an .xlsx template that matches the Import Excel format">
                    <i class="bi bi-download"></i> Template
                </a>
            </div>

            <div class="matrix-tool-divider"></div>

            <div class="matrix-tool-group">
                <span class="group-label">Views</span>
                <a asp-action="UnpaidOrders" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn-matrix btn-matrix-subtle btn-alert">
                    <i class="bi bi-exclamation-circle"></i> Unpaid
                </a>
                <a asp-action="PaidOrders" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn-matrix btn-matrix-subtle btn-warning-soft">
                    <i class="bi bi-check-circle"></i> Paid
                </a>
                <a asp-controller="ProfitReport" asp-action="Index" class="btn-matrix btn-matrix-subtle">
                    <i class="bi bi-bar-chart-fill"></i> Profit &amp; Sales
                </a>
            </div>
        </div>
    </div>

    <div id="matrixInfoPanel" class="collapse matrix-info-panel no-print">
        <div><span class="info-label">Purpose:</span> Daily vegetable order matrix by outlet and product.</div>
        <div><span class="info-label">Instructions:</span> Enter quantities, review totals, then Save Changes or Print.</div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="outlet-tabs-wrap no-print">
            <span class="outlet-tabs-label">Outlet Pages</span>
            <div class="outlet-tabs">
                @for (int outletPage = 1; outletPage <= Model.TotalPages; outletPage++)
                {
                    var activeCls = outletPage == Model.CurrentPage ? "active" : "";
                    <button type="button" class="outlet-tab @activeCls" onclick="setOutletPage(@outletPage)">
                        Page @outletPage
                    </button>
                }
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="px-3 py-2 no-print">
            <div class="alert alert-success mb-2">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="px-3 py-2 no-print">
            <div class="alert alert-danger mb-2">@TempData["ErrorMessage"]</div>
        </div>
    }

    <form id="filterForm" method="get" class="no-print">
        <input type="hidden" name="date" id="hiddenDate" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="page" id="hiddenOutletPage" value="@Model.CurrentPage" />
        <input type="hidden" name="productPage" id="hiddenProductPage" value="@Model.ProductPage" />
        <input type="hidden" name="details" value="@Model.ShowDetails.ToString().ToLowerInvariant()" />
    </form>

    <form asp-action="SaveMatrix" method="post" id="matrixForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Date" />
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="ProductPage" />
        <input type="hidden" asp-for="SelectedGroupName" />
        <input type="hidden" asp-for="ShowDetails" />
        <input type="hidden" name="doPrint" id="doPrint" value="false" />

        @{
            var isAdmin = User.IsInRole("Admin");
            var showCostCol = isAdmin;
            var showPriceTotalUomCols = true;  // show on screen + print
            var showRightTotalQtyCols = true;  // show on screen + print

            var preOutletCols = (showCostCol ? 1 : 0) + (showPriceTotalUomCols ? 3 : 0);
            var postOutletCols = showRightTotalQtyCols ? 2 : 0;
            var headerSpan = preOutletCols + Model.VisibleOutlets.Count + postOutletCols;
            var totalHeaderSpan = 1 + headerSpan; // left product column + remaining columns
            // Use server-computed page size for print.
            // This avoids forcing tiny row chunks (which creates large blank space per page).
            var printRowsPerSheet = Model.ProductPageSize;
            var stickyVegWidth = 200;
            var stickyCostWidth = showCostCol ? 70 : 0;
        }

        <div class="matrix-container">
            <table class="matrix-table"
                   id="mainTable"
                   style="--sticky-veg-width:@(stickyVegWidth)px; --sticky-cost-width:@(stickyCostWidth)px; --sticky-price-width:90px; --sticky-total-width:90px;">
                <thead>
                    <tr>
                        <th colspan="@totalHeaderSpan" class="header-row-1-title sticky-h top-0">
                            <div class="matrix-title-row">
                                <span class="matrix-title-text">VEGETABLE ORDER</span>
                                <span class="matrix-title-date-inline">Delivery Date: @Model.Date.ToString("MM/dd/yyyy")</span>
                            </div>
                        </th>
                    </tr>

                    <tr>
                        <th colspan="@totalHeaderSpan" class="header-row-legend sticky-h top-35">
                            <div class="legend-inline">
                                <span class="legend-caption">Legend:</span>
                                <span class="legend-item"><span class="legend-dot legend-one" aria-hidden="true"></span><span class="legend-name">Orange</span> 1 Order</span>
                                <span class="legend-item"><span class="legend-dot legend-many" aria-hidden="true"></span><span class="legend-name">Yellow</span> Many Orders</span>
                                <span class="legend-item"><span class="legend-dot legend-low" aria-hidden="true"></span><span class="legend-name">Green</span> Lowest Qty</span>
                                <span class="legend-item"><span class="legend-dot legend-none" aria-hidden="true"></span><span class="legend-name">Gray</span> No Orders</span>
                                <span class="legend-item"><span class="legend-dot legend-high" aria-hidden="true"></span><span class="legend-name">Blue</span> Highest Qty</span>
                            </div>
                        </th>
                    </tr>

                    <tr>
                        <th class="sticky-left-col bg-white sticky-h top-70"></th>
                        @if (preOutletCols > 0)
                        {
                            <th colspan="@preOutletCols" class="bg-white sticky-h top-70"></th>
                        }

                        @{
                            if (!Model.VisibleOutlets.Any())
                            {
                                <th class="bg-white sticky-h top-70"></th>
                            }
                            else
                            {
                                for (int i = 0; i < Model.VisibleOutlets.Count; i++)
                                {
                                    var grp = Model.VisibleOutlets[i].GroupName;
                                    int span = 1;
                                    while (i + span < Model.VisibleOutlets.Count && Model.VisibleOutlets[i + span].GroupName == grp)
                                        span++;

                                    <th colspan="@span" class="header-row-3-group sticky-h top-70">@grp</th>
                                    i += span - 1;
                                }
                            }
                        }

                        @if (postOutletCols > 0)
                        {
                            <th colspan="@postOutletCols" class="bg-white sticky-h top-70"></th>
                        }
                    </tr>

                    <tr>
                        <th class="sticky-left-col header-row-4-main sticky-h top-105">VEGETABLES</th>
                        @if (showCostCol) { <th class="header-row-4-main sticky-h sticky-cost-col top-105" style="width:70px;">Cost</th> }
                        @if (showPriceTotalUomCols)
                        {
                            <th class="header-row-4-main sticky-h sticky-price-col top-105" style="width:90px;">Price</th>
                            <th class="header-row-4-main sticky-h sticky-total-col top-105" style="width:90px;">Total</th>
                            <th class="header-row-4-main sticky-h sticky-uom-col top-105" style="width:50px;">UOM</th>
                        }

                        @foreach (var c in Model.VisibleOutlets)
                        {
                            <th class="header-row-4-main outlet-head sticky-h top-105" style="min-width:80px;">@c.Name</th>
                        }

                        @if (showRightTotalQtyCols)
                        {
                            <th class="header-row-4-main sticky-h top-105" style="width:80px;">Total Qty</th>
                            <th class="header-row-4-main sticky-h top-105" style="width:50px;">uom</th>
                        }
                    </tr>

                    <tr>
                        <th class="sticky-left-col header-row-5-sub sticky-h top-140" style="text-align:left; padding-left:10px;">PO NUMBER</th>
                        @if (preOutletCols > 0)
                        {
                            <th class="header-row-5-sub sticky-h top-140" colspan="@preOutletCols"></th>
                        }

                        @foreach (var c in Model.VisibleOutlets)
                        {
                            <th class="header-row-5-sub sticky-h top-140 text-center fst-italic">@c.SubLabel</th>
                        }

                        @if (postOutletCols > 0)
                        {
                            <th class="header-row-5-sub sticky-h top-140" colspan="@postOutletCols"></th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.VisibleProducts.Count; i++)
                    {
                        var p = Model.VisibleProducts[i];
                        var breakClass = (Model.IsPrint && printRowsPerSheet > 0 && i > 0 && (i % printRowsPerSheet) == 0)
                            ? "print-page-break"
                            : "";
                        decimal rowTotalQty = Model.ProductTotalQtyAllOutletsInGroup.TryGetValue(p.Id, out var tq) ? tq : 0m;
                        decimal cost = Model.ProductCosts.TryGetValue(p.Id, out var cCost) ? cCost : 0m;
                        decimal price = Model.ProductPrices.TryGetValue(p.Id, out var pr) ? pr : 0m;
                        decimal rowTotalAmt = rowTotalQty * price;

                        string status = Model.ProductStatuses.TryGetValue(p.Id, out var st) ? st : "NO_ORDERS";
                        string statusClass = status switch
                        {
                            "ONE_ORDER" => "status-one-order",
                            "MANY_ORDERS" => "status-many-orders",
                            "LOWEST_QTY" => "status-lowest-qty",
                            "HIGHEST_QTY" => "status-highest-qty",
                            _ => "status-noorders"
                        };

                        <tr class="@breakClass" data-row-qty="@rowTotalQty" data-price="@price">
                            <td class="sticky-left-col fw-bold border-end vege-cell @statusClass">@p.Name</td>

                            @if (showCostCol) { <td class="text-end pe-2 bg-light text-muted sticky-cost-col">@cost.ToString("N2")</td> }

                            @if (showPriceTotalUomCols)
                            {
                                <td class="sticky-price-col price-cell">
                                    <input type="text" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*"
                                           class="excel-input price-input no-spin text-end"
                                           name="ProductPrices[@p.Id]"
                                           value="@price.ToString("0.00")"
                                           autocomplete="off" spellcheck="false" />
                                </td>

                                <td class="text-end pe-2 row-amt-cell sticky-total-col">@(rowTotalAmt > 0 ? rowTotalAmt.ToString("N2") : "-")</td>
                                <td class="text-center small text-muted sticky-uom-col">@p.Unit</td>
                            }

                            @foreach (var c in Model.VisibleOutlets)
                            {
                                string key = $"{p.Id}_{c.Id}";
                                decimal val = Model.MatrixQuantities.TryGetValue(key, out var v) ? v : 0m;

                                <td class="qty-td">
                                    <input type="text" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*"
                                           class="excel-input qty-input no-spin"
                                           name="MatrixQuantities[@key]"
                                           value="@(val > 0 ? val.ToString("0.##") : "")"
                                           autocomplete="off" spellcheck="false" />
                                </td>
                            }

                            @if (showRightTotalQtyCols)
                            {
                                <td class="text-center fw-bold bg-light row-qty-cell">@(rowTotalQty > 0 ? rowTotalQty.ToString("0.##") : "")</td>
                                <td class="text-center small text-muted">@p.Unit</td>
                            }
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="fw-bold">
                        <td class="sticky-left-col text-end pe-3 bg-light">GRAND TOTAL</td>
                        @if (showCostCol)
                        {
                            <td></td>
                        }
                        @if (showPriceTotalUomCols)
                        {
                            <td></td>
                            <td class="text-end pe-2 text-primary" id="grandTotalAmt">@Model.GrandTotalAmount.ToString("N2")</td>
                            <td></td>
                        }

                        @foreach (var _ in Model.VisibleOutlets) { <td></td> }

                        @if (showRightTotalQtyCols)
                        {
                            <td class="text-center text-danger" id="grandTotalQty">@Model.GrandTotalQty.ToString("0.##")</td>
                            <td></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </form>

    @if (Model.ShowDetails)
    {
    <div class="detail-wrap no-print">
        <div class="detail-card">
            <div class="detail-card-header">Vegetable Order Details</div>
            <div class="detail-summary">
                <div class="detail-metric">
                    <div class="label">Total Sales</div>
                    <div class="value">₱@Model.DetailTotalSales.ToString("N2")</div>
                </div>
                <div class="detail-metric">
                    <div class="label">Total Cost</div>
                    <div class="value">₱@Model.DetailTotalCost.ToString("N2")</div>
                </div>
                <div class="detail-metric">
                    <div class="label">Gross Profit</div>
                    <div class="value">₱@Model.DetailTotalGrossProfit.ToString("N2")</div>
                </div>
                <div class="detail-metric">
                    <div class="label">Expenses</div>
                    <div class="value">₱@Model.DetailTotalExpenses.ToString("N2")</div>
                </div>
                <div class="detail-metric">
                    <div class="label">Total Deductions</div>
                    <div class="value">₱@Model.DetailTotalDeductions.ToString("N2")</div>
                </div>
                <div class="detail-metric">
                    <div class="label">Delivery Payments</div>
                    <div class="value">₱@Model.DetailTotalDeliveryPayments.ToString("N2")</div>
                </div>
            </div>
            <div class="p-3">
                <div class="fw-bold mb-2">Who Purchased / Item Owner</div>
                <div class="table-responsive">
                    @{
                        var partnerNames = (Model.DetailPartnerNames ?? new List<string>())
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Select(x => x.Trim())
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .OrderBy(x => x)
                            .ToList();
                        var partnerCount = partnerNames.Count;
                        var seenPartnerProductIds = new HashSet<int>();
                    }
                    <table class="detail-table">
                        <thead>
                            <tr>
                                <th>Outlet</th>
                                <th>Product</th>
                                <th>Owner / Supplier</th>
                                <th>Qty</th>
                                <th>Amount</th>
                                <th>Cost</th>
                                <th>Gross Profit</th>
                                <th>Status</th>
                                @foreach (var pn in partnerNames)
                                {
                                    <th class="partner-col">@pn.ToUpperInvariant()</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailRows.Any())
                            {
                                foreach (var row in Model.DetailRows)
                                {
                                    var showPartner = seenPartnerProductIds.Add(row.ProductId);
                                    <tr>
                                        <td class="text-start">@row.OutletName</td>
                                        <td class="text-start">@row.ProductName</td>
                                        <td class="text-start">@row.OwnerName</td>
                                        <td>@row.Quantity.ToString("0.##")</td>
                                        <td class="text-end">₱@row.Amount.ToString("N2")</td>
                                        <td class="text-end">₱@row.CostAmount.ToString("N2")</td>
                                        <td class="text-end">₱@row.GrossProfit.ToString("N2")</td>
                                        <td>
                                            @if (row.Status == "UNPAID")
                                            {
                                                <span class="badge-unpaid">UNPAID</span>
                                            }
                                            else
                                            {
                                                <span class="badge-paid">PAID</span>
                                            }
                                        </td>
                                        @foreach (var pn in partnerNames)
                                        {
                                            decimal amt = 0m;
                                            if (showPartner && row.PartnerPurchaseByPartner != null)
                                            {
                                                row.PartnerPurchaseByPartner.TryGetValue(pn, out amt);
                                            }
                                            <td class="text-end partner-col">@(amt > 0 ? $"₱{amt:N2}" : "")</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(8 + partnerCount)" class="text-center text-muted">No orders for this date.</td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.DetailRows.Any())
                        {
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">TOTAL</td>
                                    <td class="text-end">₱@Model.DetailTotalSales.ToString("N2")</td>
                                    <td class="text-end">₱@Model.DetailTotalCost.ToString("N2")</td>
                                    <td class="text-end">₱@Model.DetailTotalGrossProfit.ToString("N2")</td>
                                    <td></td>
                                    @foreach (var pn in partnerNames)
                                    {
                                        Model.DetailPartnerOrderTotals.TryGetValue(pn, out var total);
                                        <td class="text-end partner-col">₱@total.ToString("N2")</td>
                                    }
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <div class="detail-finance-wrap">
                    <table class="detail-finance">
                        <thead>
                            <tr><th colspan="2">DEDUCTIONS</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailDeductionItems.Any())
                            {
                                foreach (var d in Model.DetailDeductionItems)
                                {
                                    <tr>
                                        <td class="text-start">@d.Label</td>
                                        <td class="amt">₱@d.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td class="text-start text-muted" colspan="2">No deductions</td></tr>
                            }
                            <tr class="total-row">
                                <td class="text-start">TOTAL DEDUCTIONS</td>
                                <td class="amt">₱@Model.DetailTotalDeductions.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <thead>
                            <tr><th colspan="2">EXPENSES</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailExpenseItems.Any())
                            {
                                foreach (var e in Model.DetailExpenseItems)
                                {
                                    <tr>
                                        <td class="text-start">@e.Label</td>
                                        <td class="amt">₱@e.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td class="text-start text-muted" colspan="2">No expenses</td></tr>
                            }
                            <tr class="total-row">
                                <td class="text-start">TOTAL EXPENSES</td>
                                <td class="amt">₱@Model.DetailTotalExpenses.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <thead>
                            <tr><th colspan="2">PARTNER CASH PURCHASES</th></tr>
                        </thead>
                        <tbody>
                            @{
                                var partnerGridNames = (Model.DetailPartnerNames ?? new List<string>())
                                    .Where(x => !string.IsNullOrWhiteSpace(x))
                                    .Select(x => x.Trim())
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(x => x)
                                    .ToList();

                                var groups = partnerGridNames
                                    .Select(pn => Model.DetailPartnerPurchaseGroups.FirstOrDefault(g => string.Equals(g.PartnerName, pn, StringComparison.OrdinalIgnoreCase))
                                                  ?? new HazelInvoice.ViewModels.PartnerPurchaseGroupVm { PartnerName = pn })
                                    .ToList();

                                var maxRows = groups.Count > 0 ? groups.Max(g => g.Items.Count) : 0;
                            }

                            @if (groups.Count > 0)
                            {
                                <tr>
                                    <td colspan="2" class="partner-grid-cell">
                                        <table class="pp-grid">
                                            <thead>
                                                <tr>
                                                    @for (var i = 0; i < groups.Count; i++)
                                                    {
                                                        <th class="pp-head pp-i-@i">@groups[i].PartnerName.ToUpperInvariant()</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (maxRows > 0)
                                                {
                                                    @for (var r = 0; r < maxRows; r++)
                                                    {
                                                        <tr>
                                                            @for (var c = 0; c < groups.Count; c++)
                                                            {
                                                                var item = r < groups[c].Items.Count ? groups[c].Items[r] : null;
                                                                var hasVal = item != null && item.Amount > 0;
                                                                <td class="pp-cell pp-i-@c @(hasVal ? "has-val" : "")" title="@(item?.Label ?? "")">
                                                                    @(hasVal ? $"₱{item!.Amount:N2}" : "")
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@groups.Count" class="text-start text-muted" style="padding:8px 10px;">
                                                            No partner cash purchases
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    @for (var i = 0; i < groups.Count; i++)
                                                    {
                                                        <td class="pp-total pp-i-@i">₱@groups[i].TotalAmount.ToString("N2")</td>
                                                    }
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr><td class="text-start text-muted" colspan="2">No partner cash purchases</td></tr>
                            }
                            <tr class="total-row">
                                <td class="text-start">TOTAL PARTNER PURCHASES</td>
                                <td class="amt">₱@Model.DetailTotalPartnerPurchases.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <thead>
                            <tr><th colspan="2">PARTNER ITEM PURCHASES (FROM SALES)</th></tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailPartnerSalesAttributions.Any())
                            {
                                var groups2 = (Model.DetailPartnerNames ?? new List<string>())
                                    .Where(x => !string.IsNullOrWhiteSpace(x))
                                    .Select(x => x.Trim())
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .OrderBy(x => x)
                                    .Select(pn => Model.DetailPartnerSalesAttributions.FirstOrDefault(g => string.Equals(g.PartnerName, pn, StringComparison.OrdinalIgnoreCase))
                                                  ?? new HazelInvoice.ViewModels.PartnerSalesAttributionGroupVm { PartnerName = pn })
                                    .ToList();

                                var maxRows2 = groups2.Count > 0 ? groups2.Max(g => g.Items.Count) : 0;

                                <tr>
                                    <td colspan="2" class="partner-grid-cell">
                                        <table class="pp-grid">
                                            <thead>
                                                <tr>
                                                    @for (var i = 0; i < groups2.Count; i++)
                                                    {
                                                        <th class="pp-head pp-i-@i">@groups2[i].PartnerName.ToUpperInvariant()</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (maxRows2 > 0)
                                                {
                                                    @for (var r = 0; r < maxRows2; r++)
                                                    {
                                                        <tr>
                                                            @for (var c = 0; c < groups2.Count; c++)
                                                            {
                                                                var item = r < groups2[c].Items.Count ? groups2[c].Items[r] : null;
                                                                var hasVal = item != null && item.Amount > 0;
                                                                <td class="pp-cell pp-i-@c @(hasVal ? "has-val" : "")" title="@(item?.Label ?? "")">
                                                                    @(hasVal ? $"₱{item!.Amount:N2}" : "")
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="@groups2.Count" class="text-start text-muted" style="padding:8px 10px;">
                                                            No partner-tagged sales (set Partner in New Sale line items)
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    @for (var i = 0; i < groups2.Count; i++)
                                                    {
                                                        <td class="pp-total pp-i-@i">₱@groups2[i].TotalAmount.ToString("N2")</td>
                                                    }
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr><td class="text-start text-muted" colspan="2">No partner-tagged sales (set Partner in New Sale line items)</td></tr>
                            }
                            <tr class="total-row">
                                <td class="text-start">TOTAL PARTNER ITEM PURCHASES</td>
                                <td class="amt">₱@Model.DetailTotalPartnerSalesAttributed.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="sales-row">
                                <td class="text-start">TOTAL SALES</td>
                                <td class="amt">₱@Model.DetailTotalSales.ToString("N2")</td>
                            </tr>
                            <tr class="sales-row">
                                <td class="text-start">SALES + PARTNER PURCHASES</td>
                                <td class="amt">₱@Model.DetailSalesSubTotal.ToString("N2")</td>
                            </tr>
                            <tr class="subtotal-row">
                                <td class="text-start">SUBTOTAL</td>
                                <td class="amt">₱@Model.DetailSubTotal.ToString("N2")</td>
                            </tr>
                            <tr class="fee-row">
                                <td class="text-start">@Model.DetailPercentFee.ToString("N2")%</td>
                                <td class="amt">₱@Model.DetailPercentFeeAmount.ToString("N2")</td>
                            </tr>
                            <tr class="net-row">
                                <td class="text-start">NET PROFIT</td>
                                <td class="amt">₱@Model.DetailNetProfit.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    }
</div>
@section Scripts {
    <script>
        window.vmMatrixConfig = {
            isPrintView: @Model.IsPrint.ToString().ToLower(),
            grandTotalQty: @Model.GrandTotalQty.ToString(System.Globalization.CultureInfo.InvariantCulture),
            grandTotalAmount: @Model.GrandTotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
    </script>
    <script src="~/js/vegetable-matrix.js" asp-append-version="true"></script>
}
