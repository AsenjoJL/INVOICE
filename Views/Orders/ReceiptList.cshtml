@model HazelInvoice.ViewModels.ReceiptListViewModel

@{
    bool isUnpaid = Model.Status == HazelInvoice.Models.PaymentStatus.Unpaid;
    ViewData["Title"] = isUnpaid ? "Unpaid Orders" : "Paid Orders";

    var receiptCount = Model.Receipts?.Count ?? 0;
    var totalItems = Model.Receipts?.Sum(r => r.Lines.Sum(l => l.Quantity)) ?? 0m;
    var dateValue = Model.Date?.ToString("yyyy-MM-dd") ?? "";
    var dateGroups = Model.DateGroups ?? new List<HazelInvoice.ViewModels.ReceiptDateGroupViewModel>();
    var filterSummary = Model.IsDateFiltered && Model.Date.HasValue
        ? Model.Date.Value.ToString("dddd, MMM dd, yyyy")
        : $"All {(isUnpaid ? "unpaid" : "paid")} orders";

    string StatusClass(HazelInvoice.Models.PaymentStatus status) => status switch
    {
        HazelInvoice.Models.PaymentStatus.Paid => "status-pill status-paid",
        HazelInvoice.Models.PaymentStatus.Partial => "status-pill status-partial",
        HazelInvoice.Models.PaymentStatus.Unpaid => "status-pill status-unpaid",
        HazelInvoice.Models.PaymentStatus.Void => "status-pill status-void",
        _ => "status-pill"
    };
}

<div class="container-fluid p-4 invoice-ui invoice-ui-min receiptlist-min admin-page-flow">
    <div class="invoice-hero invoice-hero-plain admin-page-hero">
        <div>
            <span class="admin-section-kicker">Order Monitor</span>
            <h1 class="invoice-title">@ViewData["Title"]</h1>
            <p class="invoice-sub">@filterSummary</p>
            <div class="receiptlist-stats">
                <span>Receipts: <strong>@receiptCount</strong></span>
                <span>Items: <strong>@totalItems.ToString("0.###")</strong></span>
                <span>Total: <strong>₱@Model.GrandTotal.ToString("N2")</strong></span>
            </div>
        </div>

        <div class="invoice-actions">
            <form method="get" asp-controller="Orders" asp-action="ReceiptList" class="admin-inline-filter">
                <input type="date" name="date" value="@dateValue" class="form-control form-control-sm" />
                <select name="status" class="form-select form-select-sm" style="min-width: 120px;">
                    <option value="Unpaid" selected="@(isUnpaid ? "selected" : null)">Unpaid</option>
                    <option value="Paid" selected="@(isUnpaid ? null : "selected")">Paid</option>
                </select>
                <button type="submit" class="invoice-btn invoice-btn-ghost">Go</button>
                @if (Model.IsDateFiltered)
                {
                    <a asp-controller="Orders"
                       asp-action="ReceiptList"
                       asp-route-status="@(isUnpaid ? "Unpaid" : "Paid")"
                       class="invoice-btn invoice-btn-ghost">
                        Clear Date
                    </a>
                }
            </form>
            <a href="/Receipts" class="invoice-btn invoice-btn-ghost">Back</a>
        </div>
    </div>

    <div class="invoice-card admin-surface-card">
        <div class="invoice-card-header">
            <h6 class="invoice-card-title">Receipt List</h6>
            <div class="admin-inline-filter">
                <input type="text" id="receiptSearch" class="form-control form-control-sm" placeholder="Search outlet or receipt #" style="min-width: 260px;" />
            </div>
        </div>

        <div class="invoice-card-body p-0">
            @if (Model.Receipts == null || Model.Receipts.Count == 0)
            {
                <div class="p-3 fw-bold">
                    @(Model.IsDateFiltered
                        ? $"No {Model.Status.ToString().ToLower()} orders found for this date."
                        : $"No {Model.Status.ToString().ToLower()} orders found.")
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-4 p-3">
                    @foreach (var group in dateGroups)
                    {
                        <section class="receiptlist-group" data-receipt-group>
                            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 px-1 pb-2">
                                <div>
                                    <div class="admin-section-kicker">Delivery Date</div>
                                    <h6 class="mb-1 fw-bold">@group.Date.ToString("dddd, MMM dd, yyyy")</h6>
                                    <div class="text-muted small">@group.Receipts.Count receipt@(group.Receipts.Count == 1 ? "" : "s")</div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="receiptlist-stats">
                                        <span>Items: <strong>@group.TotalItems.ToString("0.###")</strong></span>
                                        <span>Total: <strong>₱@group.TotalAmount.ToString("N2")</strong></span>
                                    </div>
                                    @if (isUnpaid && group.Receipts.Any())
                                    {
                                        <form asp-action="MarkDateGroupAsPaid" method="post" class="d-inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deliveryDate" value="@group.Date.ToString("yyyy-MM-dd")" />
                                            <button type="submit"
                                                    class="invoice-btn invoice-btn-primary"
                                                    onclick="return confirm('Mark all unpaid receipts for @group.Date.ToString("MMM dd, yyyy") as PAID?');">
                                                Mark All Paid
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="invoice-table mb-0" id="receiptListTable">
                                    <thead>
                                        <tr>
                                            <th>Outlet</th>
                                            <th>Receipt #</th>
                                            <th>Time</th>
                                            <th class="text-end">Total</th>
                                            <th class="text-end">Paid</th>
                                            <th class="text-end">Balance</th>
                                            <th>Status</th>
                                            <th>Items</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in group.Receipts)
                                        {
                                            var hay = $"{r.CustomerName} {r.ReceiptNumber}".ToLowerInvariant();
                                            <tr data-receipt-row data-search="@hay">
                                                <td class="fw-bold">@r.CustomerName</td>
                                                <td>@r.ReceiptNumber</td>
                                                <td>@r.Date.ToString("h:mm tt")</td>
                                                <td class="text-end fw-bold">@r.TotalAmount.ToString("N2")</td>
                                                <td class="text-end">@r.PaidAmount.ToString("N2")</td>
                                                <td class="text-end">@((r.TotalAmount - r.PaidAmount).ToString("N2"))</td>
                                                <td><span class="@StatusClass(r.Status)">@r.Status</span></td>
                                                <td>
                                                    <details class="receiptlist-details">
                                                        <summary>@r.Lines.Count item@(r.Lines.Count == 1 ? "" : "s")</summary>
                                                        <div class="receiptlist-lines">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Item</th>
                                                                        <th class="text-end">Price</th>
                                                                        <th class="text-center">Qty</th>
                                                                        <th class="text-end">Amt</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var line in r.Lines)
                                                                    {
                                                                        <tr>
                                                                            <td>@line.ItemName</td>
                                                                            <td class="text-end">@line.Price.ToString("N0")</td>
                                                                            <td class="text-center">@line.Quantity.ToString("0.###") @line.Unit</td>
                                                                            <td class="text-end">@line.Amount.ToString("N2")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </details>
                                                </td>
                                                <td class="text-end">
                                                    @if (isUnpaid)
                                                    {
                                                        <form asp-action="MarkAsPaid" method="post" class="d-inline-block">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@r.Id" />
                                                            <input type="hidden" name="returnDate" value="@r.Date.ToString("yyyy-MM-dd")" />
                                                            <button type="submit"
                                                                    class="invoice-btn invoice-btn-ghost"
                                                                    onclick="return confirm('Mark this receipt as PAID?');">
                                                                Mark Paid
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        const input = document.getElementById("receiptSearch");
        const rows = Array.from(document.querySelectorAll("[data-receipt-row]"));
        const groups = Array.from(document.querySelectorAll("[data-receipt-group]"));
        if (!input || rows.length === 0) return;

        input.addEventListener("input", () => {
            const term = (input.value || "").trim().toLowerCase();
            rows.forEach(r => {
                const hay = (r.dataset.search || "");
                const match = !term || hay.includes(term);
                r.style.display = match ? "" : "none";
            });

            groups.forEach(group => {
                const visibleRows = group.querySelectorAll("[data-receipt-row]:not([style*='display: none'])");
                group.style.display = visibleRows.length > 0 ? "" : "none";
            });
        });
    })();
</script>
