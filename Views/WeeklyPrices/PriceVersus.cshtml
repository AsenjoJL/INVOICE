@model HazelInvoice.ViewModels.PriceVersusViewModel

@{
    ViewData["Title"] = "Price Versus Setup";
    ViewData["NotePurpose"] = "Review and adjust weekly selling prices for the selected week.";
    ViewData["NoteInstructions"] = "Vegetable Order Excel import now updates weekly prices automatically. Use this page for quick review or manual adjustments for the selected week.";
}

<style>
    .price-setup-page {
        --price-line: #e8e8e8;
        --price-text: #0a0a0a;
        --price-muted: #888888;
        --price-soft: #f7f7f7;
        font-family: 'DM Sans', sans-serif;
        color: var(--price-text);
    }
    .price-setup-shell {
        max-width: 1180px;
        margin: 0 auto;
    }
    .price-setup-kicker,
    .price-table-toolbar-label,
    .price-field-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--price-muted);
    }
    .price-setup-headline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: 1.15rem 1.35rem;
        background: #ffffff;
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-xl);
        box-shadow: none;
        box-sizing: border-box;
        overflow: visible;
    }
    .price-setup-meta {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }
    .price-setup-sub {
        margin: 0;
        color: var(--price-muted);
        font-size: 14px;
        line-height: 1.5;
    }
    .price-week-label {
        color: var(--price-text);
        font-weight: 600;
    }
    .price-btn {
        border-radius: var(--ui-radius-xl);
        font-weight: 500;
        border-width: 1px;
        box-shadow: none !important;
    }
    .price-btn-neutral {
        border-color: var(--price-line);
        color: var(--price-text);
        background: #ffffff;
    }
    .price-btn-primary {
        border-color: #0a0a0a;
        background: #0a0a0a;
        color: #ffffff;
    }
    .price-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        flex: 0 0 auto;
    }
    .price-setup-summary {
        max-width: 760px;
    }
    .price-back-link {
        min-height: 44px;
        padding-inline: 1rem 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .price-control-row {
        display: grid;
        grid-template-columns: minmax(220px, 280px) minmax(260px, 1fr);
        gap: 1rem;
        align-items: start;
        margin-bottom: 1.75rem;
    }
    .price-date-form {
        background: #ffffff;
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        padding: 1rem 1.1rem;
    }
    .price-search-form {
        display: grid;
        grid-template-columns: minmax(200px, 1fr) 100px 130px;
        gap: 0.75rem;
        align-items: end;
        background: #ffffff;
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        padding: 1rem 1.1rem;
    }
    .price-search-form .form-control,
    .price-search-form .form-select {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        min-height: 44px;
        box-shadow: none;
    }
    .price-import-form {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 180px 180px;
        gap: 0.75rem;
        align-items: end;
        background: #ffffff;
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        padding: 1rem 1.1rem;
    }
    .price-import-form .form-control {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        min-height: 44px;
        box-shadow: none;
    }
    .price-date-form label {
        display: block;
        margin-bottom: 0.55rem;
    }
    .price-date-form input[type="date"] {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        font-weight: 500;
        min-height: 48px;
    }
    .price-card {
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        overflow: hidden;
    }
    .price-table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--price-line);
        background: #ffffff;
    }
    .price-table-toolbar-copy {
        min-width: min(100%, 540px);
    }
    .price-table-toolbar-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--price-muted);
    }
    .price-table-toolbar-title {
        margin: 0.45rem 0 0;
        font-size: 16px;
        font-weight: 600;
        color: var(--price-text);
    }
    .price-table-toolbar-sub {
        margin: 0.35rem 0 0;
        color: var(--price-muted);
        font-size: 14px;
        line-height: 1.6;
    }
    .price-table-toolbar-meta {
        margin-top: 0.55rem;
        color: var(--price-muted);
        font-size: 12px;
    }
    .price-save-btn {
        min-width: 180px;
        min-height: 46px;
        padding-inline: 1.15rem;
    }
    .price-save-btn.is-saving {
        opacity: 0.72;
        pointer-events: none;
    }
    .price-feedback {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--price-line);
        font-size: 14px;
    }
    .price-feedback-success {
        background: #fbfbfb;
        color: #111111;
    }
    .price-feedback-error {
        background: #fff8f8;
        color: #8b1e1e;
    }
    .price-feedback.is-hidden {
        display: none;
    }
    .price-table-wrap {
        max-height: 70vh;
        overflow: auto;
        scroll-margin-top: 110px;
    }
    .price-table {
        margin: 0;
    }
    .price-table thead th {
        background: #ffffff;
        color: var(--price-muted);
        font-family: 'DM Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 9px;
        font-weight: 500;
        border-bottom: 1px solid var(--price-line);
    }
    .price-table tbody tr:hover {
        background: #fafafa;
    }
    .price-table .row-edited td {
        background: #fafafa !important;
    }
    .price-product-name {
        font-weight: 500;
        color: var(--price-text);
    }
    .price-unit {
        color: var(--price-muted);
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .price-input {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        font-weight: 500;
        box-shadow: none;
        min-height: 44px;
    }
    .price-input:focus {
        border-color: #d4d4d4;
        box-shadow: none;
    }
    .price-value {
        color: var(--price-text);
    }
    .price-delivery-input {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        background: #ffffff;
        color: var(--price-text);
        font-weight: 500;
        min-height: 44px;
    }
    .price-reset-btn {
        border-radius: var(--ui-radius-md);
        font-weight: 500;
    }
    .price-status {
        border-radius: 999px;
        font-family: 'DM Mono', monospace;
        font-weight: 500;
        font-size: 10px;
        padding: 0.3rem 0.65rem;
    }
    .price-status-weekly {
        background: #ffffff;
        color: var(--price-text);
        border: 1px solid var(--price-line);
    }
    .price-status-default {
        background: #ffffff;
        color: var(--price-muted);
        border: 1px solid var(--price-line);
    }
    .price-saved-row td {
        background: #f8f8f8 !important;
        transition: background-color 0.25s ease;
    }
    .price-pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.95rem 1.25rem 1.1rem;
        border-top: 1px solid var(--price-line);
        background: #ffffff;
    }
    .price-pager-text {
        color: var(--price-muted);
        font-size: 13px;
    }
    .price-pager-actions {
        display: flex;
        gap: 0.65rem;
        align-items: center;
    }
    @@media (max-width: 768px) {
        .price-setup-header,
        .price-table-toolbar,
        .price-control-row {
            align-items: flex-start !important;
        }
        .price-setup-headline {
            flex-direction: column;
            align-items: flex-start;
            padding: 1rem;
        }
        .price-actions {
            width: 100%;
            justify-content: flex-start;
        }
        .price-control-row {
            grid-template-columns: 1fr;
        }
        .price-search-form {
            grid-template-columns: 1fr;
        }
        .price-import-form {
            grid-template-columns: 1fr;
        }
        .price-save-btn {
            width: 100%;
        }
        .price-pager {
            flex-direction: column;
            align-items: stretch;
        }
        .price-pager-actions {
            justify-content: space-between;
        }
    }
</style>

<div class="container-fluid p-4 price-setup-page">
    <div class="price-setup-shell">
    <div class="price-setup-header price-setup-headline">
        <div class="price-setup-meta">
            <div class="price-setup-kicker">Finance / Weekly Pricing</div>
            <p class="price-setup-sub">
                Viewing weekly price setup for: 
                <span class="price-week-label">@Model.WeekStart.ToString("MMM dd") - @Model.WeekEnd.ToString("MMM dd, yyyy")</span>
            </p>
        </div>
        <div class="price-actions">
            <a asp-controller="Orders" asp-action="VegetableMatrix" class="btn price-btn price-btn-neutral price-back-link">
                <i class="bi bi-arrow-left"></i> Back to Matrix
            </a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="price-control-row">
        <form method="get" class="price-date-form">
            <label class="price-field-label">View Prices For Date</label>
            <input type="date" name="date" class="form-control" value="@Model.TargetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </form>
        <form method="get" class="price-search-form">
            <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="page" value="1" />
            <div>
                <label class="price-field-label">Search Product</label>
                <input type="text" name="q" class="form-control" value="@Model.SearchTerm" placeholder="Name, SKU, category, unit" />
            </div>
            <div>
                @{
                    var clientGroupOptions = (ViewBag.ClientGroupOptions as List<HazelInvoice.Models.ClientGroup>) ?? new List<HazelInvoice.Models.ClientGroup>();
                    var selectedGroupId = ViewBag.ClientGroupId as int?;
                }
                <label class="price-field-label">Client Group</label>
                <select name="clientGroupId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Groups --</option>
                    @foreach (var g in clientGroupOptions)
                    {
                        if (selectedGroupId == g.Id)
                        {
                            <option value="@g.Id" selected>@g.Name</option>
                        }
                        else
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="price-field-label">Page Size</label>
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="40" selected="@(Model.PageSize == 40)">40</option>
                    <option value="80" selected="@(Model.PageSize == 80)">80</option>
                    <option value="120" selected="@(Model.PageSize == 120)">120</option>
                </select>
            </div>
            <div>
                <label class="price-field-label">Apply</label>
                <button type="submit" class="btn price-btn price-btn-neutral w-100">Filter</button>
            </div>
        </form>
    </div>

    <form asp-action="ImportTemplate" method="post" enctype="multipart/form-data" class="price-import-form mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetDate" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
        <input type="hidden" name="page" value="@Model.CurrentPage" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <input type="hidden" name="clientGroupId" value="@ViewBag.ClientGroupId" />
        <div>
            <label class="price-field-label">Import Weekly Price Template</label>
            <input type="file" name="importFile" accept=".xlsx" class="form-control" required />
        </div>
        <div>
            <label class="price-field-label">Import Mode</label>
            <select name="importMode" class="form-control">
                <option value="both">Both Delivery + Purchase Cost</option>
                <option value="delivery-only">Delivery Prices Only</option>
                <option value="original-only">Purchase Cost Only</option>
            </select>
        </div>
        <div>
            <label class="price-field-label">Apply</label>
            <button type="submit" class="btn price-btn price-btn-primary w-100">
                <i class="bi bi-upload me-1"></i> Import Prices
            </button>
        </div>
    </form>

    <div class="price-import-form mb-4">
        <div>
            <label class="price-field-label">Download Template</label>
            <a asp-action="DownloadTemplate"
               asp-route-targetDate="@Model.TargetDate.ToString("yyyy-MM-dd")"
               asp-route-importMode="both"
               asp-route-clientGroupId="@ViewBag.ClientGroupId"
               class="btn price-btn price-btn-neutral w-100">
                <i class="bi bi-download me-1"></i> Both Delivery + Purchase Cost
            </a>
        </div>
        <div>
            <label class="price-field-label">Delivery Only</label>
            <a asp-action="DownloadTemplate"
               asp-route-targetDate="@Model.TargetDate.ToString("yyyy-MM-dd")"
               asp-route-importMode="delivery-only"
               asp-route-clientGroupId="@ViewBag.ClientGroupId"
               class="btn price-btn price-btn-neutral w-100">
                <i class="bi bi-download me-1"></i> Delivery Prices Only
            </a>
        </div>
        <div>
            <label class="price-field-label">Purchase Cost</label>
            <a asp-action="DownloadTemplate"
               asp-route-targetDate="@Model.TargetDate.ToString("yyyy-MM-dd")"
               asp-route-importMode="original-only"
               asp-route-clientGroupId="@ViewBag.ClientGroupId"
               class="btn price-btn price-btn-neutral w-100">
                <i class="bi bi-download me-1"></i> Purchase Cost Only
            </a>
        </div>
    </div>

    <div class="card price-card">
        <div class="card-body p-0">
            <form method="post" id="versusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TargetDate" />
                <input type="hidden" asp-for="SearchTerm" />
                <input type="hidden" asp-for="CurrentPage" />
                <input type="hidden" asp-for="PageSize" />
                <input type="hidden" name="clientGroupId" value="@ViewBag.ClientGroupId" />

                <div asp-validation-summary="All" class="text-danger px-4 pt-3"></div>

                @{
                    var successMessage = TempData["SuccessMessage"] as string;
                    var errorMessage = TempData["ErrorMessage"] as string;
                    var feedbackMessage = !string.IsNullOrWhiteSpace(errorMessage) ? errorMessage : successMessage;
                    var feedbackClass = !string.IsNullOrWhiteSpace(errorMessage) ? "price-feedback-error" : "price-feedback-success";
                    var feedbackHiddenClass = string.IsNullOrWhiteSpace(feedbackMessage) ? "is-hidden" : string.Empty;
                }
                <div class="price-feedback @feedbackClass @feedbackHiddenClass" id="priceFeedback">@feedbackMessage</div>

                <div class="price-table-toolbar" id="priceTableAnchor">
                    <div class="price-table-toolbar-copy">
                        <div class="price-table-toolbar-label">Table Actions</div>
                        <h3 class="price-table-toolbar-title">Weekly prices for the selected week.</h3>
                        <p class="price-table-toolbar-sub">Vegetable Order Excel import now sets weekly prices automatically. Use this table only to review or adjust product pricing before future sales and outlet orders are created.</p>
                        <div class="price-table-toolbar-meta">
                            Showing @Model.Items.Count of @Model.TotalItems product@(Model.TotalItems == 1 ? "" : "s") on page @Model.CurrentPage of @Model.TotalPages.
                        </div>
                    </div>
                    <button type="submit" class="btn price-btn price-btn-primary price-save-btn" id="priceSaveButton">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
                
                <div class="table-responsive price-table-wrap" id="priceTableWrap">
                    <table class="table table-hover align-middle price-table" id="priceTable">
                        <thead class="sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="ps-4 py-3">Product Name</th>
                                <th class="py-3">Unit</th>
                                <th class="text-end py-3" style="width: 140px;">Purchase Cost</th>
                                <th class="text-end py-3" style="width: 140px;">Markup (Added)</th>
                                <th class="text-end py-3" style="width: 140px;">Base Price</th>
                                <th class="text-end py-3" style="width: 140px;">Delivery Price</th>
                                <th class="text-center py-3" style="width: 90px;">Reset</th>
                                <th class="text-center py-3" style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr class="item-row"
                                    data-product-id="@item.ProductId"
                                    data-master-cost="@item.MasterCost.ToString("0.00")"
                                    data-master-markup="@item.MasterMarkup.ToString("0.00")"
                                    data-delivery-fee="@((item.DeliveryFee ?? item.MasterDeliveryFee).ToString("0.00"))">
                                    <td class="ps-4 price-product-name">
                                        @item.ProductName
                                        <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                        <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                    </td>
                                    <td class="price-unit">@item.Unit</td>
                                    
                                    <td class="text-end">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light border-0">₱</span>
                                            <input type="number" step="0.01" min="0"
                                                   name="Items[@i].Cost"
                                                   class="form-control text-end cost-input price-input"
                                                   value="@item.Cost.ToString("0.00")" />
                                        </div>
                                    </td>
                                    
                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].Markup"
                                               class="form-control text-end markup-input price-input"
                                               value="@item.Markup.ToString("0.00")" />
                                    </td>

                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].BasePrice"
                                               class="form-control text-end base-price-input price-input price-value"
                                               value="@(item.BasePrice.ToString("0.00"))" />
                                    </td>

                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].DeliveryPrice"
                                               class="form-control text-end delivery-price-input price-delivery-input"
                                               value="@item.DeliveryPrice.ToString("0.00")" />
                                        <input type="hidden" name="Items[@i].DeliveryFee" value="@((item.DeliveryFee ?? item.MasterDeliveryFee).ToString("0.00"))" class="delivery-fee-hidden" />
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-secondary price-reset-btn reset-cost-btn">Reset</button>
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (item.HasWeeklyRecord)
                                        {
                                            <span class="badge price-status price-status-weekly">Weekly</span>
                                        }
                                        else
                                        {
                                            <span class="badge price-status price-status-default">Default</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="price-pager">
                    <div class="price-pager-text">
                        Page @Model.CurrentPage of @Model.TotalPages
                    </div>
                    <div class="price-pager-actions">
                        <a class="btn price-btn price-btn-neutral @(Model.CurrentPage <= 1 ? "disabled" : "")"
                           asp-action="PriceVersus"
                           asp-route-date="@Model.TargetDate.ToString("yyyy-MM-dd")"
                           asp-route-q="@Model.SearchTerm"
                           asp-route-page="@(Math.Max(1, Model.CurrentPage - 1))"
                           asp-route-pageSize="@Model.PageSize">Previous</a>
                        <a class="btn price-btn price-btn-neutral @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                           asp-action="PriceVersus"
                           asp-route-date="@Model.TargetDate.ToString("yyyy-MM-dd")"
                           asp-route-q="@Model.SearchTerm"
                           asp-route-page="@(Math.Min(Model.TotalPages, Model.CurrentPage + 1))"
                           asp-route-pageSize="@Model.PageSize">Next</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const table = document.getElementById('priceTable');
        const versusForm = document.getElementById('versusForm');
        const tableWrap = document.getElementById('priceTableWrap');
        const tableAnchor = document.getElementById('priceTableAnchor');
        const feedback = document.getElementById('priceFeedback');
        const saveButton = document.getElementById('priceSaveButton');
        const scrollKey = 'priceVersus:windowScroll';
        const tableScrollKey = 'priceVersus:tableScroll';
        const restoreFlagKey = 'priceVersus:restoreAfterSave';
        const restoreHintKey = 'priceVersus:restoreHint';

        const parseNumber = (value) => {
            if (!value) return 0;
            return parseFloat(value.toString().replace(',', '.')) || 0;
        };

        const saveScrollState = () => {
            sessionStorage.setItem(scrollKey, String(window.scrollY || 0));
            if (tableWrap) {
                sessionStorage.setItem(tableScrollKey, String(tableWrap.scrollTop || 0));
            }
            sessionStorage.setItem(restoreFlagKey, 'true');
            sessionStorage.setItem(restoreHintKey, window.location.pathname);
        };

        const restoreScrollState = () => {
            const shouldRestore = sessionStorage.getItem(restoreFlagKey) === 'true'
                || sessionStorage.getItem(restoreHintKey) === window.location.pathname;

            if (!shouldRestore) return;

            const windowScroll = parseInt(sessionStorage.getItem(scrollKey) || '', 10);
            const tableScroll = parseInt(sessionStorage.getItem(tableScrollKey) || '', 10);
            requestAnimationFrame(() => {
                if (!Number.isNaN(windowScroll)) {
                    window.scrollTo({ top: windowScroll, behavior: 'instant' });
                } else if (tableAnchor) {
                    tableAnchor.scrollIntoView({ block: 'start' });
                }

                if (tableWrap && !Number.isNaN(tableScroll)) {
                    tableWrap.scrollTop = tableScroll;
                }

                sessionStorage.removeItem(scrollKey);
                sessionStorage.removeItem(tableScrollKey);
                sessionStorage.removeItem(restoreFlagKey);
                sessionStorage.removeItem(restoreHintKey);
            });
        };

        restoreScrollState();

        const showFeedback = (message, isError) => {
            if (!feedback) return;
            feedback.textContent = message;
            feedback.className = `price-feedback ${isError ? 'price-feedback-error' : 'price-feedback-success'}`;
        };

        const updateRowFromCostMarkup = (row) => {
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');

            const cost = parseNumber(costInput?.value);
            const markup = parseNumber(markupInput?.value);
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            const basePrice = cost + markup;
            const currentDeliveryPrice = parseNumber(deliveryPriceInput?.value);
            const deliveryFee = hiddenDeliveryFee ? parseNumber(hiddenDeliveryFee.value) : parseNumber(row.dataset.deliveryFee);
            const deliveryPrice = currentDeliveryPrice > 0 ? currentDeliveryPrice : basePrice + deliveryFee;

            const basePriceInput = row.querySelector('.base-price-input');
            if (basePriceInput) basePriceInput.value = basePrice.toFixed(2);

            if (deliveryPriceInput) deliveryPriceInput.value = deliveryPrice.toFixed(2);
            if (hiddenDeliveryFee) hiddenDeliveryFee.value = (deliveryPrice - basePrice).toFixed(2);

            row.classList.add('row-edited');
        };

        const updateRowFromBasePrice = (row) => {
            const costInput = row.querySelector('.cost-input');
            const basePriceInput = row.querySelector('.base-price-input');
            const markupInput = row.querySelector('.markup-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');

            const cost = parseNumber(costInput?.value);
            const basePrice = parseNumber(basePriceInput?.value);
            const deliveryPrice = parseNumber(deliveryPriceInput?.value);
            const markup = basePrice - cost;

            if (markupInput) markupInput.value = markup.toFixed(2);
            if (deliveryPriceInput && deliveryPriceInput.value.trim() === '') {
                deliveryPriceInput.value = basePrice.toFixed(2);
            }
            if (hiddenDeliveryFee) {
                hiddenDeliveryFee.value = (parseNumber(deliveryPriceInput?.value) - basePrice).toFixed(2);
            }

            row.classList.add('row-edited');
        };

        const updateRowFromDeliveryPrice = (row) => {
            const basePriceInput = row.querySelector('.base-price-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            const basePrice = parseNumber(basePriceInput?.value);
            const deliveryPrice = parseNumber(deliveryPriceInput?.value);

            if (hiddenDeliveryFee) {
                hiddenDeliveryFee.value = Math.max(deliveryPrice - basePrice, 0).toFixed(2);
            }

            row.classList.add('row-edited');
        };

        table.addEventListener('input', function(e) {
            if (e.target.classList.contains('markup-input') || 
                e.target.classList.contains('cost-input')) {
                const row = e.target.closest('tr');
                updateRowFromCostMarkup(row);
            }
            if (e.target.classList.contains('base-price-input')) {
                const row = e.target.closest('tr');
                updateRowFromBasePrice(row);
            }
            if (e.target.classList.contains('delivery-price-input')) {
                const row = e.target.closest('tr');
                updateRowFromDeliveryPrice(row);
            }
        });

        table.addEventListener('click', function(e) {
            const btn = e.target.closest('.reset-cost-btn');
            if (!btn) return;

            const row = btn.closest('tr');
            const masterCost = parseNumber(row.dataset.masterCost);
            const masterMarkup = parseNumber(row.dataset.masterMarkup);
            const masterDeliveryFee = parseNumber(row.dataset.deliveryFee);
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            if (costInput) costInput.value = masterCost.toFixed(2);
            if (markupInput) markupInput.value = masterMarkup.toFixed(2);
            if (deliveryPriceInput) deliveryPriceInput.value = (masterCost + masterMarkup + masterDeliveryFee).toFixed(2);
            if (hiddenDeliveryFee) hiddenDeliveryFee.value = masterDeliveryFee.toFixed(2);

            updateRowFromCostMarkup(row);
        });

        versusForm.addEventListener('submit', function() {
            saveScrollState();
            if (saveButton) {
                saveButton.classList.add('is-saving');
                saveButton.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving...';
            }
        });
    });
</script>
