@model HazelInvoice.ViewModels.PriceVersusViewModel

@{
    ViewData["Title"] = "Price Versus Setup";
    ViewData["NotePurpose"] = "Set weekly cost, markup, and base price for each product.";
    ViewData["NoteInstructions"] = "Reset restores master cost/markup; Save changes applies to the selected week (and optionally to master cost).";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap');

    .price-setup-page {
        font-family: 'Inter', sans-serif;
        color: #0f172a;
    }
    .price-setup-header {
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 0;
        box-shadow: none;
        padding: 1rem 1.25rem;
    }
    .price-setup-title {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        color: #000000;
    }
    .price-setup-sub {
        margin: 0.25rem 0 0;
        color: #334155;
        font-weight: 600;
    }
    .price-week-label {
        color: #000000;
        font-weight: 800;
    }
    .price-btn {
        border-radius: 0;
        font-weight: 700;
        border-width: 1px;
        box-shadow: none !important;
    }
    .price-btn-neutral {
        border-color: #cbd5e1;
        color: #0f172a;
        background: #ffffff;
    }
    .price-btn-primary {
        border-color: #0f766e;
        background: #0f766e;
        color: #ffffff;
    }
    .price-date-form {
        display: inline-block;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 0;
        box-shadow: none;
        padding: 0.75rem 0.9rem;
    }
    .price-date-form label {
        font-weight: 700;
        color: #0f172a;
        margin-right: 0.5rem;
    }
    .price-date-form input[type="date"] {
        border-radius: 0;
        border: 1px solid #cbd5e1;
        font-weight: 600;
    }
    .price-card {
        border: 2px solid #cbd5e1;
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
    }
    .price-table {
        margin: 0;
    }
    .price-table thead th {
        background: #f1f5f9;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.76rem;
        border-bottom: 1px solid #cbd5e1;
    }
    .price-table tbody tr:nth-child(even) {
        background: #fafcff;
    }
    .price-table tbody tr:hover {
        background: #f0fdfa;
    }
    .price-table .row-edited {
        background: #fff7ed !important;
    }
    .price-product-name {
        font-weight: 800;
        color: #111827;
    }
    .price-unit {
        color: #64748b;
        font-weight: 600;
    }
    .price-input {
        border-radius: 0;
        border: 1px solid #cbd5e1;
        font-weight: 700;
        box-shadow: none;
    }
    .price-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.2);
    }
    .price-value {
        color: #2563eb;
    }
    .price-delivery-input {
        border-radius: 0;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #2563eb;
        font-weight: 700;
    }
    .price-reset-btn {
        border-radius: 0;
        font-weight: 700;
    }
    .price-status {
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.3rem 0.65rem;
    }
    .price-status-weekly {
        background: #fef3c7;
        color: #92400e;
    }
    .price-status-default {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #cbd5e1;
    }
</style>

<div class="container-fluid p-4 price-setup-page">
    <div class="price-setup-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="price-setup-title">Price Versus Setup</h2>
            <p class="price-setup-sub">
                Original Price vs Selling Price for Week: 
                <span class="price-week-label">@Model.WeekStart.ToString("MMM dd") - @Model.WeekEnd.ToString("MMM dd, yyyy")</span>
            </p>
        </div>
        <div>
            <a asp-controller="Orders" asp-action="VegetableMatrix" class="btn price-btn price-btn-neutral">
                <i class="bi bi-arrow-left"></i> Back to Matrix
            </a>
            <button type="submit" form="versusForm" class="btn price-btn price-btn-primary ms-2 px-4">
                <i class="bi bi-save me-1"></i> Save Changes
            </button>
        </div>
    </div>

    <partial name="_PageNote" />

    <form method="get" class="mb-4 price-date-form">
        <label>View Prices For Date:</label>
        <input type="date" name="date" class="form-control d-inline-block w-auto" value="@Model.TargetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </form>

    <div class="card price-card">
        <div class="card-body p-0">
            <form method="post" id="versusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TargetDate" />

                <div asp-validation-summary="All" class="text-danger px-4 pt-3"></div>
                <div class="px-4 pt-2 pb-3 border-bottom">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="ApplyToMasterCost" />
                        <label class="form-check-label" asp-for="ApplyToMasterCost">
                            Apply cost changes to master product cost
                        </label>
                    </div>
                    <div class="text-muted small">If unchecked, cost changes apply only to the selected week.</div>
                </div>
                
                <div class="table-responsive" style="max-height: 70vh;">
                    <table class="table table-hover align-middle price-table" id="priceTable">
                        <thead class="sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="ps-4 py-3">Product Name</th>
                                <th class="py-3">Unit</th>
                                <th class="text-end py-3" style="width: 140px;">Original Price</th>
                                <th class="text-end py-3" style="width: 140px;">Markup (Added)</th>
                                <th class="text-end py-3" style="width: 140px;">Base Price</th>
                                <th class="text-end py-3" style="width: 140px;">Delivery Price</th>
                                <th class="text-center py-3" style="width: 90px;">Reset</th>
                                <th class="text-center py-3" style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr class="item-row"
                                    data-master-cost="@item.MasterCost.ToString("0.00")"
                                    data-master-markup="@item.MasterMarkup.ToString("0.00")"
                                    data-delivery-fee="@((item.DeliveryFee ?? item.MasterDeliveryFee).ToString("0.00"))">
                                    <td class="ps-4 price-product-name">
                                        @item.ProductName
                                        <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                        <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                    </td>
                                    <td class="price-unit">@item.Unit</td>
                                    
                                    <td class="text-end">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light border-0">₱</span>
                                            <input type="number" step="0.01" min="0"
                                                   name="Items[@i].Cost"
                                                   class="form-control text-end cost-input price-input"
                                                   value="@item.Cost.ToString("0.00")" />
                                        </div>
                                    </td>
                                    
                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].Markup"
                                               class="form-control text-end markup-input price-input"
                                               value="@item.Markup.ToString("0.00")" />
                                    </td>

                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].BasePrice"
                                               class="form-control text-end base-price-input price-input price-value"
                                               value="@(item.BasePrice.ToString("0.00"))" />
                                    </td>

                                    <td class="text-end">
                                        <input type="text" 
                                               class="form-control text-end delivery-price-input price-delivery-input" 
                                               value="@((item.Cost + item.Markup + (item.DeliveryFee ?? item.MasterDeliveryFee)).ToString("0.00"))" 
                                               readonly />
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-secondary price-reset-btn reset-cost-btn">Reset</button>
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (item.HasWeeklyRecord)
                                        {
                                            <span class="badge price-status price-status-weekly">Weekly</span>
                                        }
                                        else
                                        {
                                            <span class="badge price-status price-status-default">Default</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const table = document.getElementById('priceTable');

        const parseNumber = (value) => {
            if (!value) return 0;
            return parseFloat(value.toString().replace(',', '.')) || 0;
        };

        const updateRowFromCostMarkup = (row) => {
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');

            const cost = parseNumber(costInput?.value);
            const markup = parseNumber(markupInput?.value);
            const deliveryFee = parseNumber(row.dataset.deliveryFee);
            const basePrice = cost + markup;
            const deliveryPrice = basePrice + deliveryFee;

            const basePriceInput = row.querySelector('.base-price-input');
            if (basePriceInput) basePriceInput.value = basePrice.toFixed(2);

            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            if (deliveryPriceInput) deliveryPriceInput.value = deliveryPrice.toFixed(2);

            row.classList.add('row-edited');
        };

        const updateRowFromBasePrice = (row) => {
            const costInput = row.querySelector('.cost-input');
            const basePriceInput = row.querySelector('.base-price-input');
            const markupInput = row.querySelector('.markup-input');

            const cost = parseNumber(costInput?.value);
            const basePrice = parseNumber(basePriceInput?.value);
            const deliveryFee = parseNumber(row.dataset.deliveryFee);
            const markup = basePrice - cost;
            const deliveryPrice = basePrice + deliveryFee;

            if (markupInput) markupInput.value = markup.toFixed(2);
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            if (deliveryPriceInput) deliveryPriceInput.value = deliveryPrice.toFixed(2);

            row.classList.add('row-edited');
        };

        table.addEventListener('input', function(e) {
            if (e.target.classList.contains('markup-input') || 
                e.target.classList.contains('cost-input')) {
                const row = e.target.closest('tr');
                updateRowFromCostMarkup(row);
            }
            if (e.target.classList.contains('base-price-input')) {
                const row = e.target.closest('tr');
                updateRowFromBasePrice(row);
            }
        });

        table.addEventListener('click', function(e) {
            const btn = e.target.closest('.reset-cost-btn');
            if (!btn) return;

            const row = btn.closest('tr');
            const masterCost = parseNumber(row.dataset.masterCost);
            const masterMarkup = parseNumber(row.dataset.masterMarkup);
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');
            if (costInput) costInput.value = masterCost.toFixed(2);
            if (markupInput) markupInput.value = masterMarkup.toFixed(2);

            updateRowFromCostMarkup(row);
        });
    });
</script>
