@model HazelInvoice.ViewModels.PriceVersusViewModel

@{
    ViewData["Title"] = "Price Versus Setup";
    ViewData["NotePurpose"] = "Set weekly cost, markup, and base price for each product.";
    ViewData["NoteInstructions"] = "Reset restores master cost/markup; saved weekly prices apply to future sales and orders for the selected week and do not rewrite old receipt profit records.";
}

<style>
    .price-setup-page {
        --price-line: #e8e8e8;
        --price-text: #0a0a0a;
        --price-muted: #888888;
        --price-soft: #f7f7f7;
        font-family: 'DM Sans', sans-serif;
        color: var(--price-text);
    }
    .price-setup-shell {
        max-width: 1180px;
        margin: 0 auto;
    }
    .price-setup-kicker,
    .price-table-toolbar-label,
    .price-field-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--price-muted);
    }
    .price-setup-headline {
        border-bottom: 1px solid var(--price-line);
        padding-bottom: 1.25rem;
        margin-bottom: 2rem;
    }
    .price-setup-title {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--price-text);
    }
    .price-setup-sub {
        margin: 0.25rem 0 0;
        color: var(--price-muted);
    }
    .price-week-label {
        color: var(--price-text);
        font-weight: 500;
    }
    .price-btn {
        border-radius: var(--ui-radius-xl);
        font-weight: 500;
        border-width: 1px;
        box-shadow: none !important;
    }
    .price-btn-neutral {
        border-color: var(--price-line);
        color: var(--price-text);
        background: #ffffff;
    }
    .price-btn-primary {
        border-color: #0a0a0a;
        background: #0a0a0a;
        color: #ffffff;
    }
    .price-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }
    .price-control-row {
        display: grid;
        grid-template-columns: minmax(220px, 280px) 1fr;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: 1.75rem;
    }
    .price-date-form,
    .price-master-toggle {
        background: #ffffff;
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        padding: 1rem 1.1rem;
    }
    .price-date-form label {
        display: block;
        margin-bottom: 0.55rem;
    }
    .price-date-form input[type="date"] {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        font-weight: 500;
        min-height: 48px;
    }
    .price-card {
        border: 1px solid var(--price-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        overflow: hidden;
    }
    .price-master-toggle {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }
    .price-master-toggle .form-check {
        margin: 0;
    }
    .price-master-toggle .form-check-label {
        font-size: 15px;
        font-weight: 500;
        color: var(--price-text);
    }
    .price-master-toggle-note {
        margin: 0.4rem 0 0;
        color: var(--price-muted);
        font-size: 14px;
        line-height: 1.5;
    }
    .price-table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--price-line);
        background: #ffffff;
    }
    .price-table-toolbar-copy {
        min-width: min(100%, 540px);
    }
    .price-table-toolbar-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--price-muted);
    }
    .price-table-toolbar-title {
        margin: 0.45rem 0 0;
        font-size: 16px;
        font-weight: 600;
        color: var(--price-text);
    }
    .price-table-toolbar-sub {
        margin: 0.35rem 0 0;
        color: var(--price-muted);
        font-size: 14px;
        line-height: 1.6;
    }
    .price-save-btn {
        min-width: 180px;
        min-height: 46px;
        padding-inline: 1.15rem;
    }
    .price-feedback {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--price-line);
        font-size: 14px;
    }
    .price-feedback-success {
        background: #fbfbfb;
        color: #111111;
    }
    .price-feedback-error {
        background: #fff8f8;
        color: #8b1e1e;
    }
    .price-feedback.is-hidden {
        display: none;
    }
    .price-table-wrap {
        max-height: 70vh;
        overflow: auto;
        scroll-margin-top: 110px;
    }
    .price-table {
        margin: 0;
    }
    .price-table thead th {
        background: #ffffff;
        color: var(--price-muted);
        font-family: 'DM Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 9px;
        font-weight: 500;
        border-bottom: 1px solid var(--price-line);
    }
    .price-table tbody tr:hover {
        background: #fafafa;
    }
    .price-table .row-edited td {
        background: #fafafa !important;
    }
    .price-product-name {
        font-weight: 500;
        color: var(--price-text);
    }
    .price-unit {
        color: var(--price-muted);
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .price-input {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        font-weight: 500;
        box-shadow: none;
        min-height: 44px;
    }
    .price-input:focus {
        border-color: #d4d4d4;
        box-shadow: none;
    }
    .price-value {
        color: var(--price-text);
    }
    .price-delivery-input {
        border-radius: var(--ui-radius-md);
        border: 1px solid var(--price-line);
        background: #ffffff;
        color: var(--price-text);
        font-weight: 500;
        min-height: 44px;
    }
    .price-reset-btn {
        border-radius: var(--ui-radius-md);
        font-weight: 500;
    }
    .price-row-save-btn {
        border-radius: var(--ui-radius-md);
        font-weight: 500;
        min-width: 92px;
    }
    .price-row-save-btn.is-saving {
        opacity: 0.7;
        pointer-events: none;
    }
    .price-status {
        border-radius: 999px;
        font-family: 'DM Mono', monospace;
        font-weight: 500;
        font-size: 10px;
        padding: 0.3rem 0.65rem;
    }
    .price-status-weekly {
        background: #ffffff;
        color: var(--price-text);
        border: 1px solid var(--price-line);
    }
    .price-status-default {
        background: #ffffff;
        color: var(--price-muted);
        border: 1px solid var(--price-line);
    }
    .price-saved-row td {
        background: #f8f8f8 !important;
        transition: background-color 0.25s ease;
    }
    @@media (max-width: 768px) {
        .price-setup-header,
        .price-table-toolbar,
        .price-control-row {
            align-items: flex-start !important;
        }
        .price-control-row {
            grid-template-columns: 1fr;
        }
        .price-save-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid p-4 price-setup-page">
    <div class="price-setup-shell">
    <div class="price-setup-header d-flex justify-content-between align-items-center price-setup-headline">
        <div>
            <div class="price-setup-kicker">Finance / Weekly Pricing</div>
            <h2 class="price-setup-title">Price Versus Setup</h2>
            <p class="price-setup-sub">
                Original Price vs Selling Price for Week: 
                <span class="price-week-label">@Model.WeekStart.ToString("MMM dd") - @Model.WeekEnd.ToString("MMM dd, yyyy")</span>
            </p>
        </div>
        <div class="price-actions">
            <a asp-controller="Orders" asp-action="VegetableMatrix" class="btn price-btn price-btn-neutral">
                <i class="bi bi-arrow-left"></i> Back to Matrix
            </a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="price-control-row">
        <form method="get" class="price-date-form">
            <label class="price-field-label">View Prices For Date</label>
            <input type="date" name="date" class="form-control" value="@Model.TargetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </form>
        <div class="price-master-toggle">
            <div>
                <div class="price-field-label">Save Mode</div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="ApplyToMasterCost" form="versusForm" />
                    <label class="form-check-label" asp-for="ApplyToMasterCost" form="versusForm">
                        Apply cost changes to master product cost
                    </label>
                </div>
                <p class="price-master-toggle-note">Leave this off if cost edits should apply only to the selected week.</p>
            </div>
        </div>
    </div>

    <div class="card price-card">
        <div class="card-body p-0">
            <form method="post" id="versusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TargetDate" />

                <div asp-validation-summary="All" class="text-danger px-4 pt-3"></div>

                @{
                    var successMessage = TempData["SuccessMessage"] as string;
                    var errorMessage = TempData["ErrorMessage"] as string;
                    var feedbackMessage = !string.IsNullOrWhiteSpace(errorMessage) ? errorMessage : successMessage;
                    var feedbackClass = !string.IsNullOrWhiteSpace(errorMessage) ? "price-feedback-error" : "price-feedback-success";
                    var feedbackHiddenClass = string.IsNullOrWhiteSpace(feedbackMessage) ? "is-hidden" : string.Empty;
                }
                <div class="price-feedback @feedbackClass @feedbackHiddenClass" id="priceFeedback">@feedbackMessage</div>

                <div class="price-table-toolbar" id="priceTableAnchor">
                    <div class="price-table-toolbar-copy">
                        <div class="price-table-toolbar-label">Table Actions</div>
                        <h3 class="price-table-toolbar-title">Save changes without losing your place.</h3>
                        <p class="price-table-toolbar-sub">Use Save Changes for the full table, or Save Row for one product. After saving, the page restores you to this pricing area so work stays smooth.</p>
                    </div>
                    <button type="submit" class="btn price-btn price-btn-primary price-save-btn">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
                
                <div class="table-responsive price-table-wrap" id="priceTableWrap">
                    <table class="table table-hover align-middle price-table" id="priceTable">
                        <thead class="sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th class="ps-4 py-3">Product Name</th>
                                <th class="py-3">Unit</th>
                                <th class="text-end py-3" style="width: 140px;">Original Price</th>
                                <th class="text-end py-3" style="width: 140px;">Markup (Added)</th>
                                <th class="text-end py-3" style="width: 140px;">Base Price</th>
                                <th class="text-end py-3" style="width: 140px;">Delivery Price</th>
                                <th class="text-center py-3" style="width: 110px;">Save</th>
                                <th class="text-center py-3" style="width: 90px;">Reset</th>
                                <th class="text-center py-3" style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr class="item-row"
                                    data-product-id="@item.ProductId"
                                    data-master-cost="@item.MasterCost.ToString("0.00")"
                                    data-master-markup="@item.MasterMarkup.ToString("0.00")"
                                    data-delivery-fee="@((item.DeliveryFee ?? item.MasterDeliveryFee).ToString("0.00"))">
                                    <td class="ps-4 price-product-name">
                                        @item.ProductName
                                        <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                        <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                    </td>
                                    <td class="price-unit">@item.Unit</td>
                                    
                                    <td class="text-end">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light border-0">₱</span>
                                            <input type="number" step="0.01" min="0"
                                                   name="Items[@i].Cost"
                                                   class="form-control text-end cost-input price-input"
                                                   value="@item.Cost.ToString("0.00")" />
                                        </div>
                                    </td>
                                    
                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].Markup"
                                               class="form-control text-end markup-input price-input"
                                               value="@item.Markup.ToString("0.00")" />
                                    </td>

                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].BasePrice"
                                               class="form-control text-end base-price-input price-input price-value"
                                               value="@(item.BasePrice.ToString("0.00"))" />
                                    </td>

                                    <td class="text-end">
                                        <input type="number" step="0.01" min="0"
                                               name="Items[@i].DeliveryPrice"
                                               class="form-control text-end delivery-price-input price-delivery-input"
                                               value="@item.DeliveryPrice.ToString("0.00")" />
                                        <input type="hidden" name="Items[@i].DeliveryFee" value="@((item.DeliveryFee ?? item.MasterDeliveryFee).ToString("0.00"))" class="delivery-fee-hidden" />
                                    </td>

                                    <td class="text-center">
                                        <button type="submit"
                                                name="singleProductId"
                                                value="@item.ProductId"
                                                class="btn btn-sm price-btn price-btn-primary price-row-save-btn">
                                            Save Row
                                        </button>
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-secondary price-reset-btn reset-cost-btn">Reset</button>
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (item.HasWeeklyRecord)
                                        {
                                            <span class="badge price-status price-status-weekly">Weekly</span>
                                        }
                                        else
                                        {
                                            <span class="badge price-status price-status-default">Default</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const table = document.getElementById('priceTable');
        const versusForm = document.getElementById('versusForm');
        const tableWrap = document.getElementById('priceTableWrap');
        const tableAnchor = document.getElementById('priceTableAnchor');
        const feedback = document.getElementById('priceFeedback');
        const scrollKey = 'priceVersus:windowScroll';
        const tableScrollKey = 'priceVersus:tableScroll';
        const savedRowKey = 'priceVersus:savedRow';
        const restoreFlagKey = 'priceVersus:restoreAfterSave';

        const parseNumber = (value) => {
            if (!value) return 0;
            return parseFloat(value.toString().replace(',', '.')) || 0;
        };

        const saveScrollState = (productId) => {
            sessionStorage.setItem(scrollKey, String(window.scrollY || 0));
            if (tableWrap) {
                sessionStorage.setItem(tableScrollKey, String(tableWrap.scrollTop || 0));
            }
            if (productId) {
                sessionStorage.setItem(savedRowKey, String(productId));
            } else {
                sessionStorage.removeItem(savedRowKey);
            }
            sessionStorage.setItem(restoreFlagKey, 'true');
        };

        const restoreScrollState = () => {
            if (sessionStorage.getItem(restoreFlagKey) !== 'true') return;

            const windowScroll = parseInt(sessionStorage.getItem(scrollKey) || '', 10);
            const tableScroll = parseInt(sessionStorage.getItem(tableScrollKey) || '', 10);
            const savedRowId = sessionStorage.getItem(savedRowKey);

            requestAnimationFrame(() => {
                if (!Number.isNaN(windowScroll)) {
                    window.scrollTo({ top: windowScroll, behavior: 'instant' });
                } else if (tableAnchor) {
                    tableAnchor.scrollIntoView({ block: 'start' });
                }

                if (tableWrap && !Number.isNaN(tableScroll)) {
                    tableWrap.scrollTop = tableScroll;
                }

                if (savedRowId) {
                    const savedRow = table?.querySelector(`tr[data-product-id="${savedRowId}"]`);
                    if (savedRow) {
                        savedRow.classList.add('price-saved-row');
                    }
                }

                sessionStorage.removeItem(scrollKey);
                sessionStorage.removeItem(tableScrollKey);
                sessionStorage.removeItem(savedRowKey);
                sessionStorage.removeItem(restoreFlagKey);
            });
        };

        restoreScrollState();

        const showFeedback = (message, isError) => {
            if (!feedback) return;
            feedback.textContent = message;
            feedback.className = `price-feedback ${isError ? 'price-feedback-error' : 'price-feedback-success'}`;
        };

        const applySavedRowState = (row, item) => {
            row.dataset.masterCost = item.masterCost;
            row.dataset.masterMarkup = item.masterMarkup;
            row.dataset.deliveryFee = item.deliveryFee;

            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');
            const basePriceInput = row.querySelector('.base-price-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            const status = row.querySelector('.price-status');

            if (costInput) costInput.value = item.cost;
            if (markupInput) markupInput.value = item.markup;
            if (basePriceInput) basePriceInput.value = item.basePrice;
            if (deliveryPriceInput) deliveryPriceInput.value = item.deliveryPrice;
            if (hiddenDeliveryFee) hiddenDeliveryFee.value = item.deliveryFee;

            if (status) {
                status.textContent = item.hasWeeklyRecord ? 'Weekly' : 'Default';
                status.classList.toggle('price-status-weekly', item.hasWeeklyRecord);
                status.classList.toggle('price-status-default', !item.hasWeeklyRecord);
            }

            row.classList.remove('row-edited');
            row.classList.add('price-saved-row');
        };

        const submitSingleRow = async (row, productId, button) => {
            if (!versusForm) return;

            const formData = new FormData();
            const antiForgery = versusForm.querySelector('input[name="__RequestVerificationToken"]');
            const targetDate = versusForm.querySelector('input[name="TargetDate"]');
            const applyToMaster = versusForm.querySelector('input[name="ApplyToMasterCost"]');

            if (antiForgery) {
                formData.append('__RequestVerificationToken', antiForgery.value);
            }
            if (targetDate) {
                formData.append('TargetDate', targetDate.value);
            }

            formData.append('ApplyToMasterCost', applyToMaster && applyToMaster.checked ? 'true' : 'false');
            formData.append('singleProductId', productId);

            const rowInputs = row.querySelectorAll('input[name], select[name], textarea[name]');
            rowInputs.forEach((source) => {
                formData.append(source.name.replace(/Items\[\d+\]/, 'Items[0]'), source.value);
            });

            const originalText = button ? button.innerHTML : '';
            if (button) {
                button.classList.add('is-saving');
                button.innerHTML = 'Saving...';
            }

            try {
                const response = await fetch('@Url.Action("SavePriceRow", "WeeklyPrices")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json().catch(() => ({ success: false, message: 'The server returned an unexpected response.' }));
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Unable to save the selected product price.');
                }

                applySavedRowState(row, result.item);
                showFeedback(result.message, false);
            } catch (error) {
                showFeedback(error.message || 'Unable to save the selected product price.', true);
            } finally {
                if (button) {
                    button.classList.remove('is-saving');
                    button.innerHTML = originalText;
                }
            }
        };

        const updateRowFromCostMarkup = (row) => {
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');

            const cost = parseNumber(costInput?.value);
            const markup = parseNumber(markupInput?.value);
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            const basePrice = cost + markup;
            const currentDeliveryPrice = parseNumber(deliveryPriceInput?.value);
            const deliveryFee = hiddenDeliveryFee ? parseNumber(hiddenDeliveryFee.value) : parseNumber(row.dataset.deliveryFee);
            const deliveryPrice = currentDeliveryPrice > 0 ? currentDeliveryPrice : basePrice + deliveryFee;

            const basePriceInput = row.querySelector('.base-price-input');
            if (basePriceInput) basePriceInput.value = basePrice.toFixed(2);

            if (deliveryPriceInput) deliveryPriceInput.value = deliveryPrice.toFixed(2);
            if (hiddenDeliveryFee) hiddenDeliveryFee.value = (deliveryPrice - basePrice).toFixed(2);

            row.classList.add('row-edited');
        };

        const updateRowFromBasePrice = (row) => {
            const costInput = row.querySelector('.cost-input');
            const basePriceInput = row.querySelector('.base-price-input');
            const markupInput = row.querySelector('.markup-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');

            const cost = parseNumber(costInput?.value);
            const basePrice = parseNumber(basePriceInput?.value);
            const deliveryPrice = parseNumber(deliveryPriceInput?.value);
            const markup = basePrice - cost;

            if (markupInput) markupInput.value = markup.toFixed(2);
            if (deliveryPriceInput && deliveryPriceInput.value.trim() === '') {
                deliveryPriceInput.value = basePrice.toFixed(2);
            }
            if (hiddenDeliveryFee) {
                hiddenDeliveryFee.value = (parseNumber(deliveryPriceInput?.value) - basePrice).toFixed(2);
            }

            row.classList.add('row-edited');
        };

        const updateRowFromDeliveryPrice = (row) => {
            const basePriceInput = row.querySelector('.base-price-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            const basePrice = parseNumber(basePriceInput?.value);
            const deliveryPrice = parseNumber(deliveryPriceInput?.value);

            if (hiddenDeliveryFee) {
                hiddenDeliveryFee.value = Math.max(deliveryPrice - basePrice, 0).toFixed(2);
            }

            row.classList.add('row-edited');
        };

        table.addEventListener('input', function(e) {
            if (e.target.classList.contains('markup-input') || 
                e.target.classList.contains('cost-input')) {
                const row = e.target.closest('tr');
                updateRowFromCostMarkup(row);
            }
            if (e.target.classList.contains('base-price-input')) {
                const row = e.target.closest('tr');
                updateRowFromBasePrice(row);
            }
            if (e.target.classList.contains('delivery-price-input')) {
                const row = e.target.closest('tr');
                updateRowFromDeliveryPrice(row);
            }
        });

        table.addEventListener('click', function(e) {
            const saveBtn = e.target.closest('.price-row-save-btn');
            if (saveBtn) {
                e.preventDefault();
                const row = saveBtn.closest('tr');
                const productId = saveBtn.value;
                if (row && productId) {
                    submitSingleRow(row, productId, saveBtn);
                }
                return;
            }

            const btn = e.target.closest('.reset-cost-btn');
            if (!btn) return;

            const row = btn.closest('tr');
            const masterCost = parseNumber(row.dataset.masterCost);
            const masterMarkup = parseNumber(row.dataset.masterMarkup);
            const masterDeliveryFee = parseNumber(row.dataset.deliveryFee);
            const costInput = row.querySelector('.cost-input');
            const markupInput = row.querySelector('.markup-input');
            const deliveryPriceInput = row.querySelector('.delivery-price-input');
            const hiddenDeliveryFee = row.querySelector('.delivery-fee-hidden');
            if (costInput) costInput.value = masterCost.toFixed(2);
            if (markupInput) markupInput.value = masterMarkup.toFixed(2);
            if (deliveryPriceInput) deliveryPriceInput.value = (masterCost + masterMarkup + masterDeliveryFee).toFixed(2);
            if (hiddenDeliveryFee) hiddenDeliveryFee.value = masterDeliveryFee.toFixed(2);

            updateRowFromCostMarkup(row);
        });

        versusForm.addEventListener('submit', function() {
            saveScrollState(null);
        });
    });
</script>
