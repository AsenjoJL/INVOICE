@model IEnumerable<HazelInvoice.Models.WeeklyPrice>

@{
    ViewData["Title"] = "Weekly Prices";
    ViewData["NotePurpose"] = "Review weekly price records and effective dates.";
    ViewData["NoteInstructions"] = "Use Copy Last Week or Set Price to add a new week.";
}

<partial name="_WeeklyPriceStyles" />

<div class="container-fluid p-4 weekly-page">
    <div class="weekly-header">
        <div>
            <h1>Weekly Price List</h1>
            <p class="weekly-sub">Review weekly price records and effective dates.</p>
        </div>
        <div>
            <a asp-action="CloneLastWeek" class="btn weekly-btn weekly-btn-neutral me-2"><i class="bi bi-copy"></i> Copy Last Week</a>
            <a asp-action="Create" class="btn weekly-btn weekly-btn-primary"><i class="bi bi-plus-lg"></i> Set Price</a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="mb-4">
        <form method="get" class="d-flex align-items-end gap-3" style="max-width: 300px;">
            <div class="flex-grow-1">
                @{
                    var clientGroupOptions = (ViewBag.ClientGroupOptions as List<HazelInvoice.Models.ClientGroup>) ?? new List<HazelInvoice.Models.ClientGroup>();
                    var selectedGroupId = ViewBag.ClientGroupId as int?;
                }
                <label class="form-label text-muted small fw-bold mb-1">Filter by Client Group</label>
                <select name="clientGroupId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Groups --</option>
                    @foreach (var g in clientGroupOptions)
                    {
                        if (selectedGroupId == g.Id)
                        {
                            <option value="@g.Id" selected>@g.Name</option>
                        }
                        else
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>

    <div class="card weekly-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle weekly-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Effective Date</th>
                            <th>Base Price (Walk-in)</th>
                            <th>Delivery Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isActive = DateTime.Now >= item.EffectiveFrom && DateTime.Now <= item.EffectiveTo;
                            <tr class="@(isActive ? "weekly-row-active" : "")">
                                <td class="weekly-name">@item.Product?.Name</td>
                                <td>
                                    @item.EffectiveFrom.ToString("MMM dd") - @item.EffectiveTo.ToString("MMM dd, yyyy")
                                </td>
                                <td class="weekly-money">@item.BasePrice.ToString("C")</td>
                                <td class="weekly-money">@item.DeliveryPrice.ToString("C")</td>
                                <td>
                                    @if(isActive) { <span class="weekly-status weekly-status-active">Active</span> }
                                    else if(DateTime.Now > item.EffectiveTo) { <span class="weekly-status weekly-status-expired">Expired</span> }
                                    else { <span class="weekly-status weekly-status-upcoming">Upcoming</span> }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm weekly-btn weekly-btn-neutral"><i class="bi bi-pencil"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
