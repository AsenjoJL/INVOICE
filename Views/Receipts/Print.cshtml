@model HazelInvoice.Models.Receipt

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delivery Receipt - @Model.ReceiptNumber</title>
    <style>
        :root {
            --ink: #111827;
            --muted: #4b5563;
            --line: #1f2937;
            --accent: #b91c1c;
        }

        * { box-sizing: border-box; }

        body.receipt-body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            margin: 0;
            padding: 20px;
            background: #fff;
            font-size: 14px;
        }

        .toolbar {
            max-width: 820px;
            margin: 0 auto 16px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            background: #fff;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            color: #111827;
        }

        .btn-primary {
            background: #111827;
            color: #fff;
            border-color: #111827;
        }

        .receipt-container {
            width: 820px;
            margin: 0 auto;
        }

        .header-top {
            display: grid;
            grid-template-columns: 90px 1fr 160px;
            align-items: center;
            gap: 10px;
        }

        .logo-box {
            width: 90px;
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
        }

        .logo-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: transparent;
            mix-blend-mode: multiply;
        }

        .company {
            text-align: center;
            line-height: 1.2;
        }

        .company-name {
            font-weight: 900;
            font-size: 18px;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        .company-meta {
            font-size: 12.5px;
            color: var(--muted);
        }

        .receipt-meta {
            text-align: right;
            font-size: 14px;
        }

        .receipt-meta .no {
            font-weight: 800;
        }

        .receipt-meta .no-value {
            color: var(--accent);
            font-weight: 800;
            font-size: 18px;
            margin-left: 6px;
            letter-spacing: 1px;
        }

        .receipt-meta .date-line {
            margin-top: 6px;
            display: inline-block;
            min-width: 120px;
            border-bottom: 1px solid var(--line);
            padding-left: 6px;
            font-weight: 700;
        }

        .title-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin: 14px 0 6px;
        }

        .doc-title {
            font-size: 20px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .info-line {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            margin: 4px 0;
        }

        .info-label {
            white-space: nowrap;
        }

        .info-value {
            border-bottom: 1px solid var(--line);
            flex: 1;
            padding-left: 8px;
            font-weight: 700;
            min-height: 20px;
        }

        .info-value.short {
            flex: 0 0 200px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            border: 1.5px solid var(--line);
        }

        .items-table th,
        .items-table td {
            border: 1px solid var(--line);
            padding: 6px 8px;
            height: 26px;
        }

        .items-table th {
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            text-align: center;
            background: #f3f4f6;
        }

        .col-qty { width: 8%; text-align: center; }
        .col-unit { width: 10%; text-align: center; }
        .col-part { width: 50%; }
        .col-price { width: 16%; text-align: right; }
        .col-amount { width: 16%; text-align: right; }

        .total-row td {
            font-weight: 800;
            text-transform: uppercase;
            text-align: center;
        }

        .total-row .amount {
            text-align: right;
            font-size: 15px;
        }

        .footer-note {
            margin-top: 12px;
            text-align: center;
            font-size: 13px;
        }

        .received-line {
            margin-top: 18px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 10px;
        }

        .received-input {
            border-bottom: 1px solid var(--line);
            width: 260px;
        }

        @@media print {
            @@page { size: letter; margin: 6mm; }
            body.receipt-body { padding: 0; margin: 0; }
            .toolbar { display: none !important; }
            .receipt-container { width: 100%; }
            .items-table th { -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body class="receipt-body">
    <div class="toolbar no-print">
        <strong>Delivery Receipt</strong>
        <div>
            <button class="btn btn-primary" onclick="window.print()">Print</button>
            <a class="btn" href="/Receipts">Back to List</a>
        </div>
    </div>

    <div class="receipt-container">
        <div class="header-top">
            <div class="logo-box">
                <img src="/images/logo.jpg" alt="Logo" />
            </div>
            <div class="company">
                <div class="company-name">Healthy Harvest Vegetable Trading</div>
                <div class="company-meta">
                    Plaridel St., Brgy. Ermita, Cebu City<br />
                    Contact#: 0969-2044656 • 0966-0861132<br />
                    Prop.: Ma. Hazel M. Calvo
                </div>
            </div>
            <div class="receipt-meta">
                <div class="no">No.<span class="no-value">@Model.ReceiptNumber</span></div>
                <div>Date: <span class="date-line">@Model.Date.ToString("MM/dd/yy")</span></div>
            </div>
        </div>

        <div class="title-row">
            <div class="doc-title">Delivery Receipt</div>
        </div>

        <div class="info-line">
            <div class="info-label">Delivered to:</div>
            <div class="info-value">@Model.CustomerName</div>
        </div>
        <div class="info-line">
            <div class="info-label">Address:</div>
            <div class="info-value">@Model.CustomerAddress</div>
            <div class="info-label">Contact:</div>
            <div class="info-value short">@Model.ContactNumber</div>
        </div>

        <table class="items-table">
            <thead>
                <tr>
                    <th class="col-qty">Qty.</th>
                    <th class="col-unit">Unit</th>
                    <th class="col-part">Particulars</th>
                    <th class="col-price">Price</th>
                    <th class="col-amount">Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int maxRows = 18;
                    int count = 0;
                }
                @foreach (var item in Model.Lines)
                {
                    <tr>
                        <td class="col-qty">@item.Quantity</td>
                        <td class="col-unit">@item.Unit</td>
                        <td class="col-part">@item.ItemName</td>
                        <td class="col-price">@item.Price.ToString("N2")</td>
                        <td class="col-amount">@item.Amount.ToString("N2")</td>
                    </tr>
                    count++;
                }
                @for (int i = count; i < maxRows; i++)
                {
                    <tr>
                        <td class="col-qty">&nbsp;</td>
                        <td class="col-unit">&nbsp;</td>
                        <td class="col-part">&nbsp;</td>
                        <td class="col-price">&nbsp;</td>
                        <td class="col-amount">&nbsp;</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td colspan="3">Total Amount Due</td>
                    <td></td>
                    <td class="col-amount amount">@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <div class="footer-note">
            Received the above merchandise in good order condition.
        </div>
        <div class="received-line">
            <div>Received By:</div>
            <div class="received-input"></div>
        </div>
    </div>

    <script>
        window.onload = () => {
            setTimeout(() => {
                window.print();
            }, 800);
        };
    </script>
</body>
</html>
