@model HazelInvoice.Models.Receipt
@inject Microsoft.Extensions.Options.IOptions<HazelInvoice.Configuration.FeaturesOptions> Features

@{
    ViewData["Title"] = "Receipt Details";
    var partners = ViewBag.Partners as List<string> ?? new List<string>();
    var partnersEnabled = Features.Value.PartnersEnabled;

    string StatusClass(HazelInvoice.Models.PaymentStatus status) => status switch
    {
        HazelInvoice.Models.PaymentStatus.Paid => "status-pill status-paid",
        HazelInvoice.Models.PaymentStatus.Partial => "status-pill status-partial",
        HazelInvoice.Models.PaymentStatus.Unpaid => "status-pill status-unpaid",
        HazelInvoice.Models.PaymentStatus.Void => "status-pill status-void",
        _ => "status-pill"
    };
}

<div class="container-fluid p-4 invoice-ui invoice-ui-min">
    <div class="invoice-hero invoice-hero-plain">
        <div>
            <h1 class="invoice-title">Receipt @Model.ReceiptNumber</h1>
            <p class="invoice-sub">Created @Model.Date.ToString("MMM dd, yyyy h:mm tt")</p>
        </div>
        <div class="invoice-actions">
            <a asp-action="Print" asp-route-id="@Model.Id" class="invoice-btn invoice-btn-primary"><i class="bi bi-printer"></i> Print</a>
            <a asp-action="Index" class="invoice-btn invoice-btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="invoice-card mb-3">
        <div class="invoice-card-header">
            <h6 class="invoice-card-title">Customer Info</h6>
            <span class="@StatusClass(Model.Status)">@Model.Status</span>
        </div>
        <div class="invoice-card-body">
            <div class="row g-3">
                <div class="col-md-4 invoice-field">
                    <div class="form-label">Customer</div>
                    <div class="fw-bold">@Model.CustomerName</div>
                    <div class="text-muted small">@Model.CustomerAddress</div>
                </div>
                <div class="col-md-4 invoice-field">
                    <div class="form-label">Contact</div>
                    <div class="fw-bold">@Model.ContactNumber</div>
                </div>
                <div class="col-md-4 invoice-field">
                    <div class="form-label">Receipt Type</div>
                    <div class="fw-bold">@Model.Type</div>
                </div>
            </div>
        </div>
    </div>

    <div class="invoice-card">
        <div class="invoice-card-header">
            <h6 class="invoice-card-title">Line Items</h6>
            <span class="invoice-tag"><i class="bi bi-box-seam"></i> @Model.Lines.Count Items</span>
        </div>
        <div class="invoice-card-body p-0">
            <div class="table-responsive">
                <table class="invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-center">Qty</th>
                            <th class="text-center">Unit</th>
                            @if (partnersEnabled)
                            {
                                <th class="text-center">Owner</th>
                            }
                            <th class="text-end">Price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="fw-bold">@line.ItemName</td>
                                <td class="text-center">@line.Quantity.ToString("0.###")</td>
                                <td class="text-center">@line.Unit</td>
                                @if (partnersEnabled)
                                {
                                    <td class="text-center">
                                        <span class="fw-bold">@(string.IsNullOrWhiteSpace(line.PartnerName) ? "-" : line.PartnerName)</span>
                                    </td>
                                }
                                <td class="text-end">@line.Price.ToString("N2")</td>
                                <td class="text-end fw-bold">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="@(partnersEnabled ? 5 : 4)" class="text-end fw-bold">Total</td>
                            <td class="text-end fw-bold invoice-summary-total">₱@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="@(partnersEnabled ? 5 : 4)" class="text-end fw-bold">Paid</td>
                            <td class="text-end fw-bold text-success">₱@Model.PaidAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
