@using HazelInvoice.Helpers
@model HazelInvoice.ViewModels.ReceiptsIndexViewModel

@{
    ViewData["Title"] = "Receipts";
    var titleHeader = (ViewData["TitleHeader"] as string) ?? "Receipts & Deliveries";
    var isSalesView = string.Equals(ViewData["ViewMode"] as string, "sales", StringComparison.OrdinalIgnoreCase);
    var nextDeliveryDate = BusinessDate.Tomorrow().ToString("yyyy-MM-dd");
    var receiptCount = Model?.TotalCount ?? 0;
    var currentPage = Model?.Page ?? 1;
    var pageSize = Model?.PageSize ?? 50;
    var query = Model?.Query ?? string.Empty;
    var selectedDate = Model?.Date?.ToString("yyyy-MM-dd") ?? string.Empty;
    var selectedDateFrom = Model?.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
    var selectedDateTo = Model?.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var totalPages = pageSize <= 0 ? 1 : (int)Math.Ceiling(receiptCount / (double)pageSize);
    if (totalPages < 1) totalPages = 1;
    var startRow = receiptCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endRow = Math.Min(receiptCount, currentPage * pageSize);
    var isUnpaid = Model?.UnpaidOnly ?? false;

    string StatusClass(HazelInvoice.Models.PaymentStatus status) => status switch
    {
        HazelInvoice.Models.PaymentStatus.Paid => "status-pill status-paid",
        HazelInvoice.Models.PaymentStatus.Partial => "status-pill status-partial",
        HazelInvoice.Models.PaymentStatus.Unpaid => "status-pill status-unpaid",
        HazelInvoice.Models.PaymentStatus.Void => "status-pill status-void",
        _ => "status-pill"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/receipts-refresh.css" asp-append-version="true" />
}

<style>
    .invoice-table tbody tr.receipt-row-highlight td {
        background: rgba(59, 130, 246, 0.08);
        transition: background-color 0.2s ease;
    }
</style>

<div class="container-fluid p-4 invoice-ui invoice-ui-min admin-page-flow receipts-refresh">
    <div class="invoice-hero invoice-hero-plain admin-page-hero">
        <div>
            <span class="admin-section-kicker">Sales Ledger</span>
            <h1 class="invoice-title">@titleHeader</h1>
            <p class="invoice-sub">@(isSalesView
                ? "Track sales totals, payment status, and outlet activity at a glance."
                : "Track delivery receipts, payment status, and totals at a glance.")</p>
            @if (Model?.Date != null)
            {
                <div class="small fw-bold mt-2">Viewing date: @Model.Date.Value.ToString("MMM dd, yyyy")</div>
            }
            else if (Model?.DateFrom != null || Model?.DateTo != null)
            {
                <div class="small fw-bold mt-2">
                    Viewing range:
                    @(Model?.DateFrom?.ToString("MMM dd, yyyy") ?? "Start")
                    -
                    @(Model?.DateTo?.ToString("MMM dd, yyyy") ?? "End")
                </div>
            }
            <div class="small fw-bold mt-2">
                Showing @startRow-@endRow of @receiptCount
                @if (isUnpaid)
                {
                    <span>(Unpaid)</span>
                }
            </div>
        </div>
        <div class="invoice-actions">
            <a asp-action="Create" asp-route-date="@nextDeliveryDate" class="invoice-btn invoice-btn-primary"><i class="bi bi-plus-lg"></i> New Receipt</a>
            <a asp-controller="Orders" asp-action="ReceiptList" class="invoice-btn invoice-btn-ghost"><i class="bi bi-list-check"></i> Receipt List</a>
        </div>
    </div>

    <section class="receipts-summary-strip">
        <article class="receipts-summary-card">
            <span class="receipts-summary-label">Visible Rows</span>
            <strong>@receiptCount.ToString("N0")</strong>
            <small>@(isSalesView ? "Sales records in this result" : "Receipts in this result")</small>
        </article>
        <article class="receipts-summary-card">
            <span class="receipts-summary-label">Current Page</span>
            <strong>@currentPage</strong>
            <small>Page @currentPage of @totalPages</small>
        </article>
        <article class="receipts-summary-card">
            <span class="receipts-summary-label">Page Size</span>
            <strong>@pageSize</strong>
            <small>Rows per page</small>
        </article>
        <article class="receipts-summary-card">
            <span class="receipts-summary-label">Scope</span>
            <strong>@(isUnpaid ? "Unpaid" : "All")</strong>
            <small>@(isSalesView ? "Sales mode" : "Receipt mode")</small>
        </article>
    </section>

    @if (TempData["Message"] is string message && !string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success mb-3">@message</div>
    }

    <div class="invoice-card admin-surface-card">
        <div class="invoice-card-header">
            <h6 class="invoice-card-title">@(isSalesView ? "All Sales" : "All Receipts")</h6>
            <form method="get" class="admin-inline-filter">
                @if (isSalesView)
                {
                    <input type="hidden" name="viewMode" value="sales" />
                }
                <input class="form-control form-control-sm" name="q" id="q" value="@query" placeholder="Search receipt # or outlet" style="min-width: 240px;" />
                <input class="form-control form-control-sm" type="date" name="date" value="@selectedDate" style="width: 170px;" />
                <input class="form-control form-control-sm" type="date" name="dateFrom" value="@selectedDateFrom" style="width: 170px;" />
                <input class="form-control form-control-sm" type="date" name="dateTo" value="@selectedDateTo" style="width: 170px;" />
                <select class="form-select form-select-sm" name="pageSize" id="pageSize" style="width: 110px;">
                    <option value="25" selected="@(pageSize == 25 ? "selected" : null)">25</option>
                    <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                    <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                    <option value="200" selected="@(pageSize == 200 ? "selected" : null)">200</option>
                </select>
                <button type="submit" class="invoice-btn invoice-btn-ghost">Search</button>
                @if (isUnpaid)
                {
                    <a class="invoice-btn invoice-btn-ghost" href="@Url.Action("Index", "Receipts", new { q = query, date = selectedDate, dateFrom = selectedDateFrom, dateTo = selectedDateTo, viewMode = isSalesView ? "sales" : null, pageSize = pageSize })">All</a>
                }
                else
                {
                    <a class="invoice-btn invoice-btn-ghost" href="@Url.Action("Unpaid", "Receipts", new { q = query, date = selectedDate, dateFrom = selectedDateFrom, dateTo = selectedDateTo, viewMode = isSalesView ? "sales" : null, pageSize = pageSize })">Unpaid</a>
                }
            </form>
        </div>
        <div class="invoice-card-body p-0">
            <div class="table-responsive">
                <table class="invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Receipt #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model?.Receipts ?? new List<HazelInvoice.ViewModels.ReceiptListItemViewModel>())
                        {
                            <tr class="receipt-row" data-id="@item.Id">
                                <td class="fw-bold">@item.ReceiptNumber</td>
                                <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                <td>@item.CustomerName</td>
                                <td>
                                    <span class="invoice-tag">@item.Type</span>
                                </td>
                                <td class="fw-bold text-end">@item.TotalAmount.ToString("N2")</td>
                                <td class="text-end">@item.PaidAmount.ToString("N2")</td>
                                <td>
                                    <span class="@StatusClass(item.Status)">@item.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Print"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="@returnUrl"
                                           class="invoice-icon-btn receipt-return-link"
                                           data-receipt-id="@item.Id"
                                           title="Print"><i class="bi bi-printer"></i></a>
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="@returnUrl"
                                           class="invoice-icon-btn receipt-return-link"
                                           data-receipt-id="@item.Id"
                                           title="View"><i class="bi bi-eye"></i></a>
                                        <form method="post"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              asp-route-returnUrl="@returnUrl"
                                              class="d-inline receipt-return-form"
                                              data-receipt-id="@item.Id">
                                            <button type="submit"
                                                    class="invoice-icon-btn text-danger"
                                                    title="Delete"
                                                    onclick="return confirm('Delete this receipt? This will update sales, profit, and stock totals.');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>

                                    @if (item.Status == HazelInvoice.Models.PaymentStatus.Unpaid)
                                    {
                                        <form method="post"
                                              asp-action="MarkAsPaid"
                                              asp-route-id="@item.Id"
                                              asp-route-returnUrl="@returnUrl"
                                              class="d-inline-block ms-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="invoice-btn invoice-btn-ghost"
                                                    onclick="return confirm('Mark this receipt as PAID?');">
                                                Mark Paid
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == HazelInvoice.Models.PaymentStatus.Paid)
                                    {
                                        <form method="post"
                                              asp-action="UndoPaid"
                                              asp-route-id="@item.Id"
                                              asp-route-returnUrl="@returnUrl"
                                              class="d-inline-block ms-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="invoice-btn invoice-btn-ghost"
                                                    onclick="return confirm('Return this receipt to UNPAID? This removes its recorded payments.');">
                                                Undo
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mt-3 admin-page-footerbar">
        <div class="small fw-bold">Page @currentPage of @totalPages</div>
        <div class="d-flex gap-2">
            @{
                var prevPage = Math.Max(1, currentPage - 1);
               var nextPage = Math.Min(totalPages, currentPage + 1);
                var action = isUnpaid ? "Unpaid" : "Index";
            }
            <a class="invoice-btn invoice-btn-ghost @(currentPage <= 1 ? "disabled" : "")"
               href="@Url.Action(action, "Receipts", new { q = query, date = selectedDate, dateFrom = selectedDateFrom, dateTo = selectedDateTo, viewMode = isSalesView ? "sales" : null, page = prevPage, pageSize = pageSize })">Prev</a>
            <a class="invoice-btn invoice-btn-ghost @(currentPage >= totalPages ? "disabled" : "")"
               href="@Url.Action(action, "Receipts", new { q = query, date = selectedDate, dateFrom = selectedDateFrom, dateTo = selectedDateTo, viewMode = isSalesView ? "sales" : null, page = nextPage, pageSize = pageSize })">Next</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/receipts-index.js" asp-append-version="true"></script>
}
