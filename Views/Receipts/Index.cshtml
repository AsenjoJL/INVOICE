@model IEnumerable<HazelInvoice.Models.Receipt>

@{
    ViewData["Title"] = "Receipts";
    ViewData["NotePurpose"] = "View all receipts and delivery records with payment status.";
    ViewData["NoteInstructions"] = "Use View or Print for details, or click New Receipt to create a sale.";
    
    string StatusClass(HazelInvoice.Models.PaymentStatus status) => status switch
    {
        HazelInvoice.Models.PaymentStatus.Paid => "status-pill status-paid",
        HazelInvoice.Models.PaymentStatus.Partial => "status-pill status-partial",
        HazelInvoice.Models.PaymentStatus.Unpaid => "status-pill status-unpaid",
        HazelInvoice.Models.PaymentStatus.Void => "status-pill status-void",
        _ => "status-pill"
    };
}

<div class="container-fluid p-4 invoice-ui">
    <div class="invoice-hero">
        <div>
            <div class="invoice-kicker"><i class="bi bi-receipt"></i> Restaurant Invoices</div>
            <h1 class="invoice-title">Receipts & Deliveries</h1>
            <p class="invoice-sub">Track delivery receipts, payment status, and totals at a glance.</p>
        </div>
        <div class="invoice-actions">
            <a asp-action="Create" class="invoice-btn invoice-btn-primary"><i class="bi bi-plus-lg"></i> New Receipt</a>
            <a asp-controller="Orders" asp-action="ReceiptList" class="invoice-btn invoice-btn-ghost"><i class="bi bi-list-check"></i> Receipt List</a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="invoice-card">
        <div class="invoice-card-header">
            <h6 class="invoice-card-title">All Receipts</h6>
            <span class="invoice-tag"><i class="bi bi-calendar3"></i> Latest</span>
        </div>
        <div class="invoice-card-body p-0">
            <div class="table-responsive">
                <table class="invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Receipt #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.ReceiptNumber</td>
                                <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                <td>@item.CustomerName</td>
                                <td>
                                    <span class="invoice-tag">@item.Type</span>
                                </td>
                                <td class="fw-bold text-end">@item.TotalAmount.ToString("N2")</td>
                                <td class="text-end">@item.PaidAmount.ToString("N2")</td>
                                <td>
                                    <span class="@StatusClass(item.Status)">@item.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Print" asp-route-id="@item.Id" class="invoice-icon-btn" title="Print"><i class="bi bi-printer"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="invoice-icon-btn" title="View"><i class="bi bi-eye"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
