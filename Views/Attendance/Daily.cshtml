@using HazelInvoice.Models
@model HazelInvoice.ViewModels.AttendanceDailyViewModel

@{
    ViewData["Title"] = "Daily Attendance";
    ViewData["NotePurpose"] = "Record attendance and auto-compute daily wages.";
    ViewData["NoteInstructions"] = "Daily rate is fully counted by default. Only absent laborers are deducted.";
}

<partial name="_WorkforceStyles" />

<div class="container-fluid p-4 workforce-page">
    <div class="workforce-header admin-page-hero admin-page-hero-soft">
        <div>
            <div class="admin-section-kicker">Daily Workforce</div>
            <h1 class="workforce-title">Daily Attendance</h1>
            <div class="workforce-sub">Present is full rate. Mark absent only when the laborer should have zero wage for the day.</div>
        </div>
        <a asp-controller="Laborers" asp-action="Index" class="btn workforce-btn workforce-btn-neutral admin-action-btn"><i class="bi bi-people"></i> Manage Laborers</a>
    </div>

    <partial name="_PageNote" />

    @if (TempData["AttendanceError"] is string attendanceError && !string.IsNullOrWhiteSpace(attendanceError))
    {
        <div class="alert alert-danger">@attendanceError</div>
    }
    @if (TempData["AttendanceSuccess"] is string attendanceSuccess && !string.IsNullOrWhiteSpace(attendanceSuccess))
    {
        <div class="alert alert-success">@attendanceSuccess</div>
    }

    <form method="get" class="workforce-filter admin-filter-strip">
        <div class="col-md-3">
            <label class="form-label fw-bold small">Work Date</label>
            <input type="date" name="date" class="form-control" value="@Model.WorkDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn workforce-btn workforce-btn-neutral w-100">Load Date</button>
        </div>
    </form>

    <form asp-action="Daily" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WorkDate" />
        <input type="hidden" name="workDate" value="@Model.WorkDate.ToString("yyyy-MM-dd")" />
        <div class="card workforce-card admin-surface-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle workforce-table">
                        <thead>
                            <tr>
                                <th>Laborer</th>
                                <th>Daily Rate</th>
                                <th>First Work</th>
                                <th>Duty Days</th>
                                <th>Absences</th>
                                <th>Absent</th>
                                <th>Wage</th>
                                <th>Notes</th>
                                <th>Payroll</th>
                                <th class="text-end">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Entries.Count; i++)
                            {
                                var isAbsent = Model.Entries[i].Status == AttendanceStatus.Absent;
                                var firstWorkDateText = Model.Entries[i].FirstWorkDate?.ToString("MMM dd, yyyy") ?? "—";
                                <tr>
                                    <td class="fw-bold">
                                        @Model.Entries[i].LaborerName
                                        <input type="hidden" name="Entries[@i].AttendanceRecordId" value="@Model.Entries[i].AttendanceRecordId" />
                                        <input type="hidden" name="Entries[@i].LaborerId" value="@Model.Entries[i].LaborerId" />
                                    </td>
                                    <td class="workforce-money">₱@Model.Entries[i].DailyRate.ToString("N2")</td>
                                    <td>@firstWorkDateText</td>
                                    <td>@Model.Entries[i].TotalDutyDays</td>
                                    <td>@Model.Entries[i].TotalAbsenceDays</td>
                                    <td>
                                        <div class="form-check d-flex align-items-center gap-2">
                                            <input type="hidden" name="Entries[@i].Status" value="@(isAbsent ? AttendanceStatus.Absent : AttendanceStatus.Present)" data-attendance-status />
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   data-absent-toggle
                                                   data-daily-rate="@Model.Entries[i].DailyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                   @(isAbsent ? "checked" : null) />
                                            <label class="form-check-label small">Absent</label>
                                        </div>
                                    </td>
                                    <td class="workforce-money" data-workforce-wage>₱@Model.Entries[i].WageAmount.ToString("N2")</td>
                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               name="Entries[@i].Notes"
                                               value="@Model.Entries[i].Notes"
                                               placeholder="Optional" />
                                    </td>
                                    <td>
                                        @if (Model.Entries[i].IsInPayroll)
                                        {
                                            <span class="workforce-status workforce-status-locked">In Payroll</span>
                                        }
                                        else
                                        {
                                            <span class="workforce-status workforce-status-open">Open</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (Model.Entries[i].AttendanceRecordId is int attendanceRecordId)
                                        {
                                            <button type="submit"
                                                    name="id"
                                                    value="@attendanceRecordId"
                                                    formaction="@Url.Action("Delete", "Attendance")"
                                                    formmethod="post"
                                                    class="btn btn-sm workforce-btn workforce-btn-danger"
                                                    onclick="return confirm('Delete this attendance entry?');">
                                                Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Entries.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-4">No active laborers found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">Total Salary: <span data-workforce-total>₱@Model.TotalWage.ToString("N2")</span></div>
                    <div class="small text-muted">Duty days are counted from the first recorded work date per laborer.</div>
                </div>
                <button type="submit" class="btn workforce-btn workforce-btn-primary">Save Attendance</button>
            </div>
        </div>
    </form>
</div>

<script>
    (() => {
        const currency = new Intl.NumberFormat('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        function refreshAttendanceTotals() {
            let total = 0;
            document.querySelectorAll('[data-workforce-wage]').forEach(cell => {
                const amount = Number.parseFloat(cell.getAttribute('data-wage-value') || '0');
                if (!Number.isNaN(amount)) {
                    total += amount;
                }
            });

            const totalNode = document.querySelector('[data-workforce-total]');
            if (totalNode) {
                totalNode.textContent = `₱${currency.format(total)}`;
            }
        }

        document.querySelectorAll('[data-absent-toggle]').forEach(toggle => {
            const row = toggle.closest('tr');
            if (!row) return;

            const statusInput = row.querySelector('[data-attendance-status]');
            const wageCell = row.querySelector('[data-workforce-wage]');
            const dailyRate = Number.parseFloat(toggle.getAttribute('data-daily-rate') || '0');
            if (!(statusInput instanceof HTMLInputElement) || !(wageCell instanceof HTMLElement)) return;

            const updateRow = () => {
                const wage = toggle.checked ? 0 : dailyRate;
                statusInput.value = toggle.checked ? 'Absent' : 'Present';
                wageCell.setAttribute('data-wage-value', wage.toString());
                wageCell.textContent = `₱${currency.format(wage)}`;
                refreshAttendanceTotals();
            };

            updateRow();
            toggle.addEventListener('change', updateRow);
        });
    })();
</script>
