@using HazelInvoice.Models
@model HazelInvoice.ViewModels.AttendanceDailyViewModel

@{
    ViewData["Title"] = "Daily Attendance";
    ViewData["NotePurpose"] = "Record attendance and auto-compute daily wages.";
    ViewData["NoteInstructions"] = "Statuses update wages on save. Late = 75%, Half-day = 50%, Absent = 0%.";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Daily Attendance</h1>
        <a asp-controller="Laborers" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-people"></i> Manage Laborers</a>
    </div>

    <partial name="_PageNote" />

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label fw-bold small">Work Date</label>
            <input type="date" name="date" class="form-control" value="@Model.WorkDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Load Date</button>
        </div>
    </form>

    <form asp-action="Daily" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WorkDate" />
        <div class="card shadow border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Laborer</th>
                                <th>Daily Rate</th>
                                <th>Status</th>
                                <th>Wage</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Entries.Count; i++)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @Model.Entries[i].LaborerName
                                        <input type="hidden" name="Entries[@i].LaborerId" value="@Model.Entries[i].LaborerId" />
                                    </td>
                                    <td>₱@Model.Entries[i].DailyRate.ToString("N2")</td>
                                    <td style="max-width: 180px;">
                                        <select class="form-select" name="Entries[@i].Status">
                                            @foreach (AttendanceStatus status in Enum.GetValues(typeof(AttendanceStatus)))
                                            {
                                                <option value="@status" selected="@(status == Model.Entries[i].Status)">@status</option>
                                            }
                                        </select>
                                    </td>
                                    <td>₱@Model.Entries[i].WageAmount.ToString("N2")</td>
                                    <td>
                                        <input type="text" class="form-control" name="Entries[@i].Notes" value="@Model.Entries[i].Notes" placeholder="Optional" />
                                    </td>
                                </tr>
                            }
                            @if (!Model.Entries.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No active laborers found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <div class="fw-bold">Total Wages: ₱@Model.TotalWage.ToString("N2")</div>
                <button type="submit" class="btn btn-primary">Save Attendance</button>
            </div>
        </div>
    </form>
</div>
