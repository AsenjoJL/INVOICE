@model HazelInvoice.ViewModels.IncomeStatementViewModel

@{
    ViewData["Title"] = "Income Statement";
}

<style>
    .income-page {
        --income-ink: #0a0a0a;
        --income-muted: #888888;
        --income-border: #e8e8e8;
        --income-soft: #f8f8f8;
        font-family: 'DM Sans', sans-serif;
        color: var(--income-ink);
    }

    .income-page .income-header,
    .income-page .income-sheet,
    .income-page .income-kpi {
        background: #ffffff;
        border: 1px solid var(--income-border);
        border-radius: var(--ui-radius-xl);
        box-shadow: none;
    }

    .income-page .income-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        padding: 28px 32px;
        margin-bottom: 20px;
    }

    .income-page .income-kicker,
    .income-page .income-period-label,
    .income-page .income-section-label,
    .income-page .income-row-label,
    .income-page .income-kpi-label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--income-muted);
    }

    .income-page h1 {
        margin: 8px 0 0;
        font-size: 22px;
        line-height: 1.1;
        font-weight: 600;
        color: var(--income-ink);
    }

    .income-page .income-sub {
        margin: 8px 0 0;
        font-size: 14px;
        line-height: 1.6;
        color: #606060;
    }

    .income-page .income-period-value {
        margin-top: 8px;
        font-size: 15px;
        font-weight: 500;
        color: var(--income-ink);
        text-align: right;
    }

    .income-page .income-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .income-page .income-kpi {
        padding: 18px 20px;
    }

    .income-page .income-kpi-value {
        margin-top: 10px;
        font-size: 24px;
        line-height: 1.15;
        font-weight: 600;
        color: var(--income-ink);
    }

    .income-page .income-sheet {
        max-width: 820px;
        margin: 0 auto;
        overflow: hidden;
    }

    .income-page .income-sheet-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--income-border);
    }

    .income-page .income-sheet-title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        color: var(--income-ink);
    }

    .income-page .income-sheet-body {
        padding: 0;
    }

    .income-page .income-section {
        padding: 22px 24px;
        border-bottom: 1px solid var(--income-border);
    }

    .income-page .income-section:last-child {
        border-bottom: 0;
    }

    .income-page .income-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 16px;
        align-items: end;
        padding: 10px 0;
    }

    .income-page .income-row + .income-row {
        border-top: 1px solid var(--income-border);
    }

    .income-page .income-row-title {
        font-size: 15px;
        font-weight: 500;
        color: var(--income-ink);
    }

    .income-page .income-row-note {
        margin-top: 4px;
        font-size: 13px;
        color: #606060;
    }

    .income-page .income-row-value {
        font-size: 15px;
        font-weight: 500;
        color: var(--income-ink);
        white-space: nowrap;
    }

    .income-page .income-total {
        background: var(--income-soft);
    }

    .income-page .income-total .income-row-title,
    .income-page .income-total .income-row-value {
        font-size: 20px;
        font-weight: 600;
    }

    .income-page .income-actions {
        display: flex;
        justify-content: center;
        margin-top: 18px;
    }

    .income-page .btn {
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        font-size: 14px;
        font-weight: 500;
        padding: 10px 16px;
    }

    .income-page .btn-outline-primary {
        background: #ffffff;
        border: 1px solid var(--income-border);
        color: var(--income-ink);
    }

    .income-page .btn-outline-primary:hover {
        background: var(--income-soft);
        border-color: #dcdcdc;
        color: var(--income-ink);
    }

    @@media (max-width: 768px) {
        .income-page .income-header,
        .income-page .income-sheet-header,
        .income-page .income-section {
            padding: 20px;
        }

        .income-page .income-grid {
            grid-template-columns: 1fr;
        }

        .income-page .income-period-value {
            text-align: left;
        }
    }

    .income-page .income-header,
    .income-page .income-sheet,
    .income-page .income-kpi {
        border-radius: var(--ui-radius-xl) !important;
    }

    .income-page .btn {
        border-radius: var(--ui-radius-md) !important;
    }
</style>

<div class="container-fluid p-4 income-page">
    <div class="income-header">
        <div>
            <div class="income-kicker">Finance Report</div>
            <h1>Income Statement</h1>
            <div class="income-sub">A simple statement of profit and loss for the selected period.</div>
        </div>
        <div>
            <div class="income-period-label">Reporting Period</div>
            <div class="income-period-value">@Model.Period</div>
        </div>
    </div>

    <div class="income-grid">
        <div class="income-kpi">
            <div class="income-kpi-label">Revenue</div>
            <div class="income-kpi-value">@Model.Revenue.ToString("N2")</div>
        </div>
        <div class="income-kpi">
            <div class="income-kpi-label">Net Profit</div>
            <div class="income-kpi-value">@Model.NetProfit.ToString("N2")</div>
        </div>
    </div>

    <div class="income-sheet">
        <div class="income-sheet-header">
            <div class="income-section-label">Statement Of Profit &amp; Loss</div>
            <h2 class="income-sheet-title">Income Summary</h2>
        </div>
        <div class="income-sheet-body">
            <section class="income-section">
                <div class="income-row">
                    <div>
                        <div class="income-row-label">Revenue</div>
                        <div class="income-row-title">Sales</div>
                    </div>
                    <div class="income-row-value">@Model.Revenue.ToString("N2")</div>
                </div>
                <div class="income-row">
                    <div>
                        <div class="income-row-label">Less</div>
                        <div class="income-row-title">Cost of Goods Sold</div>
                    </div>
                    <div class="income-row-value">(@Model.COGS.ToString("N2"))</div>
                </div>
            </section>

            <section class="income-section income-total">
                <div class="income-row">
                    <div>
                        <div class="income-row-label">Subtotal</div>
                        <div class="income-row-title">Gross Profit</div>
                    </div>
                    <div class="income-row-value">@Model.GrossProfit.ToString("N2")</div>
                </div>
            </section>

            <section class="income-section">
                <div class="income-row">
                    <div>
                        <div class="income-row-label">Operating Expenses</div>
                        <div class="income-row-title">Total Expenses</div>
                        <div class="income-row-note">Expenses recorded in the selected reporting period.</div>
                    </div>
                    <div class="income-row-value">(@Model.Expenses.ToString("N2"))</div>
                </div>
            </section>

            <section class="income-section income-total">
                <div class="income-row">
                    <div>
                        <div class="income-row-label">Result</div>
                        <div class="income-row-title">Net Profit</div>
                    </div>
                    <div class="income-row-value">@Model.NetProfit.ToString("N2")</div>
                </div>
            </section>
        </div>
    </div>

    <div class="income-actions no-print">
        <button onclick="return window.hazelPrint && window.hazelPrint.prepareAndPrint ? window.hazelPrint.prepareAndPrint() : (window.print(), false)" class="btn btn-outline-primary">
            <i class="bi bi-printer"></i> Print Report
        </button>
    </div>
</div>
