<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HazelInvoice</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/invoice.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HazelInvoice.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @using HazelInvoice.Helpers
    @inject Microsoft.Extensions.Options.IOptions<HazelInvoice.Configuration.FeaturesOptions> Features
    <div id="hazel-af-token" style="display:none">
        @Html.AntiForgeryToken()
    </div>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var nextDeliveryDate = BusinessDate.Tomorrow().ToString("yyyy-MM-dd");
        var pageTitle = (ViewData["Title"]?.ToString() ?? currentController).Trim();
        var pageSubtitle = currentController switch
        {
            "Dashboard" => "Overview",
            "Receipts" => "Sales",
            "Orders" => "Orders",
            "Products" => "Stock",
            "Customers" => "Stock",
            "Suppliers" => "Purchases",
            "WeeklyPrices" => "Stock",
            "DailyPurchaseCosts" => "Stock",
            "Purchases" => "Purchases",
            "Expenses" => "Finance",
            "Laborers" => "Workforce",
            "Attendance" => "Workforce",
            "Payroll" => "Workforce",
            "ProfitReport" => "Finance",
            _ => "Workspace"

        };
        string NavClass(string controller, string? action = null)
        {
            if (!string.IsNullOrEmpty(action))
                return currentController == controller && currentAction == action ? "sidebar-link active" : "sidebar-link";
            return currentController == controller ? "sidebar-link active" : "sidebar-link";
        }
    }

    <div class="app-shell">
        <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarNav" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="sidebarLabel">HazelInvoice</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="sidebar-header">
                <a class="sidebar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">HazelInvoice</a>
                <div class="sidebar-subtitle">Operations</div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section-title">Overview</div>
                <a class="@NavClass("Dashboard", "Index")" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>

                <div class="sidebar-section-title">Sales</div>
                <a class="@NavClass("Receipts", "Index")" asp-area="" asp-controller="Receipts" asp-action="Index">Receipts</a>
                <a class="@NavClass("Receipts", "Create")" asp-area="" asp-controller="Receipts" asp-action="Create" asp-route-date="@nextDeliveryDate">New Sale</a>
                <a class="@NavClass("Orders", "VegetableMatrix")" asp-area="" asp-controller="Orders" asp-action="VegetableMatrix">Vegetable Order</a>
                <a class="@NavClass("ProfitReport", "Index")" asp-area="" asp-controller="ProfitReport" asp-action="Index">Profit &amp; Sales</a>

                <div class="sidebar-section-title">Stock</div>
                <a class="@NavClass("Products", "Index")" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                <a class="@NavClass("Customers", "Index")" asp-area="" asp-controller="Customers" asp-action="Index">Outlets</a>
                <a class="@NavClass("WeeklyPrices", "PriceVersus")" asp-area="" asp-controller="WeeklyPrices" asp-action="PriceVersus">Price Setup</a>
                <a class="@NavClass("WeeklyPrices", "Index")" asp-area="" asp-controller="WeeklyPrices" asp-action="Index">Price History</a>
                <a class="@NavClass("DailyPurchaseCosts", "Index")" asp-area="" asp-controller="DailyPurchaseCosts" asp-action="Index">Daily Purchase Cost</a>


                <div class="sidebar-section-title">Purchases</div>
                <a class="@NavClass("Suppliers", "Index")" asp-area="" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
                <a class="@NavClass("Purchases", "Index")" asp-area="" asp-controller="Purchases" asp-action="Index">Purchases</a>
                <a class="@NavClass("Purchases", "Create")" asp-area="" asp-controller="Purchases" asp-action="Create">New Purchase</a>
                <a class="@NavClass("Purchases", "Payables")" asp-area="" asp-controller="Purchases" asp-action="Payables">Payables</a>

                <div class="sidebar-section-title">Finance</div>
                <a class="@NavClass("Expenses", "Index")" asp-area="" asp-controller="Expenses" asp-action="Index">Expenses</a>
                @if (Features.Value.PartnersEnabled)
                {
                    <a class="@NavClass("Partners", "Index")" asp-area="" asp-controller="Partners" asp-action="Index">Partners</a>
                }
                <a class="@NavClass("PrinterSettings", "Index")" asp-area="" asp-controller="PrinterSettings" asp-action="Index">Printer Settings</a>
                <a class="@NavClass("Reports", "IncomeStatement")" asp-controller="Reports" asp-action="IncomeStatement">Income Statement</a>
                <div class="sidebar-section-title">Workforce</div>
                <a class="@NavClass("Laborers", "Index")" asp-area="" asp-controller="Laborers" asp-action="Index">Laborers</a>
                <a class="@NavClass("Attendance", "Daily")" asp-area="" asp-controller="Attendance" asp-action="Daily">Attendance</a>
                <a class="@NavClass("Payroll", "Index")" asp-area="" asp-controller="Payroll" asp-action="Index">Payroll</a>
                <a class="@NavClass("PayrollReports", "Unpaid")" asp-controller="PayrollReports" asp-action="Unpaid">Unpaid Labor</a>
                <a class="@NavClass("PayrollReports", "LaborCost")" asp-controller="PayrollReports" asp-action="LaborCost">Labor Cost</a>
            </nav>
        </aside>

        <div class="content">
            <div class="mobile-topbar d-lg-none">
                <button class="admin-mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav" aria-controls="sidebarNav">
                    <i class="bi bi-list"></i>
                </button>
                <span class="mobile-title">HazelInvoice</span>
            </div>
            <main role="main" class="content-area">
                <section class="admin-topbar">
                    <div class="admin-topbar-copy">
                        <span class="admin-kicker">@pageSubtitle / @pageTitle</span>
                        <h1 class="admin-page-title">@pageTitle</h1>
                    </div>
                    <div class="admin-topbar-actions">
                        <div class="admin-topbar-account">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </section>
                @RenderBody()
            </main>
            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - HazelInvoice - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const sidebar = document.getElementById('sidebarNav');
            if (!sidebar) return;

            const storageKey = 'hazelinvoice.sidebar.scrollTop';
            const desktopQuery = window.matchMedia('(min-width: 992px)');

            function isDesktop() {
                return desktopQuery.matches;
            }

            function restoreSidebarPosition() {
                if (isDesktop()) {
                    const active = sidebar.querySelector('.sidebar-link.active');
                    if (active && active.scrollIntoView) {
                        active.scrollIntoView({ block: 'nearest' });
                    }
                    return;
                }

                const saved = sessionStorage.getItem(storageKey);
                if (saved === null) {
                    return;
                }

                const top = parseInt(saved, 10);
                if (!Number.isNaN(top)) {
                    sidebar.scrollTop = top;
                }
            }

            restoreSidebarPosition();

            sidebar.addEventListener('scroll', () => {
                if (!isDesktop()) {
                    sessionStorage.setItem(storageKey, sidebar.scrollTop.toString());
                }
            }, { passive: true });

            const links = sidebar.querySelectorAll('.sidebar-link');
            links.forEach(link => {
                link.addEventListener('click', () => {
                    if (!isDesktop()) {
                        sessionStorage.setItem(storageKey, sidebar.scrollTop.toString());
                    }
                });
            });

            const handleViewportChange = () => {
                if (isDesktop()) {
                    sessionStorage.removeItem(storageKey);
                    sidebar.scrollTop = 0;
                    restoreSidebarPosition();
                }
            };

            if (desktopQuery.addEventListener) {
                desktopQuery.addEventListener('change', handleViewportChange);
            } else if (desktopQuery.addListener) {
                desktopQuery.addListener(handleViewportChange);
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
