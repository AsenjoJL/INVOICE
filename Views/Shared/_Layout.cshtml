<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HazelInvoice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HazelInvoice.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @inject Microsoft.Extensions.Options.IOptions<HazelInvoice.Configuration.FeaturesOptions> Features
    <div id="hazel-af-token" style="display:none">
        @Html.AntiForgeryToken()
    </div>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var pageTitle = (ViewData["Title"]?.ToString() ?? currentController).Trim();
        var pageSubtitle = currentController switch
        {
            "Dashboard" => "Operations dashboard and performance overview.",
            "Receipts" => "Sales encoding, delivery receipts, and payment tracking.",
            "Orders" => "Daily outlet ordering and vegetable matrix planning.",
            "Products" => "Catalog, costs, and selling price management.",
            "Customers" => "Outlet directory and delivery account setup.",
            "Suppliers" => "Vendors, sourcing details, and supply records.",
            "WeeklyPrices" => "Weekly price setup and historical price review.",
            "Purchases" => "Purchases, stock intake, and supplier payables.",
            "Expenses" => "Expense tracking and cash outflow records.",
            "Laborers" => "Workforce roster and labor profiles.",
            "Attendance" => "Daily labor attendance and cutoff preparation.",
            "Payroll" => "Payroll generation, payments, and run management.",
            "ProfitReport" => "Sales, profit, deductions, and collections summary.",
            _ => "HazelInvoice admin workspace."
        };
        string NavClass(string controller, string? action = null)
        {
            if (!string.IsNullOrEmpty(action))
                return currentController == controller && currentAction == action ? "sidebar-link active" : "sidebar-link";
            return currentController == controller ? "sidebar-link active" : "sidebar-link";
        }
    }

    <div class="app-shell">
        <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarNav" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="sidebarLabel">HazelInvoice</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="sidebar-header">
                <a class="sidebar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">HazelInvoice</a>
                <div class="sidebar-subtitle">Invoice & Ordering</div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section-title">Sales</div>
                <a class="@NavClass("Dashboard", "Index")" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                <a class="@NavClass("Receipts", "Index")" asp-area="" asp-controller="Receipts" asp-action="Index"><i class="bi bi-receipt-cutoff"></i> Receipts</a>
                <a class="@NavClass("Receipts", "Create")" asp-area="" asp-controller="Receipts" asp-action="Create"><i class="bi bi-bag-plus-fill"></i> New Sale</a>
                <a class="@NavClass("Orders", "VegetableMatrix")" asp-area="" asp-controller="Orders" asp-action="VegetableMatrix"><i class="bi bi-table"></i> Vegetable Order</a>
                <a class="@NavClass("ProfitReport", "Index")" asp-area="" asp-controller="ProfitReport" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Profit & Sales</a>

                <div class="sidebar-section-title">Inventory</div>
                <a class="@NavClass("Products", "Index")" asp-area="" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam-fill"></i> Products</a>
                <a class="@NavClass("Customers", "Index")" asp-area="" asp-controller="Customers" asp-action="Index"><i class="bi bi-shop-window"></i> Outlets</a>
                <a class="@NavClass("Suppliers", "Index")" asp-area="" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck-flatbed"></i> Suppliers</a>
                <a class="@NavClass("WeeklyPrices", "PriceVersus")" asp-area="" asp-controller="WeeklyPrices" asp-action="PriceVersus"><i class="bi bi-sliders2"></i> Price Setup</a>
                <a class="@NavClass("WeeklyPrices", "Index")" asp-area="" asp-controller="WeeklyPrices" asp-action="Index"><i class="bi bi-clock-history"></i> Price History</a>
                <a class="@NavClass("Purchases", "Index")" asp-area="" asp-controller="Purchases" asp-action="Index"><i class="bi bi-bag-check-fill"></i> Purchases</a>
                <a class="@NavClass("Purchases", "Create")" asp-area="" asp-controller="Purchases" asp-action="Create"><i class="bi bi-bag-plus"></i> New Purchase</a>
                <a class="@NavClass("Purchases", "Payables")" asp-area="" asp-controller="Purchases" asp-action="Payables"><i class="bi bi-wallet2"></i> Payables</a>

                <div class="sidebar-section-title">Finance</div>
                <a class="@NavClass("Expenses", "Index")" asp-area="" asp-controller="Expenses" asp-action="Index"><i class="bi bi-cash-stack"></i> Expenses</a>
                @if (Features.Value.PartnersEnabled)
                {
                    <a class="@NavClass("Partners", "Index")" asp-area="" asp-controller="Partners" asp-action="Index"><i class="bi bi-people"></i> Partners</a>
                }
                <a class="@NavClass("PrinterSettings", "Index")" asp-area="" asp-controller="PrinterSettings" asp-action="Index"><i class="bi bi-printer-fill"></i> Printer Settings</a>
                <a class="@NavClass("Laborers", "Index")" asp-area="" asp-controller="Laborers" asp-action="Index"><i class="bi bi-people-fill"></i> Laborers</a>
                <a class="@NavClass("Attendance", "Daily")" asp-area="" asp-controller="Attendance" asp-action="Daily"><i class="bi bi-calendar-check-fill"></i> Attendance</a>
                <a class="@NavClass("Payroll", "Index")" asp-area="" asp-controller="Payroll" asp-action="Index"><i class="bi bi-cash-coin"></i> Payroll</a>
                <a class="@NavClass("Reports", "IncomeStatement")" asp-controller="Reports" asp-action="IncomeStatement"><i class="bi bi-file-earmark-text"></i> Income Statement</a>
                <a class="@NavClass("Reports", "Inventory")" asp-controller="Reports" asp-action="Inventory"><i class="bi bi-clipboard-data"></i> Inventory Status</a>
                <a class="@NavClass("ProfitReport", "Index")" asp-controller="ProfitReport" asp-action="Index"><i class="bi bi-file-earmark-spreadsheet"></i> Profit Summary</a>
                <a class="@NavClass("PayrollReports", "Unpaid")" asp-controller="PayrollReports" asp-action="Unpaid"><i class="bi bi-exclamation-triangle"></i> Unpaid Labor</a>
                <a class="@NavClass("PayrollReports", "LaborCost")" asp-controller="PayrollReports" asp-action="LaborCost"><i class="bi bi-graph-down"></i> Labor Cost</a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-note">
                    <i class="bi bi-lightning-charge"></i>
                    <span>Fast sales, purchasing, payroll, and reporting in one workspace.</span>
                </div>
            </div>
        </aside>

        <div class="content">
            <div class="mobile-topbar d-lg-none">
                <button class="admin-mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav" aria-controls="sidebarNav">
                    <i class="bi bi-list"></i>
                </button>
                <span class="mobile-title">HazelInvoice</span>
            </div>
            <main role="main" class="content-area">
                <section class="admin-topbar">
                    <div class="admin-topbar-copy">
                        <span class="admin-kicker">HazelInvoice Admin</span>
                        <h1 class="admin-page-title">@pageTitle</h1>
                        <p class="admin-page-subtitle">@pageSubtitle</p>
                    </div>
                    <div class="admin-topbar-actions">
                        <nav class="admin-mode-pills" aria-label="Quick navigation">
                            <a class="admin-mode-pill @(currentController == "Dashboard" ? "active" : null)" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i> Dashboard
                            </a>
                            <a class="admin-mode-pill @(currentController == "Receipts" ? "active" : null)" asp-controller="Receipts" asp-action="Index">
                                <i class="bi bi-receipt-cutoff"></i> Sales
                            </a>
                            <a class="admin-mode-pill @(currentController == "Orders" ? "active" : null)" asp-controller="Orders" asp-action="VegetableMatrix">
                                <i class="bi bi-basket2"></i> Orders
                            </a>
                            <a class="admin-mode-pill @(currentController == "Payroll" || currentController == "Attendance" || currentController == "Laborers" ? "active" : null)" asp-controller="Payroll" asp-action="Index">
                                <i class="bi bi-people"></i> Workforce
                            </a>
                        </nav>
                        <div class="admin-topbar-account">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </section>
                @RenderBody()
            </main>
            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - HazelInvoice - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const sidebar = document.getElementById('sidebarNav');
            if (!sidebar) return;

            const storageKey = 'hazelinvoice.sidebar.scrollTop';
            const saved = sessionStorage.getItem(storageKey);
            if (saved !== null) {
                const top = parseInt(saved, 10);
                if (!Number.isNaN(top)) sidebar.scrollTop = top;
            } else {
                const active = sidebar.querySelector('.sidebar-link.active');
                if (active && active.scrollIntoView) {
                    active.scrollIntoView({ block: 'nearest' });
                }
            }

            sidebar.addEventListener('scroll', () => {
                sessionStorage.setItem(storageKey, sidebar.scrollTop.toString());
            }, { passive: true });

            const links = sidebar.querySelectorAll('.sidebar-link');
            links.forEach(link => {
                link.addEventListener('click', () => {
                    sessionStorage.setItem(storageKey, sidebar.scrollTop.toString());
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
