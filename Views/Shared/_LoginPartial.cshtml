@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var userName = User.Identity?.Name ?? "Admin";
    var initial = string.IsNullOrWhiteSpace(userName) ? "A" : userName.Substring(0, 1).ToUpperInvariant();

    <div class="admin-account-card">
        <a class="admin-account-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
            <span class="admin-account-avatar">@initial</span>
            <span class="admin-account-copy">
                <strong>@userName</strong>
                <small>Signed in</small>
            </span>
        </a>
        <form class="admin-account-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="admin-account-logout">Sign out</button>
        </form>
    </div>
}
else
{
    <div class="admin-account-guest">
        <a class="admin-mini-btn" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="admin-mini-btn admin-mini-btn-primary" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </div>
}
