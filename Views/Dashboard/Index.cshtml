@using HazelInvoice.Helpers
@model HazelInvoice.ViewModels.DashboardViewModel
@inject Microsoft.Extensions.Options.IOptions<HazelInvoice.Configuration.FeaturesOptions> Features
@{
    ViewData["Title"] = "Dashboard";
    var businessNow = BusinessDate.Now();
    var businessDate = businessNow.Date;
    var nextDeliveryDate = BusinessDate.Tomorrow().ToString("yyyy-MM-dd");
    var allowDangerousDatabaseReset = Features.Value.AllowDangerousDatabaseReset;
    var weekOffset = (7 + (businessDate.DayOfWeek - DayOfWeek.Monday)) % 7;
    var weekStart = businessDate.AddDays(-weekOffset);
    var weekEnd = weekStart.AddDays(6);
    var monthStart = new DateTime(businessDate.Year, businessDate.Month, 1);
    var monthEnd = monthStart.AddMonths(1).AddDays(-1);
    string TrendBadgeClass(decimal value) => value > 0 ? "is-up" : (value < 0 ? "is-down" : "is-flat");
    string TrendIcon(decimal value) => value > 0 ? "bi-arrow-up-right" : (value < 0 ? "bi-arrow-down-right" : "bi-dash");
    string TrendText(decimal value) => $"{Math.Abs(value):0.#}%";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-refresh.css" asp-append-version="true" />
}

<div class="container-fluid pb-5 dashboard-shell dashboard-admin dashboard-refresh">
    <section class="dashboard-hero-panel">
        <div class="dashboard-hero-main">
            <span class="dashboard-hero-kicker"><i class="bi bi-activity"></i> Live Operations</span>
            <h1 class="dashboard-hero-title">Admin Console</h1>
            <p class="dashboard-hero-text">Track sales, expenses, margins, cash flow, and daily outlet movement from one command center.</p>
            <div class="dashboard-hero-meta">
                <span><i class="bi bi-calendar3"></i> @businessNow.ToString("dddd, MMMM dd, yyyy")</span>
                <span><i class="bi bi-clock-history"></i> @businessNow.ToString("h:mm tt")</span>
            </div>
        </div>
        <div class="dashboard-hero-side">
            <div class="dashboard-hero-actions">
                <a href="@Url.Action("Create", "Receipts", new { date = nextDeliveryDate })" class="dash-btn dash-btn-dark"><i class="bi bi-plus-circle"></i> New Sale</a>
                <a href="/Orders/VegetableOutletOrder" class="dash-btn dash-btn-light"><i class="bi bi-basket2"></i> New Order</a>
            </div>
            <div class="dashboard-hero-highlight">
                <span>Cash Balance</span>
                <span class="dashboard-highlight-value">₱@Model.CashBalance.ToString("N0")</span>
                <small>@(Model.CashBalance == 0 ? "Waiting for recorded inflows" : "Recorded payments minus expenses")</small>
            </div>
        </div>
    </section>

    <section class="dashboard-kpi-strip">
        <article class="dashboard-kpi-tile tile-cash">
            <div class="dashboard-kpi-icon"><i class="bi bi-wallet2"></i></div>
            <div class="dashboard-kpi-copy">
                <span class="dashboard-kpi-label">Cash Balance</span>
                <span class="dashboard-kpi-number">₱@Model.CashBalance.ToString("N0")</span>
                <small>Recorded payments minus expenses</small>
            </div>
        </article>
        <article class="dashboard-kpi-tile tile-sales">
            <div class="dashboard-kpi-icon"><i class="bi bi-cart3"></i></div>
            <div class="dashboard-kpi-copy">
                <span class="dashboard-kpi-label">Sales Today</span>
                <span class="dashboard-kpi-number">₱@Model.SalesToday.ToString("N0")</span>
                <small>@businessDate.ToString("MMM dd, yyyy")</small>
            </div>
            <span class="dashboard-kpi-trend @TrendBadgeClass(Model.SalesTodayTrendPercent)"><i class="bi @TrendIcon(Model.SalesTodayTrendPercent)"></i> @TrendText(Model.SalesTodayTrendPercent)</span>
        </article>
        <article class="dashboard-kpi-tile tile-week">
            <div class="dashboard-kpi-icon"><i class="bi bi-bar-chart-line"></i></div>
            <div class="dashboard-kpi-copy">
                <span class="dashboard-kpi-label">Total Sales Week</span>
                <span class="dashboard-kpi-number">₱@Model.SalesWeekly.ToString("N0")</span>
                <small>@weekStart.ToString("MMM dd") - @weekEnd.ToString("MMM dd")</small>
            </div>
        </article>
        <article class="dashboard-kpi-tile tile-month">
            <div class="dashboard-kpi-icon"><i class="bi bi-bag-check"></i></div>
            <div class="dashboard-kpi-copy">
                <span class="dashboard-kpi-label">Total Sales Month</span>
                <span class="dashboard-kpi-number">₱@Model.SalesMonthly.ToString("N0")</span>
                <small>@monthStart.ToString("MMM dd") - @monthEnd.ToString("MMM dd")</small>
            </div>
            <span class="dashboard-kpi-trend @TrendBadgeClass(Model.SalesMonthlyTrendPercent)"><i class="bi @TrendIcon(Model.SalesMonthlyTrendPercent)"></i> @TrendText(Model.SalesMonthlyTrendPercent)</span>
        </article>
        <article class="dashboard-kpi-tile tile-profit dashboard-kpi-next-row">
            <div class="dashboard-kpi-icon"><i class="bi bi-pie-chart"></i></div>
            <div class="dashboard-kpi-copy">
                <span class="dashboard-kpi-label">Gross Profit Month</span>
                <span class="dashboard-kpi-number">₱@Model.GrossProfitMonth.ToString("N0")</span>
                <small>Revenue minus item cost</small>
            </div>
            <span class="dashboard-kpi-trend @TrendBadgeClass(Model.GrossProfitTrendPercent)"><i class="bi @TrendIcon(Model.GrossProfitTrendPercent)"></i> @TrendText(Model.GrossProfitTrendPercent)</span>
        </article>
    </section>

    <section class="dashboard-module-bar">
        <a href="/Dashboard" class="dashboard-module-pill active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
        <a href="/Receipts" class="dashboard-module-pill"><i class="bi bi-receipt-cutoff"></i> Receipts</a>
        <a href="/Orders/VegetableMatrix" class="dashboard-module-pill"><i class="bi bi-table"></i> Vegetable Order</a>
        <a href="/Products" class="dashboard-module-pill"><i class="bi bi-box-seam"></i> Products</a>
        <a href="/DailyPurchaseCosts" class="dashboard-module-pill"><i class="bi bi-coin"></i> Daily Purchase Cost</a>
        <a href="/Customers" class="dashboard-module-pill"><i class="bi bi-shop"></i> Outlets</a>
        <a href="/Purchases" class="dashboard-module-pill"><i class="bi bi-bag-check"></i> Purchases</a>
        <a href="/Payroll" class="dashboard-module-pill"><i class="bi bi-cash-coin"></i> Payroll</a>
        <a href="/ProfitReport" class="dashboard-module-pill"><i class="bi bi-graph-up-arrow"></i> Profit &amp; Sales</a>
    </section>

    <section class="dashboard-section-heading">
        <div>
            <h2>Operational Signals</h2>
            <p>Real-time insights into selling performance, collections, expenses, and outlet activity.</p>
        </div>
        <div class="dashboard-section-actions">
            <a href="/WeeklyPrices/PriceVersus" class="dashboard-inline-link"><i class="bi bi-sliders2"></i> Price Setup</a>
            <a href="/DailyPurchaseCosts" class="dashboard-inline-link"><i class="bi bi-coin"></i> Daily Purchase Cost</a>
            <a href="@Url.Action("UnpaidOrders", "Orders")" class="dashboard-inline-link"><i class="bi bi-exclamation-circle"></i> Unpaid Orders</a>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-success">
                <div class="metric-head">
                    <div class="metric-label">Sales Today</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.SalesTodayTrendPercent)"><i class="bi @TrendIcon(Model.SalesTodayTrendPercent)"></i> @TrendText(Model.SalesTodayTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.SalesToday.ToString("N0")</div>
                <div class="metric-state">@(Model.SalesToday == 0 ? "No activity yet" : "Updated today")</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">@businessDate.ToString("MMM dd, yyyy")</span>
                    <a class="unpaid-link" href="@Url.Action("SummaryAll", "Orders", new { startDate = businessDate.ToString("yyyy-MM-dd"), endDate = businessDate.ToString("yyyy-MM-dd"), status = "All" })">View</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-primary">
                <div class="metric-head">
                    <div class="metric-label">Total Sales Week</div>
                </div>
                <div class="metric-value">₱@Model.SalesWeekly.ToString("N0")</div>
                <div class="metric-state">@(Model.SalesWeekly == 0 ? "No activity this week" : "Current week revenue")</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">@weekStart.ToString("MMM dd") - @weekEnd.ToString("MMM dd")</span>
                    <a class="unpaid-link" href="@Url.Action("SummaryAll", "Orders", new { startDate = weekStart.ToString("yyyy-MM-dd"), endDate = weekEnd.ToString("yyyy-MM-dd"), status = "All" })">View</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-primary kpi-card-priority">
                <div class="metric-head">
                    <div class="metric-label">Total Sales Month</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.SalesMonthlyTrendPercent)"><i class="bi @TrendIcon(Model.SalesMonthlyTrendPercent)"></i> @TrendText(Model.SalesMonthlyTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.SalesMonthly.ToString("N0")</div>
                <div class="metric-state">@(Model.SalesMonthly == 0 ? "No activity this month" : "Current month revenue")</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">@monthStart.ToString("MMM dd") - @monthEnd.ToString("MMM dd")</span>
                    <a class="unpaid-link" href="@Url.Action("SummaryAll", "Orders", new { startDate = monthStart.ToString("yyyy-MM-dd"), endDate = monthEnd.ToString("yyyy-MM-dd"), status = "All" })">View</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-warning kpi-card-priority">
                <div class="metric-head">
                    <div class="metric-label">Gross Profit Month</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.GrossProfitTrendPercent)"><i class="bi @TrendIcon(Model.GrossProfitTrendPercent)"></i> @TrendText(Model.GrossProfitTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.GrossProfitMonth.ToString("N0")</div>
                <div class="metric-state">@(Model.GrossProfitMonth == 0 ? "No realized margin this month" : "Current month revenue minus item cost")</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-danger">
                <div class="metric-head">
                    <div class="metric-label">Collectibles Overall</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.UnpaidTrendPercent)"><i class="bi @TrendIcon(Model.UnpaidTrendPercent)"></i> @TrendText(Model.UnpaidTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.OutstandingReceivablesAllTime.ToString("N0")</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">@Model.UnpaidInvoiceCount invoice@(Model.UnpaidInvoiceCount == 1 ? "" : "s")</span>
                    <a class="unpaid-link" href="@Url.Action("UnpaidOrders", "Orders")">View</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-info">
                <div class="metric-head">
                    <div class="metric-label">Items Today</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.ItemsSoldTodayTrendPercent)"><i class="bi @TrendIcon(Model.ItemsSoldTodayTrendPercent)"></i> @TrendText(Model.ItemsSoldTodayTrendPercent)</span>
                </div>
                @if (Model.ItemsSoldTodayByUnit != null && Model.ItemsSoldTodayByUnit.Any())
                {
                    <div class="small text-muted mt-2 d-flex flex-wrap gap-2">
                        @foreach (var unit in Model.ItemsSoldTodayByUnit)
                        {
                            <span class="badge bg-light text-dark border">
                                @unit.Category: @unit.Value.ToString("0.###")
                            </span>
                        }
                    </div>
                    <div class="metric-state mt-2">Unit breakdown</div>
                }
                else
                {
                    <div class="metric-value">0</div>
                    <div class="metric-state">No item movement yet</div>
                }
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-warning">
                <div class="metric-head">
                    <div class="metric-label">Cost of Goods Today</div>
                </div>
                <div class="metric-value">₱@Model.CostOfGoodsToday.ToString("N0")</div>
                <div class="metric-state">Daily purchase cost applied to today's receipt items</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">@Model.DailyPurchaseCostsUpdatedToday updated · @Model.DailyPurchaseCostsUsingPrevious previous</span>
                    <a class="unpaid-link" href="@Url.Action("Index", "DailyPurchaseCosts", new { date = businessDate.ToString("yyyy-MM-dd") })">Open</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-warning">
                <div class="metric-head">
                    <div class="metric-label">Cost of Goods Month</div>
                </div>
                <div class="metric-value">₱@Model.CostOfGoodsMonth.ToString("N0")</div>
                <div class="metric-state">Current month item cost from receipt snapshots</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-success">
                <div class="metric-head">
                    <div class="metric-label">Gross Profit Today</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.GrossProfitTodayTrendPercent)"><i class="bi @TrendIcon(Model.GrossProfitTodayTrendPercent)"></i> @TrendText(Model.GrossProfitTodayTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.GrossProfitToday.ToString("N0")</div>
                <div class="metric-state">Today's sales minus today's item cost</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-danger">
                <div class="metric-head">
                    <div class="metric-label">Expense Today</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.ExpenseTodayTrendPercent)"><i class="bi @TrendIcon(Model.ExpenseTodayTrendPercent)"></i> @TrendText(Model.ExpenseTodayTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.ExpenseToday.ToString("N0")</div>
                <div class="metric-state">@(Model.ExpenseToday == 0 ? "No expense posted" : "Today cash outflow")</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-danger-soft">
                <div class="metric-head">
                    <div class="metric-label">Expense Month</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.ExpenseMonthlyTrendPercent)"><i class="bi @TrendIcon(Model.ExpenseMonthlyTrendPercent)"></i> @TrendText(Model.ExpenseMonthlyTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.ExpenseMonthly.ToString("N0")</div>
                <div class="metric-state">@(Model.ExpenseMonthly == 0 ? "No monthly expenses yet" : "Current month spending")</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-danger-soft">
                <div class="metric-head">
                    <div class="metric-label">@Model.ProfitFeePercent.ToString("0.##")% Sales Fee Today</div>
                </div>
                <div class="metric-value">₱@Model.ProfitFeeToday.ToString("N0")</div>
                <div class="metric-state">Deducted from gross profit for net profit</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-danger-soft">
                <div class="metric-head">
                    <div class="metric-label">@Model.ProfitFeePercent.ToString("0.##")% Sales Fee Month</div>
                </div>
                <div class="metric-value">₱@Model.ProfitFeeMonth.ToString("N0")</div>
                <div class="metric-state">Current month sales fee/tax deduction</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-success">
                <div class="metric-head">
                    <div class="metric-label">Net Profit Today</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.NetProfitTodayTrendPercent)"><i class="bi @TrendIcon(Model.NetProfitTodayTrendPercent)"></i> @TrendText(Model.NetProfitTodayTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.NetProfitToday.ToString("N0")</div>
                <div class="metric-state">Gross profit today less expenses and @Model.ProfitFeePercent.ToString("0.##")% fee</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-success">
                <div class="metric-head">
                    <div class="metric-label">Net Profit Month</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.NetProfitMonthTrendPercent)"><i class="bi @TrendIcon(Model.NetProfitMonthTrendPercent)"></i> @TrendText(Model.NetProfitMonthTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.NetProfitMonth.ToString("N0")</div>
                <div class="metric-state">@(Model.NetProfitMonth == 0 ? $"Gross profit less expenses and {Model.ProfitFeePercent:0.##}% fee" : "Current month net result after expenses and fee")</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100 is-success">
                <div class="metric-head">
                    <div class="metric-label">Cash Balance</div>
                    <span class="kpi-trend @TrendBadgeClass(Model.CashBalanceTrendPercent)"><i class="bi @TrendIcon(Model.CashBalanceTrendPercent)"></i> @TrendText(Model.CashBalanceTrendPercent)</span>
                </div>
                <div class="metric-value">₱@Model.CashBalance.ToString("N0")</div>
                <div class="metric-state">@(Model.CashBalance == 0 ? "Neutral cash position" : "Recorded inflows minus expenses")</div>
            </div>
        </div>
    </div>

    <section class="dashboard-section-heading">
        <div>
            <h2>Sales, Collections, and Receivables</h2>
            <p>Keep sales, actual collections, and open receivables clearly separated.</p>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Total Sales All Time</div>
                </div>
                <div class="metric-value">₱@Model.TotalSalesAllTime.ToString("N0")</div>
                <div class="metric-state">All recorded receipt sales</div>
                <div class="unpaid-cta">
                    <span class="unpaid-count">All records</span>
                    <a class="unpaid-link" href="@Url.Action("SummaryAll", "Orders", new { status = "All" })">View</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Collectibles Week</div>
                </div>
                <div class="metric-value">₱@Model.OutstandingReceivablesWeekly.ToString("N0")</div>
                <div class="metric-state">Weekly sales minus weekly payments</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Collected Revenue Month</div>
                </div>
                <div class="metric-value">₱@Model.CollectedRevenueMonthly.ToString("N0")</div>
                <div class="metric-state">Payments recorded this month</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Collected Revenue All Time</div>
                </div>
                <div class="metric-value">₱@Model.CollectedRevenueAllTime.ToString("N0")</div>
                <div class="metric-state">All recorded payment inflows</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Collectibles Month</div>
                </div>
                <div class="metric-value">₱@Model.OutstandingReceivablesMonthly.ToString("N0")</div>
                <div class="metric-state">Monthly sales minus monthly payments</div>
            </div>
        </div>
    </div>

    <section class="dashboard-section-heading">
        <div>
            <h2>Expense Breakdown</h2>
            <p>Expense totals grouped by your daily, weekly, monthly, and uncategorized records.</p>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Daily Expenses</div>
                </div>
                <div class="metric-value">₱@Model.DailyExpenseTotal.ToString("N0")</div>
                <div class="metric-state">Running total for daily expense categories</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Weekly Expenses</div>
                </div>
                <div class="metric-value">₱@Model.WeeklyExpenseTotal.ToString("N0")</div>
                <div class="metric-state">Running total for weekly expense categories</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Monthly Expenses</div>
                </div>
                <div class="metric-value">₱@Model.MonthlyExpenseTotal.ToString("N0")</div>
                <div class="metric-state">Running total for monthly expense categories</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="metric-card h-100">
                <div class="metric-head">
                    <div class="metric-label">Other Expenses</div>
                </div>
                <div class="metric-value">₱@Model.OtherExpenseTotal.ToString("N0")</div>
                <div class="metric-state">Expenses outside the preset schedule groups</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-graph-up me-2"></i> Sales Trend (Last 7 Days)</h6>
                    <span class="section-chip"><i class="bi bi-line-chart"></i> 7D</span>
                </div>
                <div class="surface-card-body">
                    <canvas id="salesChart" style="height: 300px; width: 100%;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-pie-chart-fill me-2"></i> Product Share</h6>
                    <span class="section-chip"><i class="bi bi-stars"></i> Top 5</span>
                </div>
                <div class="surface-card-body">
                    <div style="height: 250px; position: relative;">
                        <canvas id="itemsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-clock-history me-2"></i> Recent Unpaid Orders</h6>
                    <a href="@Url.Action("UnpaidOrders", "Orders")" class="dashboard-table-link">View All</a>
                </div>
                <div class="surface-card-body p-0 table-responsive-admin">
                    <table class="table table-admin table-hover mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th>Outlet</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentUnpaidOrders != null && Model.RecentUnpaidOrders.Any())
