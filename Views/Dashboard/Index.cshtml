                                @foreach (var order in Model.RecentUnpaidOrders)
                                {
                                    <tr class="table-row-link" onclick="window.location='/Orders/VegetableOutletOrder?id=@order.Id'">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-initial bg-danger text-white me-2 small" style="width:25px;height:25px;font-size:0.7rem">@order.CustomerName.Substring(0,1)</div>
                                                <div class="dashboard-table-name">@order.CustomerName</div>
                                            </div>
                                        </td>
                                        <td class="text-muted">@order.Date.ToString("MMM dd")</td>
                                        <td class="text-end dashboard-table-amount">@order.TotalAmount.ToString("N0")</td>
                                        <td class="text-end"><span class="badge badge-soft-danger">Unpaid</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No unpaid orders found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-check2-circle me-2"></i> Recent Paid Orders</h6>
                    <a href="@Url.Action("PaidOrders", "Orders")" class="dashboard-table-link">View All</a>
                </div>
                <div class="surface-card-body p-0 table-responsive-admin">
                    <table class="table table-admin table-hover mb-0 w-100">
                        <thead class="bg-light">
                            <tr>
                                <th>Outlet</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentPaidOrders != null && Model.RecentPaidOrders.Any())
                            {
                                @foreach (var order in Model.RecentPaidOrders)
                                {
                                    <tr class="table-row-link" onclick="window.location='/Orders/VegetableOutletOrder?id=@order.Id'">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-initial bg-success text-white me-2 small" style="width:25px;height:25px;font-size:0.7rem">@order.CustomerName.Substring(0,1)</div>
                                                <div class="dashboard-table-name">@order.CustomerName</div>
                                            </div>
                                        </td>
                                        <td class="text-muted">@order.Date.ToString("MMM dd")</td>
                                        <td class="text-end dashboard-table-amount">@order.TotalAmount.ToString("N0")</td>
                                        <td class="text-end"><span class="badge badge-soft-success">Paid</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">No paid orders found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-trophy me-2"></i> Top Selling Products</h6>
                    <span class="section-chip"><i class="bi bi-award"></i> Ranking</span>
                </div>
                <div class="surface-card-body p-0 table-responsive-admin">
                    <table class="table table-admin table-striped mb-0">
                        <thead><tr><th>Rank</th><th>Product</th><th class="text-end">Sales</th></tr></thead>
                        <tbody>
                            @if (Model.TopItems != null && Model.TopItems.Any())
                            {
                                int rank = 1;
                                foreach (var item in Model.TopItems)
                                {
                                    <tr>
                                        <td class="text-center text-muted" style="width:50px">#@(rank++)</td>
                                        <td class="dashboard-table-name text-dark">@item.Category</td>
                                        <td class="text-end dashboard-table-amount dashboard-table-amount-accent">₱@item.Value.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">No product sales yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="surface-card h-100">
                <div class="surface-card-header">
                    <h6 class="surface-card-title"><i class="bi bi-shop me-2"></i> Top Outlets (Sales)</h6>
                    <span class="section-chip"><i class="bi bi-graph-up"></i> Ranking</span>
                </div>
                <div class="surface-card-body p-0 table-responsive-admin">
                    <table class="table table-admin table-striped mb-0">
                        <thead><tr><th>Rank</th><th>Outlet</th><th class="text-end">Total Amount</th></tr></thead>
                        <tbody>
                            @if (Model.TopOutlets != null && Model.TopOutlets.Any())
                            {
                                int rank = 1;
                                foreach (var item in Model.TopOutlets)
                                {
                                    <tr>
                                        <td class="text-center text-muted" style="width:50px">#@(rank++)</td>
                                        <td class="dashboard-table-name text-dark">@item.Category</td>
                                        <td class="text-end dashboard-table-amount dashboard-table-amount-accent">₱@item.Value.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">No outlet sales yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (allowDangerousDatabaseReset)
    {
        <div class="row g-4 mt-4">
            <div class="col-12">
                <div class="surface-card border border-danger">
                    <div class="surface-card-header">
                        <h6 class="surface-card-title text-danger"><i class="bi bi-exclamation-octagon me-2"></i> Reset Database</h6>
                    </div>
                    <div class="surface-card-body">
                        @if (TempData["ResetSuccess"] != null)
                        {
                            <div class="alert alert-success py-2">@TempData["ResetSuccess"]</div>
                        }
                        @if (TempData["ResetError"] != null)
                        {
                            <div class="alert alert-danger py-2">@TempData["ResetError"]</div>
                        }
                        <p class="text-muted mb-2">This will delete sales, purchases, expenses, deductions, payroll, and related transactions. Products, outlets, suppliers, and weekly prices will be kept.</p>
                        <form asp-action="ResetDatabase" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <div class="col-md-4">
                                <input type="text" name="confirmText" id="resetConfirmInput" class="form-control" placeholder="Type RESET to confirm" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" id="resetConfirmBtn" class="btn btn-danger w-100" disabled>Reset Database</button>
                            </div>
                        </form>
                        <div class="small text-muted mt-2">This action cannot be undone.</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const saleCanvas = document.getElementById("salesChart");
        const itemCanvas = document.getElementById("itemsChart");
        if (!saleCanvas || !itemCanvas) return;

        const saleCtx = saleCanvas.getContext("2d");
        const salesDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySales.Select(d => d.Date.ToString("MMM dd"))));
        const salesValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailySales.Select(d => d.Value)));
        const normalizedSales = salesValues.map(v => Number(v));

        const minSales = normalizedSales.length ? Math.min(...normalizedSales) : 0;
        const maxSales = normalizedSales.length ? Math.max(...normalizedSales) : 0;
        const spread = Math.max(maxSales - minSales, 1);
        const suggestedMin = Math.max(0, minSales - (spread * 0.15));
        const suggestedMax = maxSales === 0 ? 10 : (maxSales + (spread * 0.2));

        const gradient = saleCtx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, "rgba(15, 118, 110, 0.24)");
        gradient.addColorStop(1, "rgba(15, 118, 110, 0.02)");

        new Chart(saleCtx, {
            type: "line",
            data: {
                labels: salesDates,
                datasets: [{
                    label: "Sales (₱)",
                    data: normalizedSales,
                    backgroundColor: gradient,
                    borderColor: "#0f766e",
                    borderWidth: 2.5,
                    pointRadius: 3.5,
                    pointHoverRadius: 6,
                    pointBackgroundColor: "#ffffff",
                    pointBorderColor: "#0f766e",
                    fill: true,
                    tension: 0.35
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: "index", intersect: false },
                animation: { duration: 650, easing: "easeOutQuart" },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: "rgba(15, 23, 42, 0.9)",
                        padding: 10,
                        callbacks: {
                            label: function(context) {
                                return "₱" + Number(context.parsed.y).toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: "#64748b" }
                    },
                    y: {
                        suggestedMin: suggestedMin,
                        suggestedMax: suggestedMax,
                        grid: { color: "rgba(148, 163, 184, 0.24)" },
                        ticks: {
                            color: "#64748b",
                            callback: function(value) {
                                return "₱" + Number(value).toLocaleString();
                            }
                        }
                    }
                }
            }
        });

        const itemCtx = itemCanvas.getContext("2d");
        const itemNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.TopItems ?? new List<HazelInvoice.ViewModels.CategoryValuePoint>()).Take(5).Select(i => i.Category)));
        const itemValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model?.TopItems ?? new List<HazelInvoice.ViewModels.CategoryValuePoint>()).Take(5).Select(i => i.Value)));
        const itemNumbers = itemValues.map(v => Number(v));

        new Chart(itemCtx, {
            type: "doughnut",
            plugins: [ChartDataLabels],
            data: {
                labels: itemNames,
                datasets: [{
                    data: itemNumbers,
                    backgroundColor: ["#0f766e", "#334155", "#94a3b8", "#f59e0b", "#dc2626"],
                    borderColor: "#ffffff",
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "62%",
                animation: { duration: 550, easing: "easeOutQuart" },
                plugins: {
                    legend: {
                        position: "right",
                        labels: { boxWidth: 12, usePointStyle: true, font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(c) {
                                return " " + c.label + ": ₱" + Number(c.parsed).toLocaleString();
                            }
                        }
                    },
                    datalabels: {
                        color: "#ffffff",
                        font: { weight: "700", size: 11 },
                        formatter: function(value, context) {
                            const total = context.dataset.data.reduce((sum, current) => sum + Number(current), 0);
                            if (!total || value <= 0) return "";
                            const percent = (Number(value) / total) * 100;
                            return percent < 4 ? "" : (percent.toFixed(0) + "%");
                        }
                    }
                }
            }
        });
    });
</script>

<script>
    (function () {
        const input = document.getElementById("resetConfirmInput");
        const btn = document.getElementById("resetConfirmBtn");
        if (!input || !btn) return;
        input.addEventListener("input", () => {
            const ok = input.value.trim().toUpperCase() === "RESET";
            btn.disabled = !ok;
        });
    })();
</script>
