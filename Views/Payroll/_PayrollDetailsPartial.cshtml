@using HazelInvoice.Models
@using HazelInvoice.Helpers
@model HazelInvoice.ViewModels.PayrollEntryDetailsViewModel

@{
    var balance = Model.RemainingBalance;
    var isRunClosed = Model.Entry.PayrollRun?.Status == PayrollRunStatus.Closed;
    var isRecordOnly = Model.Entry.RecordType == PayrollEntryRecordType.RecordOnly;
    var isPaid = Model.Entry.Status == PaymentStatus.Paid && Model.Entry.PaidAmount > 0;
    var displayStatus = isRecordOnly ? "Record Only" : Model.Entry.Status.ToString();
}

<div class="payroll-header payroll-modal-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
    <div>
        <h1>Payroll Details</h1>
        <div class="sub">@Model.Entry.Laborer?.FullName · @Model.Entry.PeriodStart.ToString("MMM dd, yyyy") - @Model.Entry.PeriodEnd.ToString("MMM dd, yyyy")</div>
        <div class="sub">Run: #@Model.Entry.PayrollRunId · @Model.Entry.PayrollRun?.Status · @displayStatus</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportPayslipCsv" asp-route-id="@Model.Entry.Id" class="btn btn-outline-secondary"><i class="bi bi-download"></i> Export CSV</a>
        <a asp-action="Index" class="btn btn-light text-dark fw-bold"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["PayrollError"] is string payrollError && !string.IsNullOrWhiteSpace(payrollError))
{
    <div class="alert alert-danger">@payrollError</div>
}
@if (TempData["PayrollSuccess"] is string payrollSuccess && !string.IsNullOrWhiteSpace(payrollSuccess))
{
    <div class="alert alert-success">@payrollSuccess</div>
}

<div class="payroll-summary payroll-modal-summary">
    <div class="payroll-kpi">
        <div class="label">Duty Days</div>
        <div class="value">@Model.Entry.TotalDays</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Gross Salary</div>
        <div class="value">₱@Model.Entry.GrossWage.ToString("N2")</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Total Deductions</div>
        <div class="value">₱@Model.Entry.TotalDeductions.ToString("N2")</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Total Additions</div>
        <div class="value">₱@Model.Entry.TotalAdditions.ToString("N2")</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Net Salary</div>
        <div class="value">₱@Model.Entry.NetPay.ToString("N2")</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Paid</div>
        <div class="value text-success">₱@Model.Entry.PaidAmount.ToString("N2")</div>
    </div>
    <div class="payroll-kpi danger">
        <div class="label">Balance</div>
        <div class="value">₱@balance.ToString("N2")</div>
    </div>
    <div class="payroll-kpi">
        <div class="label">Status</div>
        <div class="value">@displayStatus</div>
    </div>
</div>

<div class="row g-4 payroll-modal-layout">
    <div class="col-12">
        <div class="payroll-panel">
            <div class="card-header bg-light fw-bold">Attendance Breakdown</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 payroll-table">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Rate</th>
                                <th>Multiplier</th>
                                <th>Wage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.AttendanceRecords)
                            {
                                <tr>
                                    <td>@record.WorkDate.ToString("MMM dd, yyyy")</td>
                                    <td>@record.Status</td>
                                    <td class="payroll-money">₱@record.RateSnapshot.ToString("N2")</td>
                                    <td>@(record.Status == AttendanceStatus.Absent ? "0.00" : "1.00")</td>
                                    <td class="payroll-money">₱@record.WageAmount.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.AttendanceRecords.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No attendance records in this period.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="payroll-panel mb-3">
            <div class="card-header bg-light fw-bold">Record Payment</div>
            <div class="card-body">
                <form asp-action="AddPayment" method="post" class="payroll-modal-form payroll-form-grid" data-ajax="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PayrollEntryId" value="@Model.Entry.Id" />
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Date</label>
                        <input type="date" name="Date" class="form-control" value="@BusinessDate.Today().ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Amount</label>
                        <input type="number"
                               step="0.01"
                               name="Amount"
                               id="payrollAmount"
                               class="form-control"
                               required
                               placeholder="0.00" />
                        <button type="button"
                                class="btn btn-link btn-sm p-0 mt-1"
                                data-fill-balance-target="#payrollAmount"
                                data-balance-value="@balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                            Use full balance (₱@balance.ToString("N2"))
                        </button>
                    </div>
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Payment Method</label>
                        <select name="PaymentMethod" class="form-select">
                            @foreach (PaymentMethod method in Enum.GetValues(typeof(PaymentMethod)))
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                    </div>
                    <div class="payroll-form-field payroll-form-field-full">
                        <label class="form-label small fw-bold">Reference No</label>
                        <input type="text" name="ReferenceNo" class="form-control" placeholder="Optional" />
                    </div>
                    <div class="payroll-form-actions">
                        <button type="submit" class="btn btn-primary w-100" @(isRunClosed || isRecordOnly || isPaid ? "disabled" : null)>Save Payment</button>
                    </div>
                </form>
                @if (isRecordOnly)
                {
                    <div class="small text-muted mt-2">This is historical record-only payroll, so payment is intentionally disabled.</div>
                }
                @if (isRunClosed)
                {
                    <div class="small text-muted mt-2">This run is closed. Payment editing is disabled.</div>
                }
            </div>
        </div>

        <div class="payroll-panel mb-3">
            <div class="card-header bg-light fw-bold">Deductions &amp; Additions</div>
            <div class="card-body">
                <form asp-action="AddAdjustment" method="post" class="payroll-modal-form payroll-form-grid mb-3" data-ajax="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="payrollEntryId" value="@Model.Entry.Id" />
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Date</label>
                        <input type="date" name="date" class="form-control" value="@BusinessDate.Today().ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Type</label>
                        <select name="adjustmentType" class="form-select">
                            @foreach (var option in Model.AdjustmentOptions)
                            {
                                <option value="@option.Key">@option.Label @(option.IsDeduction ? "(Deduction)" : "(Addition)")</option>
                            }
                        </select>
                    </div>
                    <div class="payroll-form-field">
                        <label class="form-label small fw-bold">Amount</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="payroll-form-field payroll-form-field-full">
                        <label class="form-label small fw-bold">Note</label>
                        <input type="text" name="note" class="form-control" placeholder="Optional note" />
                    </div>
                    <div class="payroll-form-actions">
                        <button type="submit" class="btn btn-outline-primary w-100" @(isRunClosed || isRecordOnly || isPaid ? "disabled" : null)>Save Entry</button>
                    </div>
                </form>
                @if (isPaid)
                {
                    <div class="small text-muted mb-2">This payroll is already paid. Add deductions before recording payment.</div>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 payroll-table">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deduction in Model.AdvanceDeductions)
                            {
                                <tr>
                                    <td>@deduction.CashAdvance.Date.ToString("MMM dd")</td>
                                    <td class="payroll-money">-₱@deduction.DeductAmount.ToString("N2")</td>
                                    <td>Cash advance deduction</td>
                                </tr>
                            }
                            @foreach (var adjustment in Model.Adjustments)
                            {
                                var signedPrefix = adjustment.Type == AdjustmentType.Deduction ? "-₱" : "+₱";
                                <tr>
                                    <td>@adjustment.Date.ToString("MMM dd")</td>
                                    <td class="payroll-money">@signedPrefix@adjustment.Amount.ToString("N2")</td>
                                    <td>@adjustment.Reason</td>
                                </tr>
                            }
                            @if (!Model.Adjustments.Any() && !Model.AdvanceDeductions.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">No adjustments yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="payroll-panel">
            <div class="card-header bg-light fw-bold">Payment History</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 payroll-table">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>@payment.Date.ToString("MMM dd")</td>
                                    <td class="payroll-money">₱@payment.Amount.ToString("N2")</td>
                                    <td>@payment.PaymentMethod</td>
                                </tr>
                            }
                            @if (!Model.Payments.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">No payments recorded.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
