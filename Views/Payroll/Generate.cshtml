@model HazelInvoice.ViewModels.PayrollGenerateViewModel

@{
    ViewData["Title"] = "Generate Payroll";
    var selectableCount = Model.Rows.Count;
    var totalWage = Model.Rows.Sum(r => r.TotalWage);
    var hasExistingRun = Model.ExistingRunId.HasValue;
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Generate Payroll</h1>
            <div class="sub">Pick a weekly attendance range, uncheck anyone not ready, then create payroll periods.</div>
        </div>
        <a asp-action="Index" class="btn btn-light text-dark fw-bold"><i class="bi bi-arrow-left"></i> Back to Payroll</a>
    </div>

    <div class="payroll-summary">
        <div class="payroll-kpi">
            <div class="label">Laborers Ready</div>
            <div class="value">@selectableCount</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Attendance Week</div>
            <div class="value">@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd")</div>
        </div>
        <div class="payroll-kpi warn">
            <div class="label">Estimated Payroll</div>
            <div class="value">₱@totalWage.ToString("N2")</div>
        </div>
    </div>

    @if (TempData["PayrollError"] is string payrollError && !string.IsNullOrWhiteSpace(payrollError))
    {
        <div class="alert alert-danger">@payrollError</div>
    }
    @if (TempData["PayrollSuccess"] is string payrollSuccess && !string.IsNullOrWhiteSpace(payrollSuccess))
    {
        <div class="alert alert-success">@payrollSuccess</div>
    }

    <form method="get" class="row g-2 align-items-end payroll-filter" data-auto-submit="true">
        <div class="col-md-4">
            <label class="form-label small fw-bold">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <a asp-action="Generate" class="btn btn-outline-secondary w-100">Reset to Default Range</a>
        </div>
    </form>

    <div class="payroll-filter d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="payroll-inline-note">
            Only attendance not already included in payroll can be generated here.
        </div>
        @if (hasExistingRun && Model.ExistingRunStatus.HasValue)
        {
            <span class="badge bg-dark">Run #@Model.ExistingRunId · @Model.ExistingRunStatus</span>
        }
    </div>

    <form asp-action="Generate" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StartDate" />
        <input type="hidden" asp-for="EndDate" />

        <div class="payroll-table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 payroll-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width:48px;">
                                    <input type="checkbox" id="selectAllLaborers" data-select-all-target=".laborer-check" />
                                </th>
                                <th>Laborer</th>
                                <th>Total Days</th>
                                <th>Total Wage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               class="laborer-check"
                                               name="SelectedLaborerIds"
                                               value="@row.LaborerId"
                                               @(Model.SelectedLaborerIds.Contains(row.LaborerId) ? "checked" : "") />
                                    </td>
                                    <td class="fw-bold">@row.LaborerName</td>
                                    <td>@row.TotalDays</td>
                                    <td class="payroll-money">₱@row.TotalWage.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.Rows.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No attendance records available for payroll generation.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="payroll-inline-note">Period: @Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</div>
                <button type="submit"
                        class="btn btn-primary"
                        @((Model.Rows.Any() && !hasExistingRun) ? null : "disabled")>
                    Create Payroll Periods
                </button>
            </div>
        </div>
    </form>
</div>

<script src="~/js/payroll.js" asp-append-version="true"></script>
