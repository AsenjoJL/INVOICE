@model HazelInvoice.ViewModels.CreatePayrollRunViewModel

@{
    ViewData["Title"] = "Generate Payroll";
    var selectableCount = Model.Preview.Count;
    var totalWage = Model.Preview.Sum(r => r.GrossWage);
    var totalDeductions = Model.Preview.Sum(r => r.PendingAdvanceDeductions);
    var estimatedNetPay = Model.Preview.Sum(r => r.NetPay);
    var hasExistingRun = Model.HasExistingRun;
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Generate Payroll</h1>
            <div class="sub">Pick a weekly attendance range, review the payroll preview, then create a payroll run.</div>
        </div>
        <a asp-action="Index" class="btn btn-light text-dark fw-bold"><i class="bi bi-arrow-left"></i> Back to Payroll</a>
    </div>

    <div class="payroll-summary">
        <div class="payroll-kpi">
            <div class="label">Laborers Ready</div>
            <div class="value">@selectableCount</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Attendance Week</div>
            <div class="value">@Model.WeekStart.ToString("MMM dd") - @Model.WeekEnd.ToString("MMM dd")</div>
        </div>
        <div class="payroll-kpi warn">
            <div class="label">Gross Payroll</div>
            <div class="value">₱@totalWage.ToString("N2")</div>
        </div>
        <div class="payroll-kpi danger">
            <div class="label">Advance Deductions</div>
            <div class="value">₱@totalDeductions.ToString("N2")</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Estimated Net Pay</div>
            <div class="value">₱@estimatedNetPay.ToString("N2")</div>
        </div>
    </div>

    @if (TempData["PayrollError"] is string payrollError && !string.IsNullOrWhiteSpace(payrollError))
    {
        <div class="alert alert-danger">@payrollError</div>
    }
    @if (TempData["PayrollSuccess"] is string payrollSuccess && !string.IsNullOrWhiteSpace(payrollSuccess))
    {
        <div class="alert alert-success">@payrollSuccess</div>
    }

    <form method="get" class="row g-2 align-items-end payroll-filter" data-auto-submit="true">
        <div class="col-md-4">
            <label class="form-label small fw-bold">Start Date</label>
            <input type="date" name="weekStart" class="form-control" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-secondary w-100">Reload Week</button>
        </div>
    </form>

    <div class="payroll-filter d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="payroll-inline-note">
            Only attendance not already included in payroll can be generated here.
        </div>
        @if (hasExistingRun)
        {
            <span class="badge bg-dark">Payroll run already exists for this week</span>
        }
    </div>

    <form asp-action="CreateRun" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />

        <div class="payroll-table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 payroll-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width:48px;"></th>
                                <th>Laborer</th>
                                <th>Total Days</th>
                                <th>Gross Salary</th>
                                <th>Advance Deductions</th>
                                <th>Estimated Net Pay</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Preview.Count; i++)
                            {
                                var row = Model.Preview[i];
                                <tr>
                                    <td>
                                        <input type="checkbox" class="laborer-check" checked disabled />
                                    </td>
                                    <td class="fw-bold">@row.LaborerName</td>
                                    <td>@row.TotalDays</td>
                                    <td class="payroll-money">₱@row.GrossWage.ToString("N2")</td>
                                    <td class="payroll-money">₱@row.PendingAdvanceDeductions.ToString("N2")</td>
                                    <td class="payroll-money">₱@row.NetPay.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.Preview.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No attendance records available for payroll generation.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="payroll-inline-note">Period: @Model.WeekStart.ToString("MMM dd, yyyy") - @Model.WeekEnd.ToString("MMM dd, yyyy")</div>
                <button type="submit" class="btn btn-primary" @(Model.Preview.Any() && !hasExistingRun ? null : "disabled")>
                    Create Payroll Run
                </button>
            </div>
        </div>
    </form>

    <div class="payroll-table-card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                <div>
                    <h2 class="h5 mb-1">Historical Payroll Backfill</h2>
                    <div class="payroll-inline-note">
                        Creates missing payroll from attendance only. Existing generated periods are skipped safely.
                    </div>
                </div>
                <span class="badge bg-light text-dark">Jan-Feb record only · Mar-May 16 paid · May 18+ unpaid</span>
            </div>

            <form asp-action="CreateHistoricalRuns" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@Model.HistoricalStartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@Model.HistoricalEndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Record Only Through</label>
                    <input type="date" name="recordOnlyThrough" class="form-control" value="@Model.RecordOnlyThrough.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Paid Through</label>
                    <input type="date" name="paidThrough" class="form-control" value="@Model.PaidThrough.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Unpaid From</label>
                    <input type="date" name="unpaidFrom" class="form-control" value="@Model.UnpaidFrom.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-dark w-100">
                        Create Historical Payroll
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/payroll.js" asp-append-version="true"></script>
