@using HazelInvoice.Models
@model HazelInvoice.ViewModels.PayrollIndexViewModel

@{
    ViewData["Title"] = "Payroll";
    var statusValue = Model.Status?.ToString() ?? "";
    var startDate = Model.StartDate;
    var endDate = Model.EndDate;
    var totalEntries = Model.TotalEntries;
    var unpaidCount = Model.UnpaidCount;
    var totalBalance = Model.TotalBalance;
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap admin-page-hero admin-page-hero-soft">
        <div>
            <div class="admin-section-kicker">Workforce Finance</div>
            <h1>Payroll</h1>
            <div class="sub">Simple weekly flow: attendance, salary, deductions, then payment.</div>
            <div class="payroll-steps">
                <span class="payroll-step">1. Attendance</span>
                <span class="payroll-step">2. Generate</span>
                <span class="payroll-step">3. Deduct</span>
                <span class="payroll-step">4. Pay</span>
            </div>
        </div>
        <a asp-action="Generate" class="btn admin-action-btn"><i class="bi bi-magic"></i> Generate Payroll</a>
    </div>

    @if (TempData["PayrollError"] is string payrollError && !string.IsNullOrWhiteSpace(payrollError))
    {
        <div class="alert alert-danger">@payrollError</div>
    }
    @if (TempData["PayrollSuccess"] is string payrollSuccess && !string.IsNullOrWhiteSpace(payrollSuccess))
    {
        <div class="alert alert-success">@payrollSuccess</div>
    }

    <div class="payroll-summary admin-summary-grid">
        <div class="payroll-kpi">
            <div class="label">Payroll Entries</div>
            <div class="value">@totalEntries</div>
        </div>
        <div class="payroll-kpi warn">
            <div class="label">Unpaid Periods</div>
            <div class="value">@unpaidCount</div>
        </div>
        <div class="payroll-kpi danger">
            <div class="label">Outstanding Balance</div>
            <div class="value">₱@totalBalance.ToString("N2")</div>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end payroll-filter admin-filter-strip" data-auto-submit="true">
        <div class="col-md-3">
            <label class="form-label small fw-bold">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@(startDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@(endDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                @foreach (PaymentStatus s in Enum.GetValues(typeof(PaymentStatus)))
                {
                    <option value="@s" selected="@(statusValue == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Page Size</label>
            <select name="pageSize" class="form-select">
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            @if (startDate.HasValue || endDate.HasValue || !string.IsNullOrWhiteSpace(statusValue) || Model.PageSize != 25)
            {
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset Filters</a>
            }
            else
            {
                <div class="payroll-inline-note">Filters apply automatically when changed.</div>
            }
        </div>
    </form>

    <div class="payroll-table-card admin-surface-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 payroll-table">
                    <thead class="table-light">
                        <tr>
                            <th>Laborer</th>
                            <th>Period</th>
                            <th>Run</th>
                            <th>Duty Days</th>
                            <th>Gross Salary</th>
                            <th>Deductions</th>
                            <th>Additions</th>
                            <th>Net Salary</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var payable = entry.NetPay;
                            var balance = entry.NetPay - entry.PaidAmount;
                            <tr data-row-link="@Url.Action("Details", new { id = entry.Id })">
                                <td class="fw-bold">@entry.Laborer?.FullName</td>
                                <td>@entry.PeriodStart.ToString("MMM dd, yyyy") - @entry.PeriodEnd.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (entry.PayrollRunId > 0)
                                    {
                                        <span class="badge bg-dark">#@entry.PayrollRunId</span>
                                        <span class="small text-muted ms-1">(@entry.PayrollRun?.Status)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">legacy</span>
                                    }
                                </td>
                                <td>@entry.TotalDays</td>
                                <td class="payroll-money">₱@entry.GrossWage.ToString("N2")</td>
                                <td class="payroll-money">₱@entry.TotalDeductions.ToString("N2")</td>
                                <td class="payroll-money">₱@entry.TotalAdditions.ToString("N2")</td>
                                <td class="payroll-money">₱@payable.ToString("N2")</td>
                                <td class="payroll-money text-success">₱@entry.PaidAmount.ToString("N2")</td>
                                <td class="payroll-money text-danger">₱@balance.ToString("N2")</td>
                                <td>
                                    @if (entry.Status == PaymentStatus.Paid)
                                    {
                                        <span class="payroll-status paid">Paid</span>
                                    }
                                    else if (entry.Status == PaymentStatus.Partial)
                                    {
                                        <span class="payroll-status partial">Partial</span>
                                    }
                                    else
                                    {
                                        <span class="payroll-status unpaid">Unpaid</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-payroll-details-id="@entry.Id"
                                            data-bs-toggle="modal"
                                            data-bs-target="#payrollDetailsModal"
                                            aria-label="View payroll details">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Entries.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">No payroll entries found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="mt-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages · Showing @Model.Entries.Count of @Model.TotalEntries filtered entries</div>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-startDate="@(startDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(endDate?.ToString("yyyy-MM-dd"))"
                   asp-route-status="@statusValue"
                   asp-route-page="@(Math.Max(1, Model.CurrentPage - 1))"
                   asp-route-pageSize="@Model.PageSize">Prev</a>
                <a class="btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-startDate="@(startDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(endDate?.ToString("yyyy-MM-dd"))"
                   asp-route-status="@statusValue"
                   asp-route-page="@(Math.Min(Model.TotalPages, Model.CurrentPage + 1))"
                   asp-route-pageSize="@Model.PageSize">Next</a>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="payrollDetailsModal" tabindex="-1" aria-labelledby="payrollDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="payrollDetailsModalLabel">Payroll Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-5 text-muted" id="payrollDetailsModalLoading">Loading details…</div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/payroll.js" asp-append-version="true"></script>
