@using HazelInvoice.Models
@model HazelInvoice.ViewModels.PayrollDetailsViewModel

@{
    ViewData["Title"] = "Payroll Details";
    var balance = Model.RemainingBalance;
    var isRunClosed = Model.Period.PayrollRun?.Status == PayrollRunStatus.Closed;
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />

<div class="container-fluid p-4 payroll-page">
    <div class="payroll-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Payroll Details</h1>
            <div class="sub">@Model.Period.Laborer?.FullName · @Model.Period.PeriodStart.ToString("MMM dd, yyyy") - @Model.Period.PeriodEnd.ToString("MMM dd, yyyy")</div>
            <div class="sub">Run: #@Model.Period.PayrollRunId · @Model.Period.PayrollRun?.Status</div>
        </div>
        <a asp-action="Index" class="btn btn-light text-dark fw-bold"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    @if (TempData["PayrollError"] is string payrollError && !string.IsNullOrWhiteSpace(payrollError))
    {
        <div class="alert alert-danger">@payrollError</div>
    }
    @if (TempData["PayrollSuccess"] is string payrollSuccess && !string.IsNullOrWhiteSpace(payrollSuccess))
    {
        <div class="alert alert-success">@payrollSuccess</div>
    }

    <div class="payroll-summary">
        <div class="payroll-kpi">
            <div class="label">Total Wage</div>
            <div class="value">₱@Model.Period.TotalWage.ToString("N2")</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Adjustments</div>
            <div class="value">₱@Model.Period.AdjustmentTotal.ToString("+#,##0.00;-#,##0.00;0.00")</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Payable Total</div>
            <div class="value">₱@Model.PayableTotal.ToString("N2")</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Paid</div>
            <div class="value text-success">₱@Model.Period.PaidAmount.ToString("N2")</div>
        </div>
        <div class="payroll-kpi danger">
            <div class="label">Balance</div>
            <div class="value">₱@balance.ToString("N2")</div>
        </div>
        <div class="payroll-kpi">
            <div class="label">Status</div>
            <div class="value">@Model.Period.Status</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="payroll-panel">
                <div class="card-header bg-light fw-bold">Attendance Breakdown</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 payroll-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Rate</th>
                                    <th>Multiplier</th>
                                    <th>Wage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.AttendanceRecords)
                                {
                                    <tr>
                                        <td>@record.WorkDate.ToString("MMM dd, yyyy")</td>
                                        <td>@record.Status</td>
                                        <td class="payroll-money">₱@record.RateSnapshot.ToString("N2")</td>
                                        <td>@record.Multiplier.ToString("0.00")</td>
                                        <td class="payroll-money">₱@record.WageAmount.ToString("N2")</td>
                                    </tr>
                                }
                                @if (!Model.AttendanceRecords.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No attendance records in this period.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="payroll-panel mb-3">
                <div class="card-header bg-light fw-bold">Record Payment</div>
                <div class="card-body">
                    <form asp-action="AddPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PayrollPeriodId" value="@Model.Period.Id" />
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Date</label>
                            <input type="date" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Amount</label>
                            <input type="number"
                                   step="0.01"
                                   name="Amount"
                                   id="payrollAmount"
                                   class="form-control"
                                   required
                                   placeholder="0.00" />
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 mt-1"
                                    data-fill-balance-target="#payrollAmount"
                                    data-balance-value="@balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                Use full balance (₱@balance.ToString("N2"))
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Payment Method</label>
                            <select name="PaymentMethod" class="form-select">
                                @foreach (PaymentMethod method in Enum.GetValues(typeof(PaymentMethod)))
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Reference No</label>
                            <input type="text" name="ReferenceNo" class="form-control" placeholder="Optional" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100" @(isRunClosed ? "disabled" : null)>Save Payment</button>
                    </form>
                    @if (isRunClosed)
                    {
                        <div class="small text-muted mt-2">This run is closed. Payment editing is disabled.</div>
                    }
                </div>
            </div>

            <div class="payroll-panel mb-3">
                <div class="card-header bg-light fw-bold">Adjustments</div>
                <div class="card-body">
                    <form asp-action="AddAdjustment" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="payrollPeriodId" value="@Model.Period.Id" />
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Date</label>
                            <input type="date" name="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Amount (+/-)</label>
                            <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Reason</label>
                            <input type="text" name="reason" class="form-control" placeholder="Why this adjustment?" />
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100" @(isRunClosed ? "disabled" : null)>Save Adjustment</button>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 payroll-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adjustment in Model.Adjustments)
                                {
                                    <tr>
                                        <td>@adjustment.Date.ToString("MMM dd")</td>
                                        <td class="payroll-money">₱@adjustment.Amount.ToString("+#,##0.00;-#,##0.00;0.00")</td>
                                        <td>@adjustment.Reason</td>
                                    </tr>
                                }
                                @if (!Model.Adjustments.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">No adjustments yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="payroll-panel">
                <div class="card-header bg-light fw-bold">Payment History</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 payroll-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Method</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.Date.ToString("MMM dd")</td>
                                        <td class="payroll-money">₱@payment.Amount.ToString("N2")</td>
                                        <td>@payment.PaymentMethod</td>
                                    </tr>
                                }
                                @if (!Model.Payments.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No payments recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/payroll.js" asp-append-version="true"></script>
