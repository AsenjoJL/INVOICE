@using HazelInvoice.Models
@model HazelInvoice.ViewModels.PayrollDetailsViewModel

@{
    ViewData["Title"] = "Payroll Details";
    ViewData["NotePurpose"] = "Review payroll breakdown and record payments.";
    ViewData["NoteInstructions"] = "Payments update status automatically: Unpaid, Partial, Paid.";
    var balance = Model.RemainingBalance;
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Payroll Details</h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <partial name="_PageNote" />

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-bold">LABORER</div>
                    <div class="fs-4 fw-bold">@Model.Period.Laborer?.FullName</div>
                    <div class="text-muted">@Model.Period.PeriodStart.ToString("MMM dd, yyyy") - @Model.Period.PeriodEnd.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-bold">TOTAL WAGE</div>
                    <div class="fs-5 fw-bold">₱@Model.Period.TotalWage.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-bold">PAID</div>
                    <div class="fs-5 fw-bold text-success">₱@Model.Period.PaidAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-bold">BALANCE</div>
                    <div class="fs-5 fw-bold text-danger">₱@balance.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-bold">STATUS</div>
                    <div class="fs-5 fw-bold">@Model.Period.Status</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow border-0">
                <div class="card-header bg-light fw-bold">Attendance Breakdown</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Rate</th>
                                    <th>Multiplier</th>
                                    <th>Wage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.AttendanceRecords)
                                {
                                    <tr>
                                        <td>@record.WorkDate.ToString("MMM dd, yyyy")</td>
                                        <td>@record.Status</td>
                                        <td>₱@record.RateSnapshot.ToString("N2")</td>
                                        <td>@record.Multiplier.ToString("0.00")</td>
                                        <td>₱@record.WageAmount.ToString("N2")</td>
                                    </tr>
                                }
                                @if (!Model.AttendanceRecords.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No attendance records in this period.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow border-0 mb-3">
                <div class="card-header bg-light fw-bold">Record Payment</div>
                <div class="card-body">
                    <form asp-action="AddPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PayrollPeriodId" value="@Model.Period.Id" />
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Date</label>
                            <input type="date" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Amount</label>
                            <input type="number" step="0.01" name="Amount" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Payment Method</label>
                            <select name="PaymentMethod" class="form-select">
                                @foreach (PaymentMethod method in Enum.GetValues(typeof(PaymentMethod)))
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Reference No</label>
                            <input type="text" name="ReferenceNo" class="form-control" placeholder="Optional" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Save Payment</button>
                    </form>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-light fw-bold">Payment History</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Method</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.Date.ToString("MMM dd")</td>
                                        <td>₱@payment.Amount.ToString("N2")</td>
                                        <td>@payment.PaymentMethod</td>
                                    </tr>
                                }
                                @if (!Model.Payments.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No payments recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
