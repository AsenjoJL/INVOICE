@model HazelInvoice.Models.Laborer

@{
    ViewData["Title"] = "Add Laborer";
}

<partial name="_WorkforceStyles" />

<div class="container p-4 workforce-page">
    <div class="workforce-form-shell">
        <div class="card workforce-form-card">
            <div class="card-header workforce-form-header">
                <h4 class="mb-0">Add Laborer</h4>
            </div>
            <div class="card-body workforce-form-body workforce-form">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                <label asp-for="FullName">Full Name</label>
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Code" class="form-control" placeholder="Code" />
                                <label asp-for="Code">Code (Optional)</label>
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="DailyRate" class="form-control" placeholder="Daily Rate" />
                                <label asp-for="DailyRate">Daily Rate</label>
                                <span asp-validation-for="DailyRate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Role" class="form-control" placeholder="Role" />
                                <label asp-for="Role">Role (Optional)</label>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="HiredDate" class="form-control" type="date" />
                                <label asp-for="HiredDate">Hired Date</label>
                                <span asp-validation-for="HiredDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
                                <label asp-for="ContactNumber">Contact Number (Optional)</label>
                                <span asp-validation-for="ContactNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Address" class="form-control" placeholder="Address" />
                                <label asp-for="Address">Address (Optional)</label>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Notes" class="form-control" placeholder="Notes" style="height: 90px;"></textarea>
                        <label asp-for="Notes">Notes (Optional)</label>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">Is Active?</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn workforce-btn workforce-btn-primary btn-lg">Save Laborer</button>
                        <a asp-action="Index" class="btn workforce-btn workforce-btn-neutral">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
