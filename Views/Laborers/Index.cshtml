@model IEnumerable<HazelInvoice.Models.Laborer>

@{
    ViewData["Title"] = "Laborers";
    ViewData["NotePurpose"] = "Manage laborers and daily wage rates.";
    ViewData["NoteInstructions"] = "Archive laborers instead of deleting to keep payroll history intact.";
    var showArchived = (bool?)ViewData["ShowArchived"] ?? false;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<partial name="_WorkforceStyles" />

<div class="container-fluid p-4 workforce-page">
    <div class="workforce-header">
        <div>
            <h1 class="workforce-title">Laborers</h1>
            <div class="workforce-sub">Manage laborers and daily wage rates.</div>
        </div>
        <a asp-action="Create" class="btn workforce-btn workforce-btn-primary"><i class="bi bi-plus-lg"></i> Add Laborer</a>
    </div>

    <partial name="_PageNote" />

    <form method="get" class="workforce-filter">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="showArchived" value="true" id="showArchived" @(showArchived ? "checked" : "") />
            <label class="form-check-label" for="showArchived">Show Archived</label>
        </div>
        <button type="submit" class="btn workforce-btn workforce-btn-neutral btn-sm">Apply</button>
    </form>

    <div class="card workforce-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle workforce-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Daily Rate</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var laborer in Model)
                        {
                            <tr class="laborer-row" data-id="@laborer.Id">
                                <td class="fw-bold">@laborer.FullName</td>
                                <td class="workforce-money">₱@laborer.DailyRate.ToString("N2")</td>
                                <td>@laborer.Role</td>
                                <td>
                                    @if (laborer.IsActive)
                                    {
                                        <span class="workforce-status workforce-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="workforce-status workforce-status-archived">Archived</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@laborer.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm workforce-btn workforce-btn-neutral laborers-return-link" data-laborer-id="@laborer.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (laborer.IsActive)
                                    {
                                        <form asp-action="Archive" method="post" class="d-inline laborers-return-form" data-laborer-id="@laborer.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@laborer.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <input type="hidden" name="returnScrollY" class="laborers-return-scroll" value="0" />
                                            <button type="submit" class="btn btn-sm workforce-btn btn-outline-danger ms-1">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate" method="post" class="d-inline laborers-return-form" data-laborer-id="@laborer.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@laborer.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <input type="hidden" name="returnScrollY" class="laborers-return-scroll" value="0" />
                                            <button type="submit" class="btn btn-sm workforce-btn btn-outline-success ms-1">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No laborers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/laborers-index.js" asp-append-version="true"></script>
}
