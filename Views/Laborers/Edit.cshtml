@model HazelInvoice.Models.Laborer

@{
    ViewData["Title"] = "Edit Laborer";
}

<div class="container p-4">
    <div class="card shadow border-0" style="max-width: 760px; margin: 0 auto;">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Edit Laborer</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-2 mb-3">
                    <div class="col-md-8">
                        <div class="form-floating">
                            <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                            <label asp-for="FullName">Full Name</label>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="Code" class="form-control" placeholder="Code" />
                            <label asp-for="Code">Code (Optional)</label>
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="DailyRate" class="form-control" placeholder="Daily Rate" />
                            <label asp-for="DailyRate">Daily Rate</label>
                            <span asp-validation-for="DailyRate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="Role" class="form-control" placeholder="Role" />
                            <label asp-for="Role">Role (Optional)</label>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="HiredDate" class="form-control" type="date" />
                            <label asp-for="HiredDate">Hired Date</label>
                            <span asp-validation-for="HiredDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
                            <label asp-for="ContactNumber">Contact Number (Optional)</label>
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Address" class="form-control" placeholder="Address" />
                            <label asp-for="Address">Address (Optional)</label>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <textarea asp-for="Notes" class="form-control" placeholder="Notes" style="height: 90px;"></textarea>
                    <label asp-for="Notes">Notes (Optional)</label>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" asp-for="IsActive">Is Active?</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-secondary btn-lg">Save Changes</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
