@model IEnumerable<HazelInvoice.Models.Customer>

@{
    ViewData["Title"] = "Outlets";
    ViewData["NotePurpose"] = "Maintain outlet records used in vegetable orders and sales.";
    ViewData["NoteInstructions"] = "Only outlets assigned to active client groups appear in the vegetable order matrix.";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<partial name="_OutletStyles" />

<style>
    .outlet-table tbody tr.outlet-row-highlight td {
        background: rgba(59, 130, 246, 0.08);
        transition: background-color 0.2s ease;
    }
</style>

<div class="container-fluid p-4 outlet-page">
    <div class="outlet-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 admin-page-hero admin-page-hero-soft">
        <div>
            <div class="admin-section-kicker">Directory</div>
            <h1>Outlet Directory</h1>
            <div class="sub">Maintain outlet records used in vegetable orders and sales.</div>
        </div>
        <div class="outlet-actions">
            <a asp-controller="ClientGroups" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-diagram-3"></i> Client Groups</a>
            <a asp-action="Create" class="btn admin-action-btn"><i class="bi bi-plus-lg"></i> Add Outlet</a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="outlet-card admin-surface-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table outlet-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Outlet</th>
                            <th>Group</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="outlet-row" data-id="@item.Id">
                                <td>
                                    <div class="outlet-name">@item.Name</div>
                                    <div class="outlet-meta">@(!string.IsNullOrWhiteSpace(item.SubLabel) ? item.SubLabel : "No sub label")</div>
                                </td>
                                <td>
                                    <span class="group-pill"><i class="bi bi-diagram-3"></i> @item.GroupName</span>
                                </td>
                                <td>
                                    <div class="outlet-meta">@(!string.IsNullOrWhiteSpace(item.ContactPerson) ? item.ContactPerson : "No contact person")</div>
                                    <div class="outlet-meta">@(!string.IsNullOrWhiteSpace(item.ContactNumber) ? item.ContactNumber : "No contact number")</div>
                                </td>
                                <td class="outlet-meta">@(!string.IsNullOrWhiteSpace(item.Address) ? item.Address : "No address")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-pill status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="outlet-actions-row d-flex gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="@returnUrl"
                                           class="btn btn-sm btn-outline-primary outlet-return-link"
                                           data-outlet-id="@item.Id"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           asp-route-returnUrl="@returnUrl"
                                           class="btn btn-sm btn-outline-danger outlet-return-link"
                                           data-outlet-id="@item.Id"
                                           title="Deactivate">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/js/outlets-index.js" asp-append-version="true"></script>
