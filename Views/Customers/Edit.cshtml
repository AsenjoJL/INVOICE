@model HazelInvoice.Models.Customer

@{
    ViewData["Title"] = "Edit Outlet";
    var groupOptions = ViewBag.OutletGroups as string[] ?? Array.Empty<string>();
}

<partial name="_OutletStyles" />

<div class="container outlet-page py-4">
    <div class="outlet-form-shell">
        <div class="outlet-form-card">
            <div class="outlet-form-banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="outlet-form-kicker">Outlet Setup</div>
                        <h4>Update Outlet</h4>
                        <p class="subtitle">Keep contact and group details accurate for reporting.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-light text-dark"><i class="bi bi-arrow-left"></i> Back</a>
                </div>
            </div>

            <div class="outlet-form-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="outlet-form-section">
                        <div class="section-title">Basics</div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Outlet Name" />
                                    <label asp-for="Name">Outlet Name</label>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="SubLabel" class="form-control" placeholder="Sub Label" />
                                    <label asp-for="SubLabel">Sub Label (Optional)</label>
                                    <span asp-validation-for="SubLabel" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="GroupName" class="form-control" list="groupOptions" placeholder="Group Name" />
                            <label asp-for="GroupName">Group Name</label>
                            <datalist id="groupOptions">
                                @foreach (var g in groupOptions)
                                {
                                    <option value="@g"></option>
                                }
                            </datalist>
                            <span asp-validation-for="GroupName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="outlet-form-section">
                        <div class="section-title">Contact</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ContactPerson" class="form-control" placeholder="Contact Person" />
                                    <label asp-for="ContactPerson">Contact Person (Optional)</label>
                                    <span asp-validation-for="ContactPerson" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
                                    <label asp-for="ContactNumber">Contact Number (Optional)</label>
                                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mt-3">
                            <input asp-for="Address" class="form-control" placeholder="Address" />
                            <label asp-for="Address">Address (Optional)</label>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="outlet-form-section">
                        <div class="section-title">Status</div>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Active in orders</label>
                        </div>
                    </div>

                    <div class="outlet-form-section outlet-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
