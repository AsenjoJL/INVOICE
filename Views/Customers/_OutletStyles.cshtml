<style>
    .outlet-page {
        --outlet-line: #e8e8e8;
        --outlet-text: #0a0a0a;
        --outlet-muted: #888888;
        font-family: 'DM Sans', sans-serif;
        color: var(--outlet-text);
    }

    .outlet-header {
        padding: 0 0 20px !important;
        margin-bottom: 24px;
        background: transparent !important;
        border: 0 !important;
        border-bottom: 1px solid var(--outlet-line) !important;
        border-radius: var(--ui-radius-xl) !important;
        box-shadow: none !important;
    }

    .outlet-header h1,
    .outlet-form-banner h4,
    .outlet-delete-header h4 {
        margin: 8px 0 4px;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--outlet-text);
    }

    .outlet-header .sub,
    .outlet-form-banner .subtitle {
        margin: 0;
        font-size: 15px;
        color: var(--outlet-muted);
    }

    .outlet-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .outlet-card,
    .outlet-form-card,
    .outlet-form-section,
    .outlet-delete-card,
    .group-pill,
    .status-pill {
        background: #ffffff;
        border: 1px solid var(--outlet-line);
        border-radius: var(--ui-radius-md);
        box-shadow: none;
    }

    .outlet-card {
        overflow: hidden;
    }

    .outlet-table {
        margin-bottom: 0;
    }

    .outlet-table th {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--outlet-muted);
        background: #ffffff;
        border-bottom: 1px solid var(--outlet-line);
        padding: 14px 16px;
    }

    .outlet-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--outlet-line);
        font-size: 14px;
        color: var(--outlet-text);
        vertical-align: middle;
    }

    .outlet-table tbody tr:hover td {
        background: #fafafa;
    }

    .outlet-name {
        font-size: 15px;
        font-weight: 500;
    }

    .outlet-meta {
        margin-top: 4px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--outlet-muted);
    }

    .group-pill,
    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        font-family: 'DM Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--outlet-text);
    }

    .group-pill i,
    .status-pill::before {
        display: none;
    }

    .outlet-actions-row {
        display: flex;
        gap: 8px;
    }

    .outlet-actions-row .btn,
    .outlet-btn-danger,
    .outlet-btn-neutral,
    .outlet-form-actions .btn,
    .outlet-form-banner .btn {
        border-radius: var(--ui-radius-md);
        box-shadow: none;
    }

    .outlet-form-shell {
        max-width: 820px;
        margin: 0 auto;
    }

    .outlet-form-card {
        overflow: hidden;
    }

    .outlet-form-card.is-saving {
        opacity: 0.82;
        transform: translateY(1px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .outlet-save-alert {
        animation: outletSaveReveal 0.28s ease both;
        border-radius: var(--ui-radius-md);
    }

    .outlet-save-spinner {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.45);
        border-top-color: #ffffff;
        border-radius: 999px;
        display: inline-block;
        margin-right: 8px;
        vertical-align: -2px;
        animation: outletSpin 0.7s linear infinite;
    }

    @@keyframes outletSpin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes outletSaveReveal {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .outlet-form-banner,
    .outlet-delete-header {
        padding: 18px 20px;
        background: #ffffff;
        border-bottom: 1px solid var(--outlet-line);
    }

    .outlet-form-kicker,
    .outlet-form-section .section-title {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--outlet-muted);
    }

    .outlet-form-body,
    .outlet-delete-body {
        padding: 20px;
        background: #ffffff;
    }

    .outlet-form-section {
        padding: 18px 20px;
        margin-bottom: 14px;
    }

    .outlet-form-card .form-control,
    .outlet-form-card .form-select {
        border-radius: var(--ui-radius-md);
        border-color: var(--outlet-line);
        box-shadow: none;
    }

    .outlet-form-card .form-control:focus,
    .outlet-form-card .form-select:focus {
        border-color: #d4d4d4;
        box-shadow: none;
    }

    .outlet-form-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .outlet-form-actions .btn-primary,
    .outlet-btn-danger {
        background: #0a0a0a;
        border: 1px solid #0a0a0a;
        color: #ffffff;
    }

    .outlet-form-actions .btn-outline-secondary,
    .outlet-btn-neutral,
    .outlet-form-banner .btn {
        background: #ffffff;
        border: 1px solid var(--outlet-line);
        color: var(--outlet-text);
    }

    .outlet-delete-meta dt {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--outlet-muted);
    }

    .outlet-delete-meta dd {
        color: var(--outlet-text);
    }

    @@media (max-width: 768px) {
        .outlet-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .outlet-form-body,
        .outlet-delete-body {
            padding: 18px;
        }

        .outlet-form-banner,
        .outlet-delete-header {
            padding: 18px;
        }
    }

    .outlet-header,
    .outlet-card,
    .outlet-form-card,
    .outlet-form-section,
    .outlet-delete-card {
        border-radius: var(--ui-radius-xl) !important;
    }

    .outlet-actions-row .btn,
    .outlet-btn-danger,
    .outlet-btn-neutral,
    .outlet-form-actions .btn,
    .outlet-form-banner .btn,
    .outlet-form-card .form-control,
    .outlet-form-card .form-select {
        border-radius: var(--ui-radius-md) !important;
    }
</style>
