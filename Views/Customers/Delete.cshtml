@model HazelInvoice.Models.Customer

@{
    ViewData["Title"] = "Deactivate Outlet";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Customers") ?? "/Customers";
}

<partial name="_OutletStyles" />

<div class="container p-4 outlet-page">
    <div class="card outlet-delete-card">
        <div class="card-header outlet-delete-header">
            <h4 class="mb-0">Deactivate Outlet</h4>
        </div>
        <div class="card-body outlet-delete-body">
            <p class="mb-3">
                This will <strong>deactivate</strong> the outlet so it no longer appears in orders.
                Existing receipts will remain intact.
            </p>

            <dl class="row outlet-delete-meta">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Group</dt>
                <dd class="col-sm-8">@Model.GroupName</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>
            </dl>

            <form asp-action="Delete" class="outlet-return-form">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="returnScrollY" id="returnScrollY" value="0" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn outlet-btn-danger">Deactivate</button>
                    <a href="@returnUrl" class="btn outlet-btn-neutral">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const scrollInput = document.getElementById('returnScrollY');
            if (!scrollInput) return;

            const savedY = parseInt(sessionStorage.getItem('outlets:index:scrollY') || '0', 10);
            scrollInput.value = !Number.isNaN(savedY) && savedY > 0 ? String(savedY) : '0';
        })();
    </script>
}
