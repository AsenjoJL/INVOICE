@model HazelInvoice.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Suppliers") ?? "/Suppliers";
}

<partial name="_SupplierStyles" />

<div class="container supplier-page py-4">
    <div class="supplier-form-shell">
        <div class="supplier-form-card">
            <div class="supplier-form-banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="supplier-form-kicker">Supplier Setup</div>
                        <h4>Update Supplier</h4>
                        <p class="subtitle">Keep supplier details accurate for purchases and reports.</p>
                    </div>
                    <a href="@returnUrl" class="btn btn-light text-dark"><i class="bi bi-arrow-left"></i> Back</a>
                </div>
            </div>

            <div class="supplier-form-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="returnScrollY" id="supplierReturnScrollY" value="0" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="supplier-form-section">
                        <div class="section-title">Basics</div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Supplier Name" />
                                    <label asp-for="Name">Supplier Name</label>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="ContactPerson" class="form-control" placeholder="Contact Person" />
                                    <label asp-for="ContactPerson">Contact Person (Optional)</label>
                                    <span asp-validation-for="ContactPerson" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="supplier-form-section">
                        <div class="section-title">Contact</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
                                    <label asp-for="ContactNumber">Contact Number (Optional)</label>
                                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Address" class="form-control" placeholder="Address" />
                                    <label asp-for="Address">Address (Optional)</label>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="supplier-form-section">
                        <div class="section-title">Status</div>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Active supplier</label>
                        </div>
                    </div>

                    <div class="supplier-form-section supplier-form-actions">
                        <a href="@returnUrl" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const input = document.getElementById('supplierReturnScrollY');
            if (!input) return;
            const saved = parseInt(sessionStorage.getItem('suppliers:index:scrollY') || '0', 10);
            if (!Number.isNaN(saved) && saved > 0) input.value = saved;
        })();
    </script>
}
