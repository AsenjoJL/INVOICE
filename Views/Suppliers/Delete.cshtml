@model HazelInvoice.Models.Supplier

@{
    ViewData["Title"] = "Deactivate Supplier";
}

<partial name="_SupplierStyles" />

<div class="container p-4 supplier-page">
    <div class="card supplier-delete-card">
        <div class="card-header supplier-delete-header">
            <h4 class="mb-0">Deactivate Supplier</h4>
        </div>
        <div class="card-body supplier-delete-body">
            <p class="mb-3">
                This will <strong>deactivate</strong> the supplier so it no longer appears in selections.
            </p>

            <dl class="row supplier-delete-meta">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Contact</dt>
                <dd class="col-sm-8">@Model.ContactNumber</dd>

                <dt class="col-sm-4">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn supplier-btn-danger">Deactivate</button>
                    <a asp-action="Index" class="btn supplier-btn-neutral">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
