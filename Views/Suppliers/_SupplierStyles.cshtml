<style>
    .supplier-page {
        --supplier-bg: #ffffff;
        --supplier-ink: #0a0a0a;
        --supplier-muted: #888888;
        --supplier-border: #e8e8e8;
        --supplier-soft: #f7f7f7;
        font-family: 'DM Sans', sans-serif;
        color: var(--supplier-ink);
    }

    .supplier-page .admin-section-kicker,
    .supplier-page .supplier-form-kicker,
    .supplier-page .section-title,
    .supplier-page .table thead th,
    .supplier-page .form-label,
    .supplier-page .form-floating > label {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--supplier-muted);
    }

    .supplier-header,
    .supplier-card,
    .supplier-form-card,
    .supplier-form-section,
    .supplier-delete-card {
        background: var(--supplier-bg);
        border: 1px solid var(--supplier-border);
        border-radius: var(--ui-radius-xl);
        box-shadow: none;
    }

    .supplier-header {
        padding: 28px 32px;
        margin-bottom: 20px;
    }

    .supplier-header h1,
    .supplier-form-banner h4,
    .supplier-delete-header h4 {
        margin: 0;
        font-family: 'DM Sans', sans-serif;
        font-size: 22px;
        line-height: 1.1;
        font-weight: 600;
        color: var(--supplier-ink);
    }

    .supplier-header .sub,
    .supplier-form-banner .subtitle {
        margin: 8px 0 0;
        font-size: 14px;
        line-height: 1.6;
        color: #606060;
        font-weight: 400;
    }

    .supplier-actions,
    .supplier-actions-row,
    .supplier-form-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .supplier-page .btn {
        border-radius: var(--ui-radius-md);
        box-shadow: none;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 16px;
    }

    .supplier-page .btn.btn-primary,
    .supplier-page .supplier-form-actions .btn-primary {
        background: #0a0a0a;
        border: 1px solid #0a0a0a;
        color: #ffffff;
    }

    .supplier-page .btn.btn-light,
    .supplier-page .btn.btn-outline-secondary,
    .supplier-page .btn.btn-outline-primary,
    .supplier-page .btn.btn-outline-danger,
    .supplier-page .supplier-btn-neutral {
        background: #ffffff;
        border: 1px solid var(--supplier-border);
        color: var(--supplier-ink);
    }

    .supplier-page .btn.btn-outline-danger:hover,
    .supplier-page .btn.btn-outline-primary:hover,
    .supplier-page .btn.btn-outline-secondary:hover,
    .supplier-page .supplier-btn-neutral:hover {
        background: var(--supplier-soft);
        color: var(--supplier-ink);
        border-color: #dcdcdc;
    }

    .supplier-page .btn.btn-primary:hover,
    .supplier-page .supplier-form-actions .btn-primary:hover {
        background: #000000;
        border-color: #000000;
        color: #ffffff;
    }

    .supplier-card .card-body,
    .supplier-form-body,
    .supplier-delete-body {
        background: #ffffff;
    }

    .supplier-table {
        margin-bottom: 0;
    }

    .supplier-table thead th {
        background: #ffffff;
        border-bottom: 1px solid var(--supplier-border);
        padding: 14px 18px;
        font-weight: 400;
    }

    .supplier-table td {
        padding: 18px;
        vertical-align: middle;
        border-color: var(--supplier-border);
        font-size: 14px;
    }

    .supplier-table tbody tr:hover {
        background: #fbfbfb;
    }

    .supplier-name {
        font-size: 15px;
        font-weight: 500;
        color: var(--supplier-ink);
    }

    .supplier-meta {
        font-size: 13px;
        color: #606060;
        line-height: 1.5;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        border: 1px solid var(--supplier-border);
        border-radius: 999px;
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        background: #ffffff;
    }

    .status-pill::before {
        display: none;
    }

    .status-active {
        color: var(--supplier-ink);
    }

    .status-inactive {
        color: var(--supplier-muted);
    }

    .supplier-form-shell {
        max-width: 860px;
        margin: 0 auto;
    }

    .supplier-form-banner,
    .supplier-delete-header {
        background: #ffffff;
        border-bottom: 1px solid var(--supplier-border);
        padding: 28px 32px;
        color: var(--supplier-ink);
    }

    .supplier-form-body {
        padding: 0;
    }

    .supplier-form-section {
        margin: 0;
        padding: 24px 32px;
        border-width: 0 0 1px;
    }

    .supplier-form-section:last-child {
        border-bottom-width: 0;
    }

    .supplier-page .form-control,
    .supplier-page .form-select {
        min-height: 46px;
        border: 1px solid transparent;
        border-bottom-color: var(--supplier-border);
        border-radius: var(--ui-radius-md);
        background: #ffffff;
        color: var(--supplier-ink);
        font-size: 15px;
        font-weight: 400;
        padding-left: 0;
        padding-right: 0;
        box-shadow: none;
    }

    .supplier-page .form-floating > .form-control,
    .supplier-page .form-floating > .form-select {
        padding-left: 0;
        padding-right: 0;
    }

    .supplier-page .form-floating > label {
        padding-left: 0;
        padding-right: 0;
    }

    .supplier-page .form-control:focus,
    .supplier-page .form-select:focus {
        border-color: transparent;
        border-bottom-color: #0a0a0a;
        box-shadow: none;
    }

    .supplier-page .form-check-input {
        border-radius: 999px;
        border-color: #cfcfcf;
        box-shadow: none;
    }

    .supplier-page .form-check-input:checked {
        background-color: #0a0a0a;
        border-color: #0a0a0a;
    }

    .supplier-page .form-check-label,
    .supplier-delete-body,
    .supplier-delete-meta dd {
        font-size: 14px;
        color: var(--supplier-ink);
    }

    .supplier-delete-meta dt {
        font-family: 'DM Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--supplier-muted);
        font-weight: 400;
    }

    .supplier-btn-danger {
        background: #0a0a0a;
        border: 1px solid #0a0a0a;
        color: #ffffff;
        border-radius: var(--ui-radius-md);
    }

    .supplier-btn-danger:hover {
        background: #000000;
        border-color: #000000;
        color: #ffffff;
    }

    @@media (max-width: 768px) {
        .supplier-header,
        .supplier-form-banner,
        .supplier-delete-header,
        .supplier-form-section {
            padding: 20px;
        }
    }

    .supplier-header,
    .supplier-card,
    .supplier-form-card,
    .supplier-form-section,
    .supplier-delete-card {
        border-radius: var(--ui-radius-xl) !important;
    }

    .supplier-page .btn,
    .supplier-page .form-control,
    .supplier-page .form-select {
        border-radius: var(--ui-radius-md) !important;
    }
</style>
