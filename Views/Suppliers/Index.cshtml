@model IEnumerable<HazelInvoice.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
    ViewData["NotePurpose"] = "Manage supplier contacts for purchases and payables.";
    ViewData["NoteInstructions"] = "Add suppliers to auto-fill details when recording purchases.";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<partial name="_SupplierStyles" />

<div class="container-fluid p-4 supplier-page">
    <div class="supplier-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 admin-page-hero admin-page-hero-soft">
        <div>
            <div class="admin-section-kicker">Vendor Directory</div>
            <h1>Supplier Directory</h1>
            <div class="sub">Manage supplier contacts for purchases and payables.</div>
        </div>
        <div class="supplier-actions">
            <a asp-action="Create" class="btn admin-action-btn"><i class="bi bi-plus-lg"></i> Add Supplier</a>
        </div>
    </div>

    <partial name="_PageNote" />

    <div class="supplier-card admin-surface-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table supplier-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Supplier</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="supplier-row" data-id="@item.Id">
                                <td>
                                    <div class="supplier-name">@item.Name</div>
                                    <div class="supplier-meta">@(!string.IsNullOrWhiteSpace(item.ContactPerson) ? item.ContactPerson : "No contact person")</div>
                                </td>
                                <td>
                                    <div class="supplier-meta">@(!string.IsNullOrWhiteSpace(item.ContactNumber) ? item.ContactNumber : "No contact number")</div>
                                </td>
                                <td class="supplier-meta">@(!string.IsNullOrWhiteSpace(item.Address) ? item.Address : "No address")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-pill status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="supplier-actions-row d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-primary supplier-return-link" data-supplier-id="@item.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-danger supplier-return-link" data-supplier-id="@item.Id" title="Deactivate">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/suppliers-index.js" asp-append-version="true"></script>
}
