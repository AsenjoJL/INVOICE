@model HazelInvoice.ViewModels.ProfitSummaryViewModel
@using HazelInvoice.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<FeaturesOptions> Features
@{
    ViewData["Title"] = "Profit & Sales Summary";
    ViewData["NotePurpose"] = "Summarizes sales, fees, deductions, capital, and profit distribution.";
    ViewData["NoteInstructions"] = "Adjust the date range and fee inputs, then use the buttons to add deductions, capital, or purchases.";

    var partnersEnabled = Features.Value.PartnersEnabled;
}

<style>
    :root {
        --ink: #0f172a;
        --muted: #64748b;
        --bg: #eef2f8;
        --card: #ffffff;
        --line: #dbe2ee;
        --accent: #0f4c81;
        --accent-2: #22c55e;
        --success: #16a34a;
        --danger: #dc2626;
        --warn: #f59e0b;
        --shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
        --shadow-soft: 0 8px 22px rgba(15, 23, 42, 0.08);
        --radius: 0px;
        --space-1: 6px;
        --space-2: 10px;
        --space-3: 14px;
        --space-4: 18px;
        --excel-border: 1px solid #cfd7e6;
        --excel-header-bg: #f3f6fb;
        --excel-header-text: #0f172a;
        --excel-footer-bg: #f6f7fb;
    }
    
    .excel-font {
        font-family: 'Inter', sans-serif;
        color: var(--ink);
    }

    .report-shell {
        background: #f8fafc;
        min-height: 100vh;
    }

    .report-title {
        font-family: 'Poppins', sans-serif;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .group-title {
        font-family: 'Poppins', sans-serif;
        text-transform: uppercase;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: 1px;
        margin-bottom: var(--space-2);
    }

    /* SECTION HEADERS */
    .section-header {
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-weight: 700;
        text-transform: uppercase;
        padding: 12px 16px;
        letter-spacing: 0.6px;
        border: 2px solid var(--line);
        border-radius: var(--radius) var(--radius) 0 0;
        margin-bottom: 0;
        background: #ffffff;
        color: var(--ink);
        transition: background-color 0.18s ease, border-color 0.2s ease;
    }
    .section-header[aria-expanded="true"] .section-toggle {
        transform: rotate(180deg);
    }
    .section-toggle {
        transition: transform 0.2s ease;
    }
    .section-header:hover {
        border-color: #b9c6dc;
    }
    .section-header .section-toggle {
        color: currentColor;
        opacity: 0.75;
        font-size: 0.9rem;
    }
    .header-sales {
        border-color: #1d4ed8;
        background: #eff6ff;
        color: #1e40af;
    }
    .header-profit {
        border-color: #16a34a;
        background: #ecfdf3;
        color: #166534;
    }
    .header-deduct {
        border-color: #dc2626;
        background: #fef2f2;
        color: #b91c1c;
    }
    .header-capital {
        border-color: #0891b2;
        background: #ecfeff;
        color: #0e7490;
    }
    .header-expense {
        border-color: #f59e0b;
        background: #fffbeb;
        color: #b45309;
    }
    .header-ledger {
        border-color: #475569;
        background: #f1f5f9;
        color: #334155;
    }
    .header-main {
        border-color: #111827;
        background: #111827;
        color: #ffffff;
    }

    /* EXCEL TABLE */
    .table-excel {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        background: #fff;
        border-radius: 0 0 var(--radius) var(--radius);
        overflow: hidden;
    }
    .table-excel th, .table-excel td {
        border: var(--excel-border);
        padding: 8px 10px;
        vertical-align: middle;
    }
    .table-excel th {
        background-color: var(--excel-header-bg);
        color: var(--excel-header-text);
        font-weight: 700;
        text-align: center;
        border-bottom: 2px solid #555;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
    }
    .table-excel tbody tr:hover {
        background: #f0f5ff;
    }
    .bg-profit-light {
        background: #eef7f0;
    }
    /* Footer Row Emphasis */
    .table-excel tfoot td {
        background-color: var(--excel-footer-bg);
        font-weight: 800;
        border-top: 2px solid #000 !important;
        font-size: 1rem;
    }

    /* ALIGNMENT */
    .num-col { text-align: right; font-family: 'Consolas', monospace; letter-spacing: -0.5px; }
    .text-center { text-align: center; }
    .text-start { text-align: left; }

    /* COLORS */
    .val-pos { color: #166534; }
    .val-neg { color: #b91c1c; }
    .val-warn { color: #b45309; }

    /* SCROLL WRAPPERS */
    .excel-box {
        border: 1px solid var(--line);
        border-top: none;
        max-height: 400px;
        overflow-y: auto;
        background: #fff;
        border-radius: 0 0 var(--radius) var(--radius);
        box-shadow: var(--shadow-soft);
    }

    /* KPI CARDS */
    .kpi-card {
        border: 1px solid var(--line);
        border-left: 6px solid var(--accent);
        background: #fff;
        padding: 16px;
        border-radius: var(--radius);
        box-shadow: var(--shadow-soft);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow);
        border-color: #c7d2e5;
    }
    .kpi-title { font-size: 0.75rem; text-transform: uppercase; color: var(--muted); font-weight: 700; margin-bottom: 4px; }
    .kpi-value { font-size: 1.6rem; font-weight: 800; color: var(--ink); font-family: 'Consolas', monospace; }

    .action-btn {
        border-radius: 0;
        font-weight: 700;
        letter-spacing: 0.4px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }

    .final-share-summary-table {
        width: 100%;
        border-collapse: collapse;
        font-weight: 800;
        margin-bottom: 0.75rem;
    }
    .final-share-summary-table td {
        border: 2px solid #111;
        padding: 6px 10px;
        text-align: center;
        background: #fff;
    }
    .final-share-summary-table .summary-total {
        font-size: 1.1rem;
        font-family: 'Consolas', monospace;
    }
    .final-share-summary-table .summary-amount {
        font-family: 'Consolas', monospace;
    }

    .profit-summary-block {
        border: 2px solid #111;
        background: #fff;
    }
    .profit-summary-title {
        background: #f97316;
        color: #111;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        text-align: center;
        padding: 6px 10px;
        border-bottom: 2px solid #111;
        font-size: 0.9rem;
    }
    .profit-summary-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .profit-summary-table th,
    .profit-summary-table td {
        border: 1px solid #111;
        padding: 6px 8px;
        text-align: center;
    }
    .profit-summary-table th {
        background: #f8fafc;
        font-weight: 800;
    }
    .profit-summary-total-row td {
        font-weight: 800;
        background: #e8f5e9;
    }
    .profit-summary-total-row td:last-child {
        background: #fef08a;
    }

    .deduction-strip-block {
        margin-top: 1rem;
    }
    .deduction-strip-header {
        width: 60%;
        background: #f97316;
        color: #111;
        font-weight: 800;
        text-transform: uppercase;
        text-align: center;
        padding: 4px 8px;
        border: 2px solid #111;
        margin-bottom: 10px;
        font-size: 0.85rem;
    }
    .deduction-strip-table {
        width: 100%;
        border-collapse: collapse;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .deduction-strip-table td {
        border: 2px solid #111;
        padding: 6px 10px;
    }
    .deduction-strip-label {
        background: #f97316;
        color: #111;
        text-transform: uppercase;
        font-size: 0.85rem;
    }
    .deduction-strip-amount {
        text-align: right;
        width: 25%;
        font-family: 'Consolas', monospace;
    }
    .net-profit-row td:first-child {
        background: #fef08a;
        text-transform: uppercase;
        font-weight: 800;
        text-align: center;
    }
    .net-profit-row td:last-child {
        background: #fff;
        font-weight: 800;
        text-align: right;
        font-family: 'Consolas', monospace;
    }
    .note-deduction-row td:first-child {
        background: #dc2626;
        color: #fff;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 800;
    }
    .note-deduction-row td:last-child {
        text-align: right;
        font-family: 'Consolas', monospace;
        font-weight: 800;
    }

    .collection-summary {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
    }
    .collection-summary td {
        border: 2px solid #111;
        padding: 6px 10px;
    }
    .collection-label {
        background: #15803d;
        color: #fff;
        font-weight: 800;
        text-transform: uppercase;
        text-align: center;
        letter-spacing: 0.4px;
        font-size: 0.85rem;
    }
    .collection-value {
        text-align: right;
        font-family: 'Consolas', monospace;
        font-weight: 800;
        background: #fff;
    }

    .weekly-fee-block {
        border: 2px solid #111;
        background: #fff;
        margin-top: 1rem;
    }
    .weekly-fee-title {
        background: #f97316;
        color: #111;
        font-weight: 800;
        text-transform: uppercase;
        text-align: center;
        padding: 6px 10px;
        border-bottom: 2px solid #111;
        letter-spacing: 0.4px;
        font-size: 0.9rem;
    }
    .weekly-fee-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .weekly-fee-table th,
    .weekly-fee-table td {
        border: 1px solid #111;
        padding: 6px 8px;
        text-align: center;
    }
    .weekly-fee-table th {
        background: #f8fafc;
        font-weight: 800;
    }
    .weekly-total-label {
        background: #5b21b6;
        color: #fff;
        font-weight: 800;
        text-transform: uppercase;
    }
    .weekly-total-amount {
        background: #15803d;
        color: #fff;
        font-weight: 800;
        font-family: 'Consolas', monospace;
    }
    .weekly-total-fee {
        background: #fef08a;
        color: #b91c1c;
        font-weight: 800;
        font-family: 'Consolas', monospace;
    }
    .weekly-summary-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-weight: 800;
    }
    .weekly-summary-table td {
        border: 2px solid #111;
        padding: 6px 10px;
    }
    .weekly-summary-label {
        text-transform: uppercase;
        text-align: center;
        font-size: 0.85rem;
    }
    .weekly-summary-value {
        text-align: right;
        font-family: 'Consolas', monospace;
    }

    .report-shell .card,
    .report-shell .btn,
    .report-shell .form-control,
    .report-shell .form-select,
    .report-shell .input-group-text,
    .report-shell .page-note,
    .report-shell .kpi-card,
    .report-shell .excel-box,
    .report-shell .section-header,
    .report-shell .table-excel,
    .report-shell .modal-content {
        border-radius: 0 !important;
    }

    @@media print {
        .report-shell {
            background: #fff;
        }
        .kpi-card,
        .excel-box,
        .section-header {
            box-shadow: none !important;
        }
    }

    /* MODALS: flat, no gradient, consistent with report theme */
    .report-modal .modal-content {
        border: 2px solid #cbd5e1;
        border-radius: 0;
        box-shadow: none;
        background: #ffffff;
    }
    .report-modal {
        font-family: 'Inter', sans-serif;
    }
    .report-modal .modal-header {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 0;
        padding: 0.65rem 0.9rem;
    }
    .report-modal .modal-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .report-modal .modal-body {
        background: #ffffff;
        padding: 0.9rem;
    }
    .report-modal .modal-footer {
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
        border-radius: 0;
        padding: 0.5rem 0.9rem;
    }
    .report-modal .form-control,
    .report-modal .form-select,
    .report-modal .input-group-text {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        border-radius: 0;
        border: 1px solid #cbd5e1;
        box-shadow: none;
    }
    .report-modal .form-control::placeholder {
        font-weight: 600;
        color: #64748b;
    }
    .report-modal label,
    .report-modal .btn,
    .report-modal .input-group-text {
        font-family: 'Inter', sans-serif;
        font-weight: 700;
    }
    .report-modal .form-control:focus,
    .report-modal .form-select:focus {
        border-color: #0f766e;
        box-shadow: none;
    }
    .report-modal .btn-close {
        filter: none;
        opacity: 0.7;
    }
    .report-modal-submit {
        width: 100%;
        border-radius: 0;
        font-weight: 800;
        letter-spacing: 0.02em;
        border: 1px solid transparent;
    }
    .report-modal-deduction .modal-header {
        border-top: 4px solid #dc2626;
    }
    .report-modal-deduction .modal-title {
        color: #b91c1c;
    }
    .report-modal-deduction .report-modal-submit {
        background: #dc2626;
        color: #ffffff;
        border-color: #dc2626;
    }
    .report-modal-capital .modal-header {
        border-top: 4px solid #0891b2;
    }
    .report-modal-capital .modal-title {
        color: #0e7490;
    }
    .report-modal-capital .report-modal-submit {
        background: #0891b2;
        color: #ffffff;
        border-color: #0891b2;
    }
    .report-modal-purchase .modal-header {
        border-top: 4px solid #475569;
    }
    .report-modal-purchase .modal-title {
        color: #334155;
    }
    .report-modal-purchase .report-modal-submit {
        background: #475569;
        color: #ffffff;
        border-color: #475569;
    }

    /* ------------------------------
       Minimal + Highlighted (2026-03)
       Keep UI clean: white/black, bold borders, no shadows.
       ------------------------------ */
    .report-minimal {
        background: #ffffff !important;
    }
    .report-minimal .text-muted {
        color: #475569 !important;
    }
    .report-minimal .action-btn,
    .report-minimal .btn {
        box-shadow: none !important;
    }
    .report-minimal .report-card {
        border: 2px solid #111827 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: #ffffff !important;
    }

    .report-minimal .kpi-card {
        border: 2px solid #111827 !important;
        border-left: 2px solid #111827 !important;
        box-shadow: none !important;
        transform: none !important;
    }
    .report-minimal .kpi-card:hover {
        transform: none !important;
        box-shadow: none !important;
    }
    .report-minimal .kpi-title {
        color: #334155 !important;
    }
    .report-minimal .kpi-value {
        color: #111827 !important;
    }

    /* Section headers: highlighted by strong border + subtle fill (no category colors) */
    .report-minimal .section-header,
    .report-minimal .header-sales,
    .report-minimal .header-profit,
    .report-minimal .header-deduct,
    .report-minimal .header-capital,
    .report-minimal .header-expense,
    .report-minimal .header-ledger {
        border-color: #111827 !important;
        background: #f8fafc !important;
        color: #111827 !important;
    }
    .report-minimal .header-main {
        background: #111827 !important;
        color: #ffffff !important;
        border-color: #111827 !important;
    }

    /* Tables: make headers + totals visually clear */
    .report-minimal .excel-box {
        border: 2px solid #111827 !important;
        border-top: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }
    .report-minimal .table-excel th {
        box-shadow: none !important;
        border-bottom: 2px solid #111827 !important;
        background: #ffffff !important;
        color: #111827 !important;
    }
    .report-minimal .table-excel tbody tr:hover {
        background: #f8fafc !important;
    }
    .report-minimal .table-excel tfoot td {
        background: #f8fafc !important;
        border-top: 2px solid #111827 !important;
        color: #111827 !important;
    }

    .net-profit-box {
        border: 2px solid #111827;
        background: #ffffff;
        padding: 10px 12px;
        text-align: center;
    }

    .split-card-header {
        background: #f8fafc !important;
        color: #111827 !important;
        font-weight: 800 !important;
        border-bottom: 2px solid #111827 !important;
    }
    .split-badge {
        background: transparent !important;
        color: #111827 !important;
        border: 2px solid #111827 !important;
        border-radius: 0 !important;
        font-weight: 800 !important;
        letter-spacing: 0.03em;
    }
    .final-payout-row td {
        background: #f8fafc !important;
        border-top: 2px solid #111827 !important;
    }

    /* Deductions record table (remaining balance per row) */
    .deduction-ledger {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border: 2px solid #111827;
        font-size: 0.85rem;
    }
    .deduction-ledger th,
    .deduction-ledger td {
        border: 1px solid #111827;
        padding: 6px 8px;
        vertical-align: top;
    }
    .deduction-ledger-title {
        background: #f8fafc;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        text-align: center;
        border-bottom: 2px solid #111827 !important;
    }
    .deduction-ledger-head {
        background: #ffffff;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.72rem;
        text-align: center;
        white-space: nowrap;
    }
    .deduction-ledger-date { text-align: center; font-weight: 700; }
    .deduction-ledger-desc { font-weight: 700; }
    .deduction-ledger-amount,
    .deduction-ledger-balance,
    .deduction-ledger-balance-amount {
        text-align: right;
        font-family: 'Consolas', monospace;
        font-weight: 800;
    }
    .deduction-ledger-balance-label {
        font-weight: 900;
        text-transform: uppercase;
        text-align: right;
        background: #f8fafc;
        border-top: 2px solid #111827 !important;
    }
    .deduction-ledger-balance-amount {
        background: #f8fafc;
        border-top: 2px solid #111827 !important;
    }

    .report-minimal .profit-summary-title,
    .report-minimal .deduction-strip-header,
    .report-minimal .deduction-strip-label,
    .report-minimal .net-profit-row td:first-child {
        background: #f8fafc !important;
        color: #111827 !important;
    }
    .report-minimal .note-deduction-row td:first-child {
        background: #111827 !important;
        color: #ffffff !important;
    }

    /* Neutral admin override */
    .report-shell {
        background: #f7f9fc !important;
        color: #111827 !important;
    }
    .report-shell .card,
    .report-shell .page-note,
    .report-shell .kpi-card,
    .report-shell .excel-box,
    .report-shell .section-header,
    .report-shell .table-excel,
    .report-shell .modal-content,
    .report-shell .deduction-ledger,
    .report-shell .purchase-ledger,
    .report-shell .partner-summary-table,
    .report-shell .final-shared-table,
    .report-shell .final-note-row {
        background: #ffffff !important;
        border-color: #d8e0ea !important;
        box-shadow: none !important;
        color: #111827 !important;
    }
    .report-shell .group-title,
    .report-shell .kpi-title,
    .report-shell .text-muted,
    .report-shell .table-excel th,
    .report-shell .deduction-ledger-head,
    .report-shell .purchase-ledger thead th {
        color: #94a3b8 !important;
    }
    .report-shell .table-excel th,
    .report-shell .table-excel tfoot td,
    .report-shell .deduction-ledger-title,
    .report-shell .purchase-ledger-title {
        background: #ffffff !important;
        border-color: #d8e0ea !important;
        box-shadow: none !important;
    }
    .report-shell .table-excel tbody tr:hover {
        background: #fafbfd !important;
    }
    .report-shell .kpi-card {
        border-left: 1px solid #d8e0ea !important;
    }
    .report-shell .kpi-value,
    .report-shell .num-col,
    .report-shell .val-pos,
    .report-shell .val-neg,
    .report-shell .val-warn {
        color: #111827 !important;
    }
</style>

<div class="container-fluid p-4 excel-font report-shell report-minimal">
    <!-- Header & Controls -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="report-title mb-0 text-uppercase"><i class="bi bi-graph-up-arrow"></i> Profit & Sales Summary</h2>
            <div class="text-muted small">Financial Report: @Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm action-btn" data-bs-toggle="modal" data-bs-target="#deductionModal"><i class="bi bi-dash-circle"></i> Deduction</button>
            <button class="btn btn-outline-info btn-sm action-btn" data-bs-toggle="modal" data-bs-target="#capitalModal"><i class="bi bi-cash-stack"></i> Capital</button>
            @if (partnersEnabled)
            {
                <button class="btn btn-outline-secondary btn-sm action-btn" data-bs-toggle="modal" data-bs-target="#purchaseModal"><i class="bi bi-bag-plus"></i> Purchase</button>
            }
            <a href="#" onclick="return window.hazelPrint && window.hazelPrint.prepareAndPrint ? window.hazelPrint.prepareAndPrint() : (window.print(), false)" class="btn btn-dark btn-sm action-btn"><i class="bi bi-printer"></i> Print</a>
        </div>
    </div>

    <partial name="_PageNote" />

    <!-- Filters (Hidden on Print) -->
    <form method="get" class="card p-3 mb-4 d-print-none report-card">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="small fw-bold text-muted">START DATE</label>
                <input type="date" name="startDate" class="form-control form-control-sm fw-bold" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="small fw-bold text-muted">END DATE</label>
                <input type="date" name="endDate" class="form-control form-control-sm fw-bold" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-1">
                <label class="small fw-bold text-muted">FEE %</label>
                <input type="number" step="0.1" name="percentFee" class="form-control form-control-sm text-center fw-bold" value="@Model.PercentFee" />
            </div>
            @if (partnersEnabled)
            {
                <div class="col-md-1">
                    <label class="small fw-bold text-muted">P1 SHARE %</label>
                    <input type="number" step="1" name="split1" class="form-control form-control-sm text-center fw-bold" value="@Model.Partner1SharePercent" />
                </div>
            }
            <div class="col-md-2">
                <div class="form-check pt-4">
                    <input class="form-check-input" type="checkbox" name="includeUnpaid" value="true" @(Model.IncludeUnpaid ? "checked" : "") id="checkUnpaid">
                    <!-- Ensures includeUnpaid=false is submitted when unchecked.
                         Order matters: checkbox first so the model binder reads "true" when checked. -->
                    <input type="hidden" name="includeUnpaid" value="false" />
                    <label class="form-check-label small fw-bold" for="checkUnpaid">INCLUDE UNPAID</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">REFRESH DATA</button>
            </div>
        </div>
    </form>

    @if (Model.AllReceiptCount == 0)
    {
        <div class="alert alert-warning d-print-none mb-4">
            <strong>No sales found</strong> for <span class="fw-bold">@Model.StartDate.ToString("MMM dd, yyyy")</span> to <span class="fw-bold">@Model.EndDate.ToString("MMM dd, yyyy")</span>.
            Try expanding the date range, then click <span class="fw-bold">REFRESH DATA</span>.
        </div>
    }
    else if (!Model.IncludeUnpaid && Model.TotalReceiptCount == 0 && Model.AllUnpaidReceiptCount > 0)
    {
        <div class="alert alert-info d-print-none mb-4">
            <strong>Paid-only filter is hiding your sales.</strong>
            You have <span class="fw-bold">@Model.AllUnpaidReceiptCount</span> unpaid receipt(s) in this date range.
            Enable <span class="fw-bold">INCLUDE UNPAID</span>, then click <span class="fw-bold">REFRESH DATA</span>.
        </div>
    }
    else if (Model.TotalGrossSales > 0 && Model.TotalGrossProfit == 0)
    {
        <div class="alert alert-secondary d-print-none mb-4">
            <strong>Profit is ₱0.00</strong> because your items currently have <span class="fw-bold">no margin</span> (selling price equals cost).
            Update your product costs/markup in <span class="fw-bold">Products</span> or set weekly prices in <span class="fw-bold">Price Setup</span>, then refresh this report.
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="group-title"><i class="bi bi-stars"></i> Overview</div>
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="kpi-card">
                <div class="kpi-title">TOTAL SALES (@(Model.IncludeUnpaid ? "ALL" : "PAID"))</div>
                <div class="kpi-value">₱@Model.TotalGrossSales.ToString("N2")</div>
                <small class="text-muted d-block mt-1">@Model.TotalReceiptCount Receipts</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card">
                 <div class="kpi-title">TOTAL PAID</div>
                 <div class="kpi-value">₱@Model.TotalPaidReceipts.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="kpi-card">
                 <div class="kpi-title">TOTAL UNPAID</div>
                 <div class="kpi-value">₱@Model.TotalUnpaidReceipts.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="kpi-card">
                 <div class="kpi-title">ITEMS SOLD</div>
                 <div class="kpi-value">@Model.TotalItemsSold.ToString("N0") <span class="fs-6 text-muted">units</span></div>
            </div>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="group-title"><i class="bi bi-diagram-3"></i> Operations</div>
    <div class="row g-4">
        <!-- LEFT: Breakdowns -->
        <div class="col-lg-8">
            <!-- Row: Sales & Profit Tables -->
            <div class="row g-0">
                <div class="col-md-6 pe-md-2">
                    <button class="section-header header-sales" type="button" data-bs-toggle="collapse" data-bs-target="#salesSection">
                        <span><i class="bi bi-receipt-cutoff me-2"></i> A. Sales & Fees (@Model.PercentFee%)</span>
                        <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
                    </button>
                    <div id="salesSection" class="collapse show excel-box">
                        <table class="table-excel">
                            <thead>
                                <tr><th>DATE</th><th>SALES</th><th>FEE</th></tr>
                            </thead>
                            <tbody>
                                @foreach(var day in Model.DailyStats) {
                                    <tr>
                                        <td class="text-center">@day.Date.ToString("MM/dd")</td>
                                        <td class="num-col">@day.SalesAmount.ToString("N2")</td>
                                        <td class="num-col val-neg">@day.FeeAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>TOTAL</td>
                                    <td class="num-col">₱@Model.TotalGrossSales.ToString("N2")</td>
                                    <td class="num-col val-neg">₱@Model.TotalFees.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="col-md-6 ps-md-2 mt-3 mt-md-0">
                    <button class="section-header header-profit" type="button" data-bs-toggle="collapse" data-bs-target="#profitSection">
                        <span><i class="bi bi-graph-up-arrow me-2"></i> B. Gross Profit</span>
                        <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
                    </button>
                     <div id="profitSection" class="collapse show excel-box">
                        <table class="table-excel">
                            <thead>
                                <tr><th>DATE</th><th class="bg-profit-light">PROFIT</th></tr>
                            </thead>
                            <tbody>
                                @foreach(var day in Model.DailyStats) {
                                    <tr>
                                        <td class="text-center">@day.Date.ToString("MM/dd")</td>
                                        <td class="num-col fw-bold val-pos bg-profit-light">@day.GrossProfit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>TOTAL</td>
                                    <td class="num-col val-pos">₱@Model.TotalGrossProfit.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Row: Deductions & Capital -->
            <div class="row g-0 mt-4">
                <div class="col-md-6 pe-md-2">
                    <button class="section-header header-deduct" type="button" data-bs-toggle="collapse" data-bs-target="#deductionSection">
                        <span><i class="bi bi-x-circle me-2"></i> C. Deductions</span>
                        <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
                    </button>
                    <div id="deductionSection" class="collapse show excel-box">
                        <table class="table-excel">
                            <thead>
                                <tr><th>DESCRIPTION</th><th>AMOUNT</th></tr>
                            </thead>
                            <tbody>
                                @foreach(var d in Model.Deductions) {
                                    <tr>
                                        <td>@d.Description <br><small class="text-muted">@d.Date.ToString("MM/dd")</small></td>
                                        <td class="num-col val-neg">@d.Amount.ToString("N2")</td>
                                    </tr>
                                }
                                @if(!Model.Deductions.Any()) { <tr><td colspan="2" class="text-center text-muted fst-italic py-3">No deductions recorded</td></tr>}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>TOTAL DEDUCTIONS</td>
                                    <td class="num-col val-neg">₱@Model.TotalDeductions.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="col-md-6 ps-md-2 mt-3 mt-md-0">
                    <button class="section-header header-capital" type="button" data-bs-toggle="collapse" data-bs-target="#capitalSection">
                        <span><i class="bi bi-safe2 me-2"></i> D. Capital Funds</span>
                        <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
                    </button>
                     <div id="capitalSection" class="collapse show excel-box">
                        <table class="table-excel">
                            <thead>
                                <tr><th>FUND NAME</th><th>AMOUNT</th></tr>
                            </thead>
                             <tbody>
                                @foreach(var c in Model.CapitalFunds) {
                                    <tr>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(c.FundName) ? c.Description : c.FundName)
                                            @if (!string.IsNullOrWhiteSpace(c.Description) && !string.Equals(c.Description, c.FundName, System.StringComparison.OrdinalIgnoreCase))
                                            {
                                                <br><small class="text-muted">@c.Description</small>
                                            }
                                            <br><small class="text-muted">@c.Date.ToString("MM/dd")</small>
                                        </td>
                                        <td class="num-col text-info">@c.Amount.ToString("N2")</td>
                                    </tr>
                                }
                                @if(!Model.CapitalFunds.Any()) { <tr><td colspan="2" class="text-center text-muted fst-italic py-3">No capital allocations</td></tr>}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>TOTAL FUND</td>
                                    <td class="num-col text-info">₱@Model.TotalCapitalFund.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <table class="collection-summary">
                        <tr>
                            <td class="collection-label">@(Model.CollectionStartDate?.ToString("MMMM dd, yyyy") ?? Model.StartDate.ToString("MMMM dd, yyyy")) - Collection</td>
                            <td class="collection-value">₱@Model.TotalGrossSales.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="collection-label">Received Amount</td>
                            <td class="collection-value">₱@Model.ReceivedAmount.ToString("N2")</td>
                        </tr>
                    </table>
                    <div class="small text-muted mt-1">
                        @if (Model.ReceivedAmountIsManual)
                        {
                            <span>Manual override (auto: ₱@Model.AutoReceivedAmount.ToString("N2"))</span>
                        }
                        else
                        {
                            <span>Auto from paid receipts</span>
                        }
                    </div>
                    <form asp-action="SaveReceivedAmount" method="post" class="mt-2 d-print-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Manual Received</span>
                            <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" value="@(Model.ReceivedAmountIsManual ? Model.ReceivedAmount.ToString("0.##") : "")" />
                            <button class="btn btn-outline-success" type="submit">Save</button>
                        </div>
                        <div class="small text-muted">Set 0 to clear manual override.</div>
                    </form>
                </div>
            </div>

            <!-- Row: Expenses -->
            <div class="row g-0 mt-4">
                <div class="col-12">
                    <button class="section-header header-expense" type="button" data-bs-toggle="collapse" data-bs-target="#expenseSection">
                        <span><i class="bi bi-receipt-cutoff me-2"></i> C2. Expenses</span>
                        <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
                    </button>
                    <div id="expenseSection" class="collapse show excel-box">
                        @if (Model.ExpenseGroups.Any())
                        {
                            foreach (var expenseGroup in Model.ExpenseGroups)
                            {
                                <div class="group-title px-3 pt-3 mb-0">@expenseGroup.Label</div>
                                <table class="table-excel">
                                    <thead>
                                        <tr><th>DESCRIPTION</th><th>AMOUNT</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var e in expenseGroup.Items)
                                        {
                                            <tr>
                                                <td>@e.Category @if(!string.IsNullOrEmpty(e.Description)){<span>- @e.Description</span>} <br><small class="text-muted">@e.Date.ToString("MM/dd")</small></td>
                                                <td class="num-col val-neg">@e.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>@expenseGroup.Label.ToUpperInvariant()</td>
                                            <td class="num-col val-neg">₱@expenseGroup.TotalAmount.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                        }
                        else
                        {
                            <table class="table-excel">
                                <tbody>
                                    <tr><td colspan="2" class="text-center text-muted fst-italic py-3">No expenses recorded</td></tr>
                                </tbody>
                            </table>
                        }

                        <table class="table-excel">
                            <tfoot>
                                <tr>
                                    <td>TOTAL EXPENSES</td>
                                    <td class="num-col val-neg">₱@Model.TotalExpenses.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>

                        @{
                            var orderedDeductions = Model.Deductions
                                .OrderBy(d => d.Date)
                                .ThenBy(d => d.Id)
                                .ToList();
                            decimal runningBalance = Model.NetProfit;
                        }

                        <div class="mt-3">
                            <table class="deduction-ledger">
                                <thead>
                                    <tr>
                                        <th colspan="4" class="deduction-ledger-title">
                                            Record of deductions and remaining balance
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="deduction-ledger-head">Date</th>
                                        <th class="deduction-ledger-head">Amount</th>
                                        <th class="deduction-ledger-head">Description</th>
                                        <th class="deduction-ledger-head">Remaining Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in orderedDeductions)
                                    {
                                        runningBalance -= d.Amount;
                                        <tr>
                                            <td class="deduction-ledger-date">@d.Date.ToString("MM/dd")</td>
                                            <td class="deduction-ledger-amount">₱@d.Amount.ToString("N2")</td>
                                            <td class="deduction-ledger-desc">@d.Description</td>
                                            <td class="deduction-ledger-balance">₱@runningBalance.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (!orderedDeductions.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted fst-italic py-3">No deductions recorded</td></tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="deduction-ledger-balance-label">BALANCE</td>
                                        <td class="deduction-ledger-balance-amount" colspan="3">₱@runningBalance.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NET PROFIT CALCULATION BOX -->
            <div class="mt-4 p-3 bg-white border border-dark border-2 report-card">
                 <h5 class="fw-bold border-bottom pb-2 mb-3 text-center bg-light"><i class="bi bi-calculator"></i> Net Profit Calculation</h5>
                 <div class="row text-center align-items-center g-2">
                     <div class="col">
                         <div class="text-muted small fw-bold text-uppercase">Gross Profit</div>
                         <div class="fs-4 fw-bold val-pos">₱@Model.TotalGrossProfit.ToString("N0")</div>
                     </div>
                     <div class="col-auto fs-4 text-muted">-</div>
                     <div class="col">
                         <div class="text-muted small fw-bold text-uppercase">Deductions</div>
                         <div class="fs-4 fw-bold val-neg">₱@Model.TotalDeductions.ToString("N0")</div>
                     </div>
                     <div class="col-auto fs-4 text-muted">-</div>
                     <div class="col">
                         <div class="text-muted small fw-bold text-uppercase">Expenses</div>
                         <div class="fs-4 fw-bold val-neg">₱@Model.TotalExpenses.ToString("N0")</div>
                     </div>
                     <div class="col-auto fs-4 text-muted">-</div>
                     <div class="col">
                         <div class="text-muted small fw-bold text-uppercase">Capital Fund</div>
                         <div class="fs-4 fw-bold">₱@Model.TotalCapitalFund.ToString("N0")</div>
                     </div>
                     <div class="col-auto fs-4 text-dark">=</div>
                     <div class="col-md-4">
                         <div class="net-profit-box">
                             <div class="small text-uppercase fw-bold">NET DISTRIBUTABLE PROFIT</div>
                             <div class="fs-2 fw-black">₱@Model.NetProfit.ToString("N2")</div>
                         </div>
                     </div>
                 </div>
            </div>
            
            @if (partnersEnabled)
            {
                <!-- PARTNERS SPLIT -->
                <div class="group-title mt-4"><i class="bi bi-people"></i> Partner Distribution</div>
                <form method="get" class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-2">
                    <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="includeUnpaid" value="@(Model.IncludeUnpaid ? "true" : "false")" />
                    <input type="hidden" name="percentFee" value="@Model.PercentFee" />
                    <label class="small fw-bold text-muted mb-0">P1 SHARE %</label>
                    <input type="number" step="1" min="0" max="100" name="split1" class="form-control form-control-sm text-center fw-bold" style="width: 90px;" value="@Model.Partner1SharePercent" />
                    <span class="small text-muted">P2 = @Model.Partner2SharePercent.ToString("0")%</span>
                    <button type="submit" class="btn btn-outline-primary btn-sm fw-bold">Apply Share</button>
                </form>
                <div class="row g-3 mt-2">
                    <!-- Partner 1 -->
                    <div class="col-md-6">
                        <div class="card h-100 border-dark report-card">
                            <div class="card-header split-card-header d-flex justify-content-between">
                                <span>@Model.Partner1Name</span>
                                <span class="badge split-badge">@Model.Partner1SharePercent.ToString("0")% SHARE</span>
                            </div>
                            <div class="card-body p-0">
                                <table class="table-excel mb-0">
                                    <tr>
                                        <td class="fw-bold bg-light">Profit Share</td>
                                        <td class="num-col fw-bold val-pos fs-5">₱@Model.Partner1ShareAmount.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="text-muted small fw-bold bg-light border-top text-uppercase ps-3">Less Purchases:</td>
                                    </tr>
                                    @foreach(var p in Model.PartnerPurchases.Where(x => x.PartnerName == Model.Partner1Name)) {
                                    <tr>
                                        <td class="ps-4">@p.Notes <small class="text-muted">(@p.Date.ToString("MM/dd"))</small></td>
                                        <td class="num-col val-neg">(@p.Amount.ToString("N2"))</td>
                                    </tr>
                                    }
                                    <tr class="final-payout-row">
                                        <td class="fw-black">FINAL PAYOUT</td>
                                        <td class="num-col fw-black fs-4">₱@Model.Partner1Final.ToString("N2")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- Partner 2 -->
                    <div class="col-md-6">
                     <div class="card h-100 border-dark report-card">
                        <div class="card-header split-card-header d-flex justify-content-between">
                            <span>@Model.Partner2Name</span>
                             <span class="badge split-badge">@Model.Partner2SharePercent.ToString("0")% SHARE</span>
                        </div>
                        <div class="card-body p-0">
                             <table class="table-excel mb-0">
                                <tr>
                                    <td class="fw-bold bg-light">Profit Share</td>
                                    <td class="num-col fw-bold val-pos fs-5">₱@Model.Partner2ShareAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-muted small fw-bold bg-light border-top text-uppercase ps-3">Less Purchases:</td>
                                </tr>
                                @foreach(var p in Model.PartnerPurchases.Where(x => x.PartnerName == Model.Partner2Name)) {
                                <tr>
                                    <td class="ps-4">@p.Notes <small class="text-muted">(@p.Date.ToString("MM/dd"))</small></td>
                                    <td class="num-col val-neg">(@p.Amount.ToString("N2"))</td>
                                </tr>
                                }
                                <tr class="final-payout-row">
                                    <td class="fw-black">FINAL PAYOUT</td>
                                    <td class="num-col fw-black fs-4">₱@Model.Partner2Final.ToString("N2")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>

        <!-- RIGHT: LEDGER -->
        <div class="col-lg-4">
            <button class="section-header header-ledger" type="button" data-bs-toggle="collapse" data-bs-target="#ledgerSection">
                <span><i class="bi bi-journal-text me-2"></i> F. Account Ledger</span>
                <span class="section-toggle"><i class="bi bi-chevron-down"></i></span>
            </button>
            <div id="ledgerSection" class="collapse show excel-box" style="max-height: 800px;">
                <table class="table-excel table-striped">
                    <thead>
                         <tr><th colspan="3" class="bg-light text-start border-bottom-2">OPENING BALANCE: <span class="float-end fw-bold">₱@Model.Partner1OpeningBalance.ToString("N2")</span></th></tr>
                        <tr>
                            <th class="text-start">DATE / DESC</th>
                            <th>AMT</th>
                            <th>BAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var row in Model.Ledger) {
                        <tr>
                            <td>
                                <div class="fw-bold" style="font-size:0.8rem">@row.Date.ToString("MM/dd")</div>
                                <div class="text-muted small" style="line-height:1.1">@row.Description</div>
                            </td>
                            <td class="num-col @(row.Amount < 0 ? "val-neg" : "val-pos")">@row.Amount.ToString("N2")</td>
                            <td class="num-col fw-bold">@row.Balance.ToString("N2")</td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- DETAILED ANALYTICS FOOTER -->
    <div class="mt-5 pt-3 border-top border-3">
        <button class="section-header header-main w-100" type="button" data-bs-toggle="collapse" data-bs-target="#analyticsSection">
            <span><i class="bi bi-bar-chart-fill me-2"></i> Detailed Analytics</span>
            <span class="section-toggle text-white"><i class="bi bi-chevron-down"></i></span>
        </button>
        <div id="analyticsSection" class="collapse show">
        <div class="row g-4 mt-2">
            <div class="col-lg-6">
                <div class="section-header header-main"><span><i class="bi bi-award me-2"></i> Top Selling Items</span><span class="section-toggle"><i class="bi bi-chevron-down"></i></span></div>
                <div class="excel-box">
                    <table class="table-excel">
                        <thead><tr><th>ITEM NAME</th><th>QTY</th><th>TOTAL</th></tr></thead>
                        <tbody>
                             @foreach(var item in Model.TopItems) {
                                <tr>
                                    <td>@item.ItemName</td>
                                    <td class="num-col fw-bold">@item.Quantity.ToString("0.###")</td>
                                    <td class="num-col">₱@item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="section-header header-main"><span><i class="bi bi-shop me-2"></i> Outlet Performance</span><span class="section-toggle"><i class="bi bi-chevron-down"></i></span></div>
                <div class="excel-box">
                     <table class="table-excel">
                        <thead><tr><th>OUTLET</th><th>PAID</th><th>UNPAID</th><th>TOTAL</th></tr></thead>
                        <tbody>
                             @foreach(var outlet in Model.OutletSummaries) {
                                <tr>
                                    <td>@outlet.OutletName</td>
                                    <td class="num-col text-success">₱@outlet.PaidAmount.ToString("N2")</td>
                                    <td class="num-col text-danger">₱@outlet.UnpaidAmount.ToString("N2")</td>
                                    <td class="num-col fw-bold">₱@outlet.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (partnersEnabled)
            {
                var purchasesByPartner = Model.PartnerPurchases
                    .OrderBy(p => p.Date)
                    .GroupBy(p => string.IsNullOrWhiteSpace(p.PartnerName) ? "Unknown" : p.PartnerName)
                    .ToList();

                <!-- PARTNER PURCHASES (Grouped by Partner) -->
                <div class="group-title mt-4"><i class="bi bi-bag-check text-primary"></i> Partner Purchases</div>
                <div class="row g-3 mt-2">
                    @if (!purchasesByPartner.Any())
                    {
                        <div class="col-12">
                            <div class="text-center text-muted fst-italic py-3">No partner purchases recorded</div>
                        </div>
                    }
                    else
                    {
                        foreach (var group in purchasesByPartner)
                        {
                            var total = group.Sum(x => x.Amount);
                            var partnerName = group.Key;
                            var shareAmount = 0m;
                            if (string.Equals(partnerName, Model.Partner1Name, System.StringComparison.OrdinalIgnoreCase))
                            {
                                shareAmount = Model.Partner1ShareAmount;
                            }
                            else if (string.Equals(partnerName, Model.Partner2Name, System.StringComparison.OrdinalIgnoreCase))
                            {
                                shareAmount = Model.Partner2ShareAmount;
                            }
                            var partnerExpenses = Model.Expenses
                                .Where(e => string.Equals(e.Vendor, partnerName, System.StringComparison.OrdinalIgnoreCase))
                                .Sum(e => e.Amount);
                            var totalTaken = total;
                            var sharePlus = shareAmount + total + partnerExpenses;
                            <div class="col-12">
                                <table class="purchase-ledger">
                                    <thead>
                                        <tr>
                                            <th class="purchase-ledger-title" colspan="3">@group.Key.ToUpper() PURCHASES</th>
                                        </tr>
                                        <tr>
                                            <th>DESCRIPTION</th>
                                            <th>DATE</th>
                                            <th>AMOUNT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in group)
                                        {
                                            <tr>
                                                <td>@p.Notes</td>
                                                <td>@p.Date.ToString("MM/dd/yyyy")</td>
                                                <td class="num-col">₱@p.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td class="fw-bold">TOTAL PURCHASES</td>
                                            <td></td>
                                            <td class="num-col fw-bold">₱@total.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <div class="partner-summary">
                                    <table class="partner-summary-table">
                                        <tr>
                                            <td class="partner-summary-label">The money you took from the collections.</td>
                                            <td class="partner-summary-value">₱@totalTaken.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td class="partner-summary-label">Your share of profit and the purchases and expenses you paid for.</td>
                                            <td class="partner-summary-value">₱@sharePlus.ToString("N2")</td>
                                        </tr>
                                    </table>
                                    <div class="partner-summary-total">₱@sharePlus.ToString("N2")</div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- PARTNER-ATTRIBUTED SALES (From Receipt Lines) -->
                <div class="group-title mt-4"><i class="bi bi-tags text-primary"></i> Partner Item Purchases (From Sales)</div>
                <div class="row g-3 mt-2">
                @if (Model.PartnerSalesAttributions == null || !Model.PartnerSalesAttributions.Any())
                {
                    <div class="col-12">
                        <div class="text-center text-muted fst-italic py-3">No partner-tagged sales recorded</div>
                    </div>
                }
                else
                {
                    foreach (var group in Model.PartnerSalesAttributions)
                    {
                        <div class="col-12">
                            <table class="purchase-ledger">
                                <thead>
                                    <tr>
                                        <th class="purchase-ledger-title" colspan="2">@group.PartnerName.ToUpper() ITEMS</th>
                                    </tr>
                                    <tr>
                                        <th>ITEM</th>
                                        <th>AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in group.Items)
                                    {
                                        <tr>
                                            <td>@p.ItemName</td>
                                            <td class="num-col">₱@p.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="fw-bold">TOTAL</td>
                                        <td class="num-col fw-bold">₱@group.TotalAmount.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }
            </div>
            }

            @{
                var weeklyNet = Model.TotalGrossSales - Model.TotalFees;
                var balanceAsOfDate = (Model.CollectionStartDate ?? Model.StartDate).AddDays(-1);
                var openingBalance = Model.Partner1OpeningBalance;
                var totalBalance = openingBalance + weeklyNet;
                var collectionDate = Model.CollectionStartDate ?? Model.StartDate;
                var collectionAmount = Model.ReceivedAmount;
                var remainingBalance = totalBalance - collectionAmount;
            }
            <div class="weekly-fee-block">
                <div class="weekly-fee-title">
                    @Model.StartDate.ToString("MMMM dd, yyyy") - @Model.EndDate.ToString("MMMM dd, yyyy")
                </div>
                <table class="weekly-fee-table">
                    <thead>
                        <tr>
                            <th>DATE</th>
                            <th>AMOUNT</th>
                            <th>1%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DailyStats)
                        {
                            <tr>
                                <td>@day.Date.ToString("MM/dd/yyyy")</td>
                                <td class="num-col">₱@day.SalesAmount.ToString("N2")</td>
                                <td class="num-col">₱@day.FeeAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="weekly-total-label">Weekly Total</td>
                            <td class="weekly-total-amount">₱@Model.TotalGrossSales.ToString("N2")</td>
                            <td class="weekly-total-fee">₱@Model.TotalFees.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <table class="weekly-summary-table">
                <tr>
                    <td class="weekly-summary-label">Weekly total after deducted by 1%</td>
                    <td class="weekly-summary-value">₱@weeklyNet.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="weekly-summary-label">Balance as of @balanceAsOfDate.ToString("MMMM dd, yyyy")</td>
                    <td class="weekly-summary-value">₱@openingBalance.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="weekly-summary-label">Total balance</td>
                    <td class="weekly-summary-value">₱@totalBalance.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="weekly-summary-label">@collectionDate.ToString("MMMM dd, yyyy") Collection</td>
                    <td class="weekly-summary-value">₱@collectionAmount.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="weekly-summary-label">Remaining balance as of @Model.EndDate.ToString("MMMM dd, yyyy")</td>
                    <td class="weekly-summary-value">₱@remainingBalance.ToString("N2")</td>
                </tr>
            </table>

            <!-- FINAL SHARED NET PROFIT -->
            <div class="group-title mt-4"><i class="bi bi-check2-circle text-primary"></i> Final Shared Net Profit</div>
            <div class="profit-summary-block mt-2">
                <div class="profit-summary-title">
                    Summary of Profit in @Model.StartDate.ToString("MMMM dd, yyyy") - @Model.EndDate.ToString("MMMM dd, yyyy")
                </div>
                <table class="profit-summary-table">
                    <thead>
                        <tr>
                            <th>DATE</th>
                            <th>PROFIT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DailyStats)
                        {
                            <tr>
                                <td>@day.Date.ToString("MM/dd/yyyy")</td>
                                <td class="num-col">₱@day.GrossProfit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="profit-summary-total-row">
                            <td></td>
                            <td class="num-col">₱@Model.TotalGrossProfit.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="deduction-strip-block">
                <div class="deduction-strip-header">Deductions</div>
                @foreach (var d in Model.Deductions)
                {
                    <table class="deduction-strip-table">
                        <tr>
                            <td class="deduction-strip-label">@d.Description</td>
                            <td class="deduction-strip-amount">₱@d.Amount.ToString("N2")</td>
                        </tr>
                    </table>
                }
                @if (!Model.Deductions.Any())
                {
                    <table class="deduction-strip-table">
                        <tr>
                            <td class="deduction-strip-label text-center">No deductions recorded</td>
                            <td class="deduction-strip-amount">₱0.00</td>
                        </tr>
                    </table>
                }
                <table class="deduction-strip-table">
                    <tr class="net-profit-row">
                        <td>Net Profit</td>
                        <td>₱@Model.NetProfit.ToString("N2")</td>
                    </tr>
                </table>
                <table class="deduction-strip-table">
                    <tr class="note-deduction-row">
                        <td>Another deduction: 1% money withdrawal, this will be deducted according on how much the shared profit</td>
                        <td>₱@Model.NoteDeductionAmount.ToString("N2")</td>
                    </tr>
                </table>
            </div>
            @if (partnersEnabled)
            {
                <div class="final-share-summary mt-2">
                    <table class="final-share-summary-table">
                        <tbody>
                            <tr>
                                <td class="summary-total" rowspan="2">₱@Model.NetProfit.ToString("N2")</td>
                                <td class="summary-amount">₱@Model.Partner1ShareAmount.ToString("N2")</td>
                                <td>@Model.Partner1SharePercent.ToString("0.00")%</td>
                                <td class="summary-amount">₱@Model.Partner1ShareAmount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="summary-amount">₱@Model.Partner2ShareAmount.ToString("N2")</td>
                                <td>@Model.Partner2SharePercent.ToString("0.00")%</td>
                                <td class="summary-amount">₱@Model.Partner2ShareAmount.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="final-shared-wrap mt-2">
                    <table class="final-shared-table">
                        <thead>
                            <tr><th colspan="2">FINAL SHARED NET PROFIT</th></tr>
                        </thead>
                        <tbody>
                            <tr class="final-row-p1">
                                <td>@Model.Partner1Name.ToUpper()</td>
                                <td>₱@Model.Partner1Final.ToString("N2")</td>
                            </tr>
                            <tr class="final-row-p2">
                                <td>@Model.Partner2Name.ToUpper()</td>
                                <td>₱@Model.Partner2Final.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="final-note-row">
                        <div class="final-note-text">
                            Please note that starting October, I will begin deducting small amounts OF WHAT you owed.
                        </div>
                        <div class="final-note-amount">₱@Model.NoteDeductionAmount.ToString("N2")</div>
                        <div class="final-note-balance">₱@Model.NoteRemainingBalance.ToString("N2")</div>
                    </div>
                </div>
            }
        </div>
        </div>
    </div>
</div>

<!-- MODALS -->
<!-- ADD DEDUCTION -->
<div class="modal fade report-modal report-modal-deduction" id="deductionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <form asp-action="AddDeduction" method="post" class="modal-content">
             @Html.AntiForgeryToken()
             <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-header"><h6 class="modal-title">Add Deduction</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" name="Description" class="form-control mb-2 fw-bold" required placeholder="Description (e.g. Salary)" />
                <select name="Category" class="form-select mb-2 fw-bold">
                    <option value="General" selected>General (Include in net profit)</option>
                    <option value="Note">Note (Separate deduction)</option>
                </select>
                <div class="input-group mb-2"><span class="input-group-text">₱</span><input type="number" step="0.01" name="Amount" class="form-control fw-bold" required placeholder="0.00" /></div>
                <input type="date" name="Date" class="form-control mb-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="modal-footer"><button type="submit" class="btn report-modal-submit">Save Deduction</button></div>
        </form>
    </div>
</div>

<!-- ADD CAPITAL -->
<div class="modal fade report-modal report-modal-capital" id="capitalModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <form asp-action="AddCapital" method="post" class="modal-content">
             @Html.AntiForgeryToken()
             <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-header"><h6 class="modal-title">Add Capital</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
             <div class="modal-body">
                <input type="text" name="FundName" class="form-control mb-2 fw-bold" required placeholder="Fund Name (e.g. Hazel Capital)" />
                <input type="text" name="Description" class="form-control mb-2" placeholder="Notes (Optional)" />
                <div class="input-group mb-2"><span class="input-group-text">₱</span><input type="number" step="0.01" name="Amount" class="form-control fw-bold" required placeholder="0.00" /></div>
                <input type="date" name="Date" class="form-control mb-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="modal-footer"><button type="submit" class="btn report-modal-submit">Save Capital</button></div>
        </form>
    </div>
</div>

@if (partnersEnabled)
{
    <!-- ADD PURCHASE -->
    <div class="modal fade report-modal report-modal-purchase" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <form asp-action="AddPurchase" method="post" class="modal-content">
                 @Html.AntiForgeryToken()
                 <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div class="modal-header"><h6 class="modal-title">Partner Purchase</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <select name="PartnerName" class="form-select mb-2 fw-bold">
                        <option value="@Model.Partner1Name">@Model.Partner1Name</option>
                        <option value="@Model.Partner2Name">@Model.Partner2Name</option>
                    </select>
                    <input type="text" name="Notes" class="form-control mb-2 fw-bold" required placeholder="Item / Reason" />
                    <div class="input-group mb-2"><span class="input-group-text">₱</span><input type="number" step="0.01" name="Amount" class="form-control fw-bold" required placeholder="0.00" /></div>
                    <input type="date" name="Date" class="form-control mb-2" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="modal-footer"><button type="submit" class="btn report-modal-submit">Save Purchase</button></div>
            </form>
        </div>
    </div>
}
