@page
@model HazelInvoice.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Options.IOptions<HazelInvoice.Configuration.FeaturesOptions> Features
@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    var allowPublicRegistration = Features.Value.AllowPublicRegistration;
}

@section Styles {
    <style>
        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: #202124;
            font-family: "DM Sans", "Segoe UI", Arial, sans-serif;
        }

        .auth-card {
            width: min(100%, 540px);
            background: #2b2c29;
            border: 1px solid #4a4c48;
            border-radius: 0 !important;
            overflow: hidden;
            box-shadow: none;
        }

        .auth-card-head {
            padding: 24px 40px 18px;
            background: transparent;
            border-bottom: 1px solid #474946;
        }

        .auth-card-head h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
            letter-spacing: -0.04em;
            color: #ffffff;
            line-height: 1.15;
        }

        .auth-card-head p {
            margin: 8px 0 0;
            font-size: 15px;
            color: #d3d6d0;
        }

        .auth-card-body {
            padding: 28px 40px 20px;
        }

        .auth-form {
            display: grid;
            gap: 18px;
        }

        .auth-validation {
            margin: 0;
            font-size: 13px;
        }

        .auth-field {
            display: grid;
            gap: 8px;
        }

        .auth-field-label {
            display: block;
            color: #d6d7d2;
            font-size: 14px;
            font-weight: 600;
        }

        .auth-input {
            width: 100%;
            min-height: 50px;
            border: 1px solid #555752;
            border-radius: 0 !important;
            background: transparent;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            line-height: 1.4;
            outline: none;
            box-shadow: none !important;
            padding: 12px 16px;
        }

        .auth-input::placeholder {
            color: #9ea29a;
        }

        .auth-input:focus {
            outline: none;
            border-color: #6b6e69;
        }

        .auth-check {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #d6d7d2;
            font-size: 14px;
            padding-left: 2px;
        }

        .auth-check .form-check-input {
            width: 18px;
            height: 18px;
            margin: 0;
            border: 1px solid #6a6d67;
            border-radius: 0 !important;
            background-color: transparent;
            box-shadow: none;
        }

        .auth-check .form-check-input:checked {
            background-color: #2b67ad;
            border-color: #2b67ad;
        }

        .auth-submit {
            width: 100%;
            min-height: 52px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #2b67ad;
            border-radius: 0 !important;
            background: #2b67ad;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: none;
        }

        .auth-submit:hover,
        .auth-submit:focus {
            background: #2b67ad;
            border-color: #2b67ad;
            color: #ffffff;
        }

        .auth-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .auth-link,
        .auth-link:hover,
        .auth-link:focus {
            color: #2d7ad7;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

        .auth-link-muted,
        .auth-link-muted:hover,
        .auth-link-muted:focus {
            color: #a8aca5;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

        .auth-password-wrap {
            position: relative;
        }

        .auth-input.has-toggle {
            padding-right: 46px;
        }

        .auth-toggle {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #8d908a;
            padding: 0;
            line-height: 1;
        }

        .auth-footer {
            margin-top: 2px;
            text-align: center;
            color: #d6d7d2;
            font-size: 14px;
            font-weight: 500;
        }

        .field-validation-error {
            display: block;
            margin-top: 8px;
            font-size: 12px;
        }

        @@media (max-width: 640px) {
            .auth-card-head {
                padding: 22px 22px 16px;
            }

            .auth-card-head h1 {
                font-size: 24px;
            }

            .auth-card-body {
                padding: 22px 22px 18px;
            }

            .auth-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .auth-input {
                font-size: 16px;
            }
        }
    </style>
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-head">
            <h1>Welcome back</h1>
            <p>Sign in to continue to your account</p>
        </div>
        <div class="auth-card-body">
            <form id="account" method="post" class="auth-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-field-label">Email address</label>
                    <input asp-for="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com"
                           spellcheck="false" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <div class="auth-row">
                        <label asp-for="Input.Password" class="auth-field-label mb-0">Password</label>
                        <span class="auth-link-muted">No reset page</span>
                    </div>
                    <div class="auth-password-wrap">
                        <input asp-for="Input.Password"
                               class="auth-input has-toggle"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Password" />
                        <button type="button" class="auth-toggle" id="togglePassword" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check auth-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me for 30 days</label>
                </div>

                <button id="login-submit" type="submit" class="auth-submit">Sign in</button>

                @if (allowPublicRegistration)
                {
                    <div class="auth-footer">
                        Don't have an account?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Create one</a>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const passwordInput = document.getElementById('Input_Password');
            const toggle = document.getElementById('togglePassword');
            if (!passwordInput || !toggle) return;

            toggle.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggle.innerHTML = isPassword
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
                toggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });
        })();
    </script>
}
